# Strona ctrlzstudio.pl w kontenerze (port 8080, bez TLS — certyfikat ma Caddy przed nią).
# Odpowiednik dawnego vercel.json: przekierowania 301, cleanUrls, trailingSlash: false, nagłówki, 404.
{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Strona testowa przed przepięciem domeny — Google nie może jej zaindeksować
	@test host nowa.ctrlzstudio.pl
	header @test X-Robots-Tag "noindex, nofollow"
	handle @test {
		respond /robots.txt "User-agent: *
Disallow: /
" 200
	}

	# Przekierowania z vercel.json
	redir /portfolio /realizacje 301
	redir /portfolio/* /realizacje 301
	redir /realizacje/kancelaria-prawna /realizacje 301
	redir /realizacje/fine-dining /realizacje 301
	redir /realizacje/konfigurator /realizacje 301
	redir /realizacje/sklep-modowy /realizacje 301
	redir /realizacje/sklep-sportowy /realizacje 301
	redir /realizacje/startup-saas /realizacje 301

	# trailingSlash: false — /adres/ → /adres (poza stroną główną)
	@slash path_regexp slash ^(.+)/$
	redir @slash {re.slash.1}{?query} 301
	# cleanUrls — /adres.html i /adres/index.html → /adres
	redir /index.html / 301
	@html path_regexp html ^(.+?)(/index)?\.html$
	redir @html {re.html.1}{?query} 301

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Strict-Transport-Security "max-age=63072000"
		-Server
	}
	@immutable path /_astro/* /fonts/* *.woff2
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@favicon path /favicon.svg
	header @favicon Cache-Control "public, max-age=86400"
	# Obrazy z panelu: nazwa = id obrazu, podmiana w panelu daje nowy id
	@media path /panel-media/*
	header @media Cache-Control "public, max-age=604800"
	@rest not path /_astro/* /fonts/* *.woff2 /favicon.svg /panel-media/*
	header @rest Cache-Control "public, max-age=0, must-revalidate"

	try_files {path} {path}.html {path}/index.html
	file_server

	handle_errors 404 {
		rewrite * /404.html
		file_server {
			status 404
		}
	}
}
