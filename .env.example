# Treści strony z panelu CtrlZ Hub (npm run tresci, wołane też przez npm run build).
# Bez sekretu build używa ostatniego src/data/panel-export.json, a gdy go nie ma — samych plików z repo.
PANEL_EXPORT_URL="http://localhost:3100/api/strona/eksport"
# Ten sam sekret co SITE_EXPORT_SECRET w panelu — wpisuje właściciel.
PANEL_EXPORT_SECRET=""

# Adres, na który strona wysyła formularze (panel: POST /api/formularz).
PUBLIC_FORM_ENDPOINT="http://localhost:3100/api/formularz"
