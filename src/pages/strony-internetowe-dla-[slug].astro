---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { INDUSTRIES } from '../data/industries';
import { priceAnswer, addonsAnswer } from '../data/pricing';

export function getStaticPaths() {
  return INDUSTRIES.map((ind) => ({ params: { slug: ind.slug }, props: { ind } }));
}

const { ind } = Astro.props;
const url = `https://ctrlzstudio.pl/strony-internetowe-dla-${ind.slug}`;

// FAQ branżowe + dwa wspólne pytania cenowe z jednego źródła prawdy.
const faq = [
  ...ind.faq,
  { q: 'Ile kosztuje taka strona?', a: priceAnswer() },
  { q: 'Co jeszcze można dobrać do projektu?', a: addonsAnswer() },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  name: `Strony internetowe dla ${ind.forWhom}`,
  description: ind.description,
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'województwo małopolskie' },
  url,
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Branże', item: 'https://ctrlzstudio.pl/branze' },
    { '@type': 'ListItem', position: 3, name: ind.label, item: url },
  ],
};

// Pozostałe branże do sekcji „zobacz też" — bez bieżącej.
const others = INDUSTRIES.filter((i) => i.slug !== ind.slug);
---

<Layout title={ind.metaTitle} description={ind.description}>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(124,107,255,.1); border: 1px solid rgba(124,107,255,.26); color: #c4b5fd;
  }
  .srv-crumbs { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 18px; }
  .srv-crumbs a { color: rgba(255,255,255,.68); text-decoration: none; }
  .srv-crumbs a:hover { color: #c4b5fd; }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.8); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .srv-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 780px; margin-top: 32px; }
  .srv-step {
    display: flex; gap: 22px; align-items: flex-start;
    padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07);
  }
  .srv-step-n {
    font-family: var(--font-display); font-size: 26px; font-weight: 800;
    color: #c4b5fd; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85;
  }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-list { max-width: 780px; margin: 24px 0 0; padding: 0; list-style: none; }
  .srv-list li {
    font-size: 15px; color: rgba(255,255,255,.66); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 14px; position: relative;
  }
  .srv-list li::before { content: '→'; position: absolute; left: 0; color: #c4b5fd; font-size: 14px; }
  .srv-list strong { color: rgba(255,255,255,.8); font-weight: 500; }
  .ind-others { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .ind-others a {
    font-size: 13px; padding: 9px 18px; border-radius: 100px; text-decoration: none;
    color: rgba(255,255,255,.72); background: rgba(255,255,255,.03);
    border: 1px solid rgba(255,255,255,.09); transition: border-color .25s, color .25s;
  }
  .ind-others a:hover { border-color: rgba(124,107,255,.4); color: #c4b5fd; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid { grid-template-columns: 1fr; }
    .srv-hero { padding: 120px 0 48px; }
  }

  .ind-proof { margin-top: 44px; }
  /* auto-fit + justify-content: pojedyncza realizacja ląduje na środku,
     dwie stają obok siebie — bez osobnego wariantu w kodzie */
  .ind-proof-grid {
    display: grid; gap: 18px; max-width: 900px; margin: 0 auto;
    grid-template-columns: repeat(auto-fit, minmax(280px, 420px));
    justify-content: center;
  }
  .ind-proof-card {
    display: block; text-align: left; text-decoration: none;
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 24px; transition: border-color .25s, transform .25s;
  }
  .ind-proof-card:hover { border-color: rgba(124,107,255,.32); transform: translateY(-2px); }
  .ind-proof-card h3 { font-family: var(--font-display); font-size: 15.5px; color: #fff; margin: 0 0 9px; font-weight: 600; }
  .ind-proof-card p { font-size: 13.5px; color: rgba(255,255,255,.68); line-height: 1.65; margin: 0 0 12px; }
  .ind-proof-card span { font-size: 12.5px; color: #c4b5fd; }
  @media (max-width: 720px) { .ind-proof-grid { grid-template-columns: 1fr; } }
</style>

<section class="srv-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="srv-crumbs"><a href="/">Strona główna</a> · <a href="/branze">Branże</a> · {ind.label}</div>
    <div class="eyebrow" style="margin-bottom:18px">Branża — {ind.label}</div>
    <h1 class="display-xl" style="margin-bottom:20px">{ind.h1[0]}<br><span class="grad">{ind.h1[1]}</span></h1>
    <p class="srv-lead">{ind.lead}</p>
    <div class="srv-chips">{ind.chips.map((c) => <span class="srv-chip">{c}</span>)}</div>
  </div>
</section>

<!-- CO ZWYKLE NIE DZIAŁA -->
<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co najczęściej <span class="grad-v">nie działa</span><br>na stronach w tej branży</h2>
    <p class="srv-p">Trzy rzeczy, które widzimy niemal w każdym audycie — i które kosztują najwięcej zapytań.</p>
    <div class="srv-steps">
      {ind.problems.map((p, i) => (
        <div class="srv-step">
          <div class="srv-step-n">{String(i + 1).padStart(2, '0')}</div>
          <div><h3>{p.t}</h3><p>{p.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- DLACZEGO TA BRANŻA JEST INNA -->
<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jak podchodzimy<br>do <span class="grad">tego projektu</span></h2>
    {ind.why.map((p) => <p class="srv-p">{p}</p>)}
  </div>
</section>

<!-- CO MUSI BYĆ NA STRONIE -->
<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co musi się znaleźć<br>na stronie <span class="grad-v">{ind.forWhom}</span></h2>
    <div class="srv-grid">
      {ind.musts.map((m) => (
        <div class="srv-card"><h3>{m.t}</h3><p>{m.d}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- JAK SZUKAJĄ KLIENCI -->
<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jak szukają <span class="grad">Wasi klienci</span></h2>
    <p class="srv-p">Strukturę strony układamy pod realne zapytania, nie pod to, jak firma nazywa swoje usługi wewnętrznie.</p>
    <ul class="srv-list">
      {ind.searchIntent.map((s) => <li>{s}</li>)}
    </ul>
    <p class="srv-p" style="margin-top:26px">
      Szerzej opisaliśmy to na stronie <a href="/pozycjonowanie-seo" style="color:#c4b5fd">pozycjonowanie SEO</a>,
      a sam przebieg współpracy — na stronie <a href="/jak-pracujemy" style="color:#c4b5fd">jak pracujemy</a>.
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="srv-section srv-section-alt">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Porozmawiajmy o stronie<br><span class="grad">dla Waszej firmy</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">
      Pierwsza rozmowa jest bezpłatna i niezobowiązująca. Powiemy wprost, co w Waszym przypadku ma sens,
      a czego nie warto kupować.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>

    {ind.projects && ind.projects.length > 0 && (
      <div class="ind-proof">
        <p class="srv-p" style="margin:0 auto 20px;font-size:14px">Nasze realizacje z tej branży:</p>
        <div class="ind-proof-grid">
          {ind.projects.map((pr) => (
            <a class="ind-proof-card" href={`/realizacje/${pr.slug}`}>
              <h3>{pr.name}</h3>
              <p>{pr.note}</p>
              <span>Zobacz realizację →</span>
            </a>
          ))}
        </div>
      </div>
    )}

    <p class="srv-p" style="margin:40px auto 0;font-size:14px">Robimy też strony dla:</p>
    <div class="ind-others" style="justify-content:center">
      {others.map((o) => <a href={`/strony-internetowe-dla-${o.slug}`}>{o.label}</a>)}
    </div>

    {ind.posts && ind.posts.length > 0 && (
      <p class="srv-p" style="margin:32px auto 0;font-size:14px">
        Warto przeczytać: {ind.posts.map((p, i) => (
          <>{i > 0 && ' · '}<a href={`/blog/${p.slug}`} style="color:#c4b5fd">{p.title}</a></>
        ))}
      </p>
    )}
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
