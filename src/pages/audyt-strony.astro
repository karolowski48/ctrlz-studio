---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  { q: 'Ile kosztuje audyt?', a: 'Podstawowy przegląd — widoczność w Google, szybkość, kondycja techniczna i wizytówka — robimy bezpłatnie przy pierwszej rozmowie. Pełny audyt z rozpisanymi rekomendacjami, analizą konkurencji i planem wdrożenia to 300 – 1 000 zł, zależnie od wielkości serwisu.' },
  { q: 'Co dostanę w raporcie?', a: 'Listę konkretnych rzeczy do poprawy, uszeregowaną według stosunku wysiłku do efektu — od tych, które zrobicie sami w popołudnie, po te wymagające pracy programisty. Przy każdej piszemy, co jest problemem, dlaczego ma znaczenie i jak to naprawić. Bez ogólników typu „popraw SEO".' },
  { q: 'Czy audyt kończy się propozycją nowej strony?', a: 'Nie z automatu. W dużej części przypadków wychodzi, że nowa strona nie jest potrzebna — wystarczy poprawić tytuły, skompresować zdjęcia i uzupełnić wizytówkę. Mówimy to wprost, mimo że oznacza dla nas mniejsze zlecenie. Sprzedawanie strony za osiem tysięcy komuś, kto ma zły tytuł strony głównej, jest po prostu nieuczciwe.' },
  { q: 'Ile trwa audyt?', a: 'Bezpłatny przegląd — kilka dni od przesłania adresu. Pełny audyt: 1–2 tygodnie, zależnie od wielkości serwisu i tego, jak szybko dostaniemy dostępy do Search Console i Analytics.' },
  { q: 'Czego potrzebujecie ode mnie?', a: 'Adresu strony i, jeśli macie, dostępu do Search Console oraz Analytics w trybie tylko do odczytu. Bez tych danych część analizy opiera się na szacunkach zamiast na tym, co realnie dzieje się na stronie.' },
  { q: 'Czy możecie wdrożyć zalecenia?', a: 'Możemy, ale nie musicie z nami. Raport jest napisany tak, żeby poradził sobie z nim także Wasz obecny wykonawca. Jeśli wolicie, żebyśmy zrobili to my — wyceniamy wdrożenie osobno, po Waszej decyzji.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Audyt strony internetowej',
  name: 'Audyt strony internetowej i widoczności w Google',
  description: 'Audyt techniczny strony, widocznosci w wyszukiwarce, szybkosci i wizytowki Google z lista konkretnych rekomendacji.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'województwo małopolskie' },
  url: 'https://ctrlzstudio.pl/audyt-strony',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Audyt strony', item: 'https://ctrlzstudio.pl/audyt-strony' },
  ],
};
---

<Layout
  title="Audyt strony internetowej — techniczny i SEO | CtrlZ Studio"
  description="Sprawdzimy widoczność w Google, szybkość, kondycję techniczną i wizytówkę. Dostaniesz listę konkretnych rzeczy do poprawy — także tych do zrobienia."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.26); color: #86efac;
  }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.8); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .srv-card:hover { border-color: rgba(34,197,94,.26); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 780px; margin-top: 32px; }
  .srv-step {
    display: flex; gap: 22px; align-items: flex-start;
    padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07);
  }
  .srv-step-n {
    font-family: var(--font-display); font-size: 26px; font-weight: 800;
    color: #86efac; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85;
  }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .srv-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .srv-list li::before { content: '→'; position: absolute; left: 0; color: #86efac; font-size: 14px; }
  .srv-list strong { color: rgba(255,255,255,.8); font-weight: 500; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid { grid-template-columns: 1fr; }
    .srv-hero { padding: 120px 0 48px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Usługa</div>
    <h1 class="display-xl" style="margin-bottom:20px">Audyt<br><span class="grad-v">strony</span></h1>
    <p class="srv-lead">Masz stronę, ale telefon milczy? <strong>Zanim zapłacisz za nową, sprawdźmy, czy obecnej nie da się naprawić.</strong> W większości przypadków przyczyna leży w kilku rzeczach, które da się poprawić w jedno popołudnie.</p>
    <div class="srv-chips"><span class="srv-chip">Widoczność w Google</span>
      <span class="srv-chip">Szybkość</span>
      <span class="srv-chip">Kondycja techniczna</span>
      <span class="srv-chip">Wizytówka Google</span></div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">„Zapłaciliśmy za stronę,<br>minął rok i <span class="grad">nic</span>"</h2>
    <p class="srv-p">
      Słyszymy to zdanie częściej niż jakiekolwiek inne. Zwykle towarzyszy mu przekonanie,
      że trzeba zrobić nową stronę. <strong>W większości przypadków nie trzeba.</strong>
    </p>
    <p class="srv-p">
      Wzór powtarza się do znudzenia: tytuł strony głównej nie zawiera ani usługi,
      ani miejscowości, więc Google nie wie, komu ją pokazać. Zdjęcia wgrane prosto
      z aparatu ważą po kilka megabajtów, więc strona ładuje się sześć sekund.
      Wizytówka Google jest pusta albo w ogóle jej nie ma. Formularz kontaktowy
      nie działa od pół roku i nikt tego nie sprawdził.
    </p>
    <p class="srv-p">
      Żadna z tych rzeczy nie wymaga nowej strony. Wszystkie wymagają tego, żeby ktoś
      w ogóle je zauważył.
    </p>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co <span class="grad-v">sprawdzamy</span></h2>
    <div class="srv-grid">
      <div class="srv-card"><h3>Widoczność w Google</h3><p>Na jakie frazy się wyświetlacie, na których pozycjach, ile z tego macie kliknięć. Gdzie jesteście wysoko, ale nikt nie klika — i dlaczego.</p></div>
      <div class="srv-card"><h3>Kondycja techniczna</h3><p>Indeksowanie, adresy kanoniczne, mapa witryny, przekierowania, duplikaty treści, błędy 404, dane strukturalne.</p></div>
      <div class="srv-card"><h3>Szybkość</h3><p>Core Web Vitals na telefonie i desktopie. Co konkretnie spowalnia stronę i ile da się zyskać na każdej poprawce.</p></div>
      <div class="srv-card"><h3>Wizytówka Google</h3><p>Kompletność profilu, kategorie, obszar działania, zdjęcia, opinie. Dla lokalnej firmy często najsłabsze ogniwo.</p></div>
      <div class="srv-card"><h3>Konwersja</h3><p>Czy ze strony da się w ogóle skontaktować. Widoczność telefonu, długość formularza, jasność przekazu w pierwszym ekranie.</p></div>
      <div class="srv-card"><h3>Konkurencja</h3><p>Co robią firmy, które są nad Wami w wynikach. Czym konkretnie wygrywają i co da się z tego przenieść do Was.</p></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jak to <span class="grad">wygląda</span></h2>
    <div class="srv-steps">
      <div class="srv-step"><div class="srv-step-n">01</div><div><h3>Przesyłacie adres strony</h3><p>Do bezpłatnego przeglądu wystarczy sam adres. Do pełnego audytu przydadzą się dostępy do Search Console i Analytics w trybie tylko do odczytu.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">02</div><div><h3>Analizujemy</h3><p>Bezpłatny przegląd: kilka dni. Pełny audyt: 1–2 tygodnie, zależnie od wielkości serwisu.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">03</div><div><h3>Dostajecie raport</h3><p>Lista konkretnych rzeczy do poprawy, uszeregowana według stosunku wysiłku do efektu. Przy każdej: co jest problemem, dlaczego ma znaczenie, jak to naprawić.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">04</div><div><h3>Decydujecie sami</h3><p>Możecie wdrożyć zalecenia samodzielnie, zlecić to obecnemu wykonawcy albo nam. Raport jest napisany tak, żeby poradził sobie z nim każdy.</p></div></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Zamówcie <span class="grad-v">przegląd</span><br>za darmo</h2>
    <p class="srv-p" style="margin:0 auto 32px">Prześlijcie adres strony — odeślemy listę tego, co widzimy na pierwszy rzut oka. Bez zobowiązań i bez namawiania na przebudowę.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/bezplatny-audyt" class="btn-ghost"><span>Zacznij od bezpłatnego audytu</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">Zobacz też: <a href="/audyt-seo" style="color:#c4b5fd">audyt SEO</a> · <a href="/bezplatny-audyt" style="color:#c4b5fd">bezpłatny audyt</a> · <a href="/pozycjonowanie-seo" style="color:#c4b5fd">pozycjonowanie SEO</a> · <a href="/strony-internetowe" style="color:#c4b5fd">strony internetowe</a> · <a href="/blog/strona-nie-przynosi-klientow-7-powodow" style="color:#c4b5fd">7 powodów, dla których strona nie przynosi klientów</a></p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
