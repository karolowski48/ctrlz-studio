---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { PRICING, priceAnswer } from '../data/pricing';

/**
 * KRAKÓW — podstrona lokalna o innej logice niż pozostałe.
 * ═══════════════════════════════════════════════════════
 * Fraza główna „tworzenie stron internetowych kraków" = 170/mies., CPC 27,35 zł.
 * To najbardziej konkurencyjny rynek w naszym zasięgu i NIE zakładamy,
 * że wejdziemy tam do pierwszej dziesiątki w pierwszym roku.
 *
 * Dlatego strona jest zbudowana pod dwie rzeczy, w których realnie wygrywamy:
 *  1) obwarzanek krakowski — Wieliczka (40/mies.), Skawina, Niepołomice, Zielonki,
 *     Krzeszowice, Zabierzów: konkurencja nieporównywalnie mniejsza,
 *  2) nisze usługowe — audyt, usuwanie wirusów, dostępność WCAG, PrestaShop,
 *     gdzie liczy się kompetencja, a nie wiek domeny.
 *
 * Dowód lokalny: Dziki Gym (Kraków, Ruczaj) i PSGiU (Zielonki).
 */

const zl = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} zł`;

const nisze = [
  { t: 'Audyt strony i SEO', d: 'Sprawdzamy strony, których nie budowaliśmy — technicznie, pod widoczność, pod zgody i pod dostępność. Raport z rekomendacjami wraca w 48 godzin i możecie go wdrożyć u dowolnego wykonawcy.', href: '/audyt-strony', link: 'audyt strony' },
  { t: 'Usuwanie wirusów z WordPressa', d: 'Zainfekowana strona, przekierowania na obce witryny, tysiące śmieciowych adresów w Google. Przeszliśmy przez to na własnej domenie, więc wiemy też, co dzieje się potem — i ile realnie trwa sprzątanie.', href: '/usuwanie-wirusow-wordpress', link: 'usuwanie wirusów' },
  { t: 'Dostępność i WCAG', d: 'Audyt zgodności na poziomie AA, z ręczną weryfikacją i priorytetami. Temat, który wraca w dokumentacji zamówień publicznych i w regulacjach dla sprzedaży online.', href: '/audyt-dostepnosci-wcag', link: 'audyt WCAG' },
  { t: 'Sklepy na PrestaShop', d: 'Duże katalogi, warianty, sprzedaż zagraniczna, cenniki B2B. Wdrożenia i migracje z innych platform razem z mapą przekierowań, która ratuje pozycje.', href: '/sklepy-internetowe-prestashop', link: 'sklepy PrestaShop' },
  { t: 'Strony bez WordPressa', d: 'Astro i Next.js — wynik PageSpeed powyżej 95, brak wtyczek do aktualizowania i niższe koszty utrzymania. Dla firm, dla których szybkość jest przewagą, a nie kosmetyką.', href: '/strony-internetowe-astro-nextjs', link: 'Astro i Next.js' },
  { t: 'Opieka nad istniejącą stroną', d: 'Aktualizacje sprawdzane na kopii, kopie zapasowe poza serwerem, monitoring i godzina na drobne zmiany. Bez przebudowywania czegoś, co działa.', href: '/wsparcie-techniczne', link: 'wsparcie techniczne' },
];

const okolice = [
  'Wieliczka', 'Skawina', 'Niepołomice', 'Zielonki',
  'Krzeszowice', 'Zabierzów', 'Świątniki Górne', 'Mogilany',
  'Liszki', 'Michałowice', 'Wielka Wieś', 'Igołomia',
];

const faq = [
  { q: 'Ile kosztuje strona internetowa w Krakowie?', a: priceAnswer() },
  { q: 'Dlaczego mielibyśmy wybrać studio spoza Krakowa?', a: 'Z dwóch powodów. Pierwszy: nie płacicie za krakowski narzut biurowy — przy tym samym zakresie wycena bywa niższa. Drugi: przy nas rozmawiacie z osobą, która realnie robi projekt, a nie z handlowcem, który po podpisaniu umowy znika. Jeśli natomiast zależy Wam na cotygodniowych spotkaniach w biurze w centrum, uczciwie odradzamy — nie jesteśmy dobrym wyborem.' },
  { q: 'Czy spotkacie się z nami w Krakowie?', a: 'Tak, jesteśmy z Izdebnika, czyli około czterdziestu minut od centrum. Na start projektu i przy odbiorze spotykamy się chętnie. Resztę współpracy prowadzimy zdalnie, bo tak jest po prostu szybciej dla obu stron.' },
  { q: 'Robicie strony dla firm z całego Krakowa?', a: 'Tak, ale najczęściej pracujemy z firmami z obwarzanka — Wieliczka, Skawina, Niepołomice, Zielonki, Krzeszowice. To rejon, w którym jesteśmy realnie blisko, a konkurencja w wynikach lokalnych jest znacznie mniejsza niż w samym mieście, co przy pozycjonowaniu ma duże znaczenie.' },
  { q: 'Czy pozycjonujecie na frazy krakowskie?', a: 'Podejmujemy się tego, ale mówimy wprost, jak wygląda sytuacja: przy najbardziej konkurencyjnych frazach w Krakowie walczycie z agencjami budującymi pozycje od lat. Sensowna strategia to zacząć od fraz usługowo-dzielnicowych i długiego ogona, a nie od hasła, na które celuje cała branża. Rozpisaliśmy to na stronie o pozycjonowaniu.' },
  { q: 'Ile trwa realizacja?', a: 'Wizytówka 2–4 tygodnie, strona firmowa 4–8 tygodni, sklep 6–12. W dziewięciu przypadkach na dziesięć o terminie decyduje tempo zbierania treści i zdjęć po Waszej stronie, nie nasza praca.' },
  { q: 'Czy przejmiecie stronę po innej agencji?', a: 'Tak i robimy to często. Zaczynamy od audytu — sprawdzamy, w jakim stanie jest to, co macie, czy da się na tym budować i czy macie komplet dostępów. Zdarza się, że najuczciwszą odpowiedzią jest „nie przebudowujcie, wystarczy poprawić trzy rzeczy".' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  name: 'Tworzenie stron internetowych — Kraków i okolice',
  description: 'Strony internetowe, sklepy, audyty i opieka techniczna dla firm z Krakowa i gmin ościennych — Wieliczki, Skawiny, Niepołomic, Zielonek.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: [
    { '@type': 'City', name: 'Kraków' },
    { '@type': 'City', name: 'Wieliczka' },
    { '@type': 'City', name: 'Skawina' },
    { '@type': 'City', name: 'Niepołomice' },
    { '@type': 'AdministrativeArea', name: 'powiat krakowski' },
  ],
  url: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-krakow',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Kraków', item: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-krakow' },
  ],
};
---

<Layout
  title="Tworzenie stron internetowych Kraków i okolice | CtrlZ Studio"
  description="Strony, sklepy i audyty dla firm z Krakowa oraz gmin ościennych — Wieliczki, Skawiny, Niepołomic, Zielonek. Bez krakowskiego narzutu, z realizacjami z miasta."
>
<SharedNav />

<main id="main-content">

<style>
  .krk-hero { padding: 150px 0 56px; position: relative; overflow: hidden; background: var(--bg-base); }
  .krk-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .krk-crumbs { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 18px; }
  .krk-crumbs a { color: rgba(255,255,255,.68); text-decoration: none; }
  .krk-lead { font-size: 17px; color: rgba(255,255,255,.64); line-height: 1.75; max-width: 750px; font-weight: 300; }
  .krk-lead strong { color: rgba(255,255,255,.85); font-weight: 500; }
  .krk-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .krk-chip { font-size: 12px; padding: 7px 16px; border-radius: 100px; background: rgba(124,107,255,.1); border: 1px solid rgba(124,107,255,.26); color: #c4b5fd; }
  .krk-section { padding: 68px 0; background: var(--bg-base); }
  .krk-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .krk-h2 { margin-bottom: 18px; }
  .krk-p { font-size: 15px; color: rgba(255,255,255,.64); line-height: 1.8; max-width: 780px; margin-bottom: 16px; }
  .krk-p strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .krk-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .krk-card {
    display: flex; flex-direction: column; text-decoration: none;
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 26px; transition: border-color .25s, transform .25s;
  }
  .krk-card:hover { border-color: rgba(124,107,255,.3); transform: translateY(-2px); }
  .krk-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .krk-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0 0 16px; }
  .krk-card span { margin-top: auto; font-size: 13px; color: #c4b5fd; font-weight: 500; }
  .krk-towns { display: flex; flex-wrap: wrap; gap: 9px; margin-top: 28px; max-width: 820px; }
  .krk-town { font-size: 13px; padding: 8px 16px; border-radius: 100px; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.1); color: rgba(255,255,255,.74); }
  .krk-real { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; margin-top: 32px; max-width: 900px; }
  .krk-real-card {
    display: block; text-decoration: none; padding: 26px;
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.08);
    border-radius: 18px; transition: border-color .25s, transform .25s;
  }
  .krk-real-card:hover { border-color: rgba(124,107,255,.4); transform: translateY(-3px); }
  .krk-real-city { display: inline-block; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: #c4b5fd; background: rgba(124,107,255,.12); border: 1px solid rgba(124,107,255,.3); padding: 4px 11px; border-radius: 100px; margin-bottom: 12px; }
  .krk-real-card h3 { font-family: var(--font-display); font-size: 17px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .krk-real-card p { font-size: 14px; color: rgba(255,255,255,.66); line-height: 1.7; margin: 0 0 14px; }
  .krk-real-go { font-size: 13px; color: #c4b5fd; font-weight: 500; }
  .krk-honest { max-width: 860px; border: 1px solid rgba(251,191,36,.28); border-radius: 20px; padding: 32px; background: rgba(251,191,36,.05); margin-top: 30px; }
  .krk-honest h3 { font-family: var(--font-display); font-size: 19px; color: #fbbf24; margin: 0 0 14px; font-weight: 600; }
  .krk-honest p { font-size: 15px; color: rgba(255,255,255,.74); line-height: 1.8; margin: 0 0 12px; }
  @media (max-width: 1024px) { .krk-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .krk-real { grid-template-columns: 1fr; } }
  @media (max-width: 720px) {
    .krk-inner { padding: 0 24px; }
    .krk-grid { grid-template-columns: 1fr; }
    .krk-hero { padding: 120px 0 40px; }
    .krk-honest { padding: 24px 20px; }
  }
</style>

<section class="krk-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="krk-inner" style="position:relative">
    <div class="krk-crumbs"><a href="/">Strona główna</a> · Kraków i okolice</div>
    <div class="eyebrow" style="margin-bottom:18px">Kraków i gminy ościenne</div>
    <h1 class="display-xl" style="margin-bottom:20px">Tworzenie stron<br>internetowych <span class="grad">Kraków</span></h1>
    <p class="krk-lead">
      Strony, sklepy, audyty i opieka techniczna dla firm z Krakowa oraz z całego obwarzanka —
      Wieliczki, Skawiny, Niepołomic, Zielonek. <strong>Jesteśmy z Izdebnika, czterdzieści minut od centrum</strong>,
      więc na spotkanie dojedziemy, a rachunku nie obciąża krakowskie biuro.
    </p>
    <div class="krk-chips">
      <span class="krk-chip">Realizacje z Krakowa</span>
      <span class="krk-chip">Bez narzutu wielkomiejskiego</span>
      <span class="krk-chip">Od {zl(PRICING.landing)}</span>
    </div>
  </div>
</section>

<!-- UCZCIWIE -->
<section class="krk-section">
  <div class="krk-inner">
    <h2 class="display-md krk-h2">Powiedzmy to <span class="grad-v">wprost</span></h2>
    <div class="krk-honest">
      <h3>Nie jesteśmy największą agencją w Krakowie i nie udajemy, że jesteśmy</h3>
      <p>
        W Krakowie działają studia z kilkunastoletnią historią, całymi zespołami i budżetami
        na reklamę, jakich nie mamy. Jeśli szukacie firmy z biurem w centrum i opiekunem projektu
        na etacie — takich jest tu wiele i nie będziemy przekonywać, że jesteśmy lepszym wyborem.
      </p>
      <p>
        <strong>Trafiacie do nas z innego powodu.</strong> Bo potrzebujecie kogoś, kto sprawdzi stronę,
        której nie budował, wyciągnie sklep z zaniedbanego WordPressa albo zrobi rzecz techniczną,
        którą duża agencja wyceni jak projekt. Przy takich zleceniach liczy się kompetencja
        i czas reakcji, a nie adres siedziby.
      </p>
      <p>
        Uczciwie mówimy też o pozycjonowaniu: przy najbardziej konkurencyjnych frazach krakowskich
        walczycie z firmami, które budują pozycje od lat. Da się tam wejść, ale to praca na kwartały
        i lepiej zacząć od fraz dzielnicowych i usługowych.
      </p>
    </div>
  </div>
</section>

<!-- W CZYM JESTEŚMY DOBRZY -->
<section class="krk-section krk-section-alt">
  <div class="krk-inner">
    <h2 class="display-md krk-h2">Po co przyjeżdżają<br>do nas <span class="grad">firmy z Krakowa</span></h2>
    <p class="krk-p">
      Sześć rzeczy, przy których wygrywamy nie ceną i nie wielkością, tylko tym, że robimy je na co dzień.
    </p>
    <div class="krk-grid">
      {nisze.map((n) => (
        <a href={n.href} class="krk-card">
          <h3>{n.t}</h3>
          <p>{n.d}</p>
          <span>Zobacz {n.link} →</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- REALIZACJE -->
<section class="krk-section">
  <div class="krk-inner">
    <h2 class="display-md krk-h2">Realizacje <span class="grad-v">z Krakowa i okolic</span></h2>
    <p class="krk-p">
      Możecie wejść na te strony i sprawdzić, jak działają — łącznie z wynikiem w PageSpeed.
    </p>
    <div class="krk-real">
      <a href="/realizacje/dziki-gym" class="krk-real-card">
        <div class="krk-real-city">Kraków · Ruczaj</div>
        <h3>Dziki Gym</h3>
        <p>Redesign strony siłowni z kickboxingiem i Krav Magą. Optymalizacja pod frazy dzielnicowe, dane strukturalne firmy lokalnej i wizytówka Google spięta ze stroną.</p>
        <span class="krk-real-go">Zobacz realizację →</span>
      </a>
      <a href="/realizacje/psgiu" class="krk-real-card">
        <div class="krk-real-city">Zielonki · powiat krakowski</div>
        <h3>PSGiU</h3>
        <p>Serwis stowarzyszenia medycznego — uporządkowana struktura informacji, dostępność treści i baza pod publikowanie materiałów dla członków.</p>
        <span class="krk-real-go">Zobacz realizację →</span>
      </a>
    </div>
    <p class="krk-p" style="margin-top:26px">
      Pełne portfolio na stronie <a href="/realizacje" style="color:#c4b5fd">realizacje</a>.
    </p>
  </div>
</section>

<!-- OBWARZANEK -->
<section class="krk-section krk-section-alt">
  <div class="krk-inner">
    <h2 class="display-md krk-h2">Najczęściej pracujemy<br>w <span class="grad">obwarzanku krakowskim</span></h2>
    <p class="krk-p">
      Gminy wokół Krakowa to rejon, w którym jesteśmy realnie blisko, a jednocześnie
      <strong>konkurencja w wynikach lokalnych jest nieporównywalnie mniejsza niż w samym mieście</strong>.
      Dla firmy z Wieliczki czy Niepołomic oznacza to, że wejście do pierwszej trójki
      na własne frazy jest osiągalne w kilka miesięcy, a nie w kilka lat.
    </p>
    <div class="krk-towns">
      {okolice.map((o) => <span class="krk-town">{o}</span>)}
    </div>
    <p class="krk-p" style="margin-top:28px">
      Mamy też osobne podstrony dla <a href="/tworzenie-stron-internetowych-wieliczka" style="color:#c4b5fd">Wieliczki</a>,
      <a href="/tworzenie-stron-internetowych-skawina" style="color:#c4b5fd">Skawiny</a>
      i <a href="/tworzenie-stron-internetowych-myslenice" style="color:#c4b5fd">Myślenic</a>,
      a jeśli działacie po stronie zachodniej — dla
      <a href="/tworzenie-stron-internetowych-wadowice" style="color:#c4b5fd">Wadowic</a> i całego powiatu.
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="krk-section">
  <div class="krk-inner">
    <h2 class="display-md krk-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="krk-section krk-section-alt">
  <div class="krk-inner" style="text-align:center">
    <h2 class="display-md krk-h2">Napiszcie, co macie<br>i czego <span class="grad">Wam brakuje</span></h2>
    <p class="krk-p" style="margin:0 auto 32px">
      Pierwsza rozmowa jest bezpłatna. Jeśli uznamy, że lepszym wyborem będzie ktoś inny —
      powiemy to wprost, zamiast wyceniać projekt na siłę.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/bezplatny-audyt" class="btn-ghost"><span>Zamów bezpłatny audyt</span></a>
    </div>
    <p class="krk-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/ile-kosztuje-strona-internetowa" style="color:#c4b5fd">ile kosztuje strona</a> ·
      <a href="/jak-pracujemy" style="color:#c4b5fd">jak pracujemy</a> ·
      <a href="/branze" style="color:#c4b5fd">strony wg branż</a> ·
      <a href="/uslugi" style="color:#c4b5fd">wszystkie usługi</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();
  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
