---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { PRICING } from '../data/pricing';
import { hostingOdnowienie } from '../data/hosting';

/**
 * PRESTASHOP — wdrożenia sklepów.
 * ══════════════════════════════
 * Uwaga na kanibalizację: /sklepy-internetowe zostaje stroną ogólną
 * (wybór platformy, cała usługa), ta celuje wyłącznie w osoby,
 * które już wiedzą, że chcą PrestaShop, albo je rozważają.
 * Wpis /blog/prestashop-dla-kogo-ma-sens to warstwa poradnikowa.
 */

const zl = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} zł`;

const kiedy = [
  { t: 'Duży katalog produktów', d: 'Od kilkuset pozycji w górę, zwłaszcza z wariantami — rozmiary, kolory, wersje. PrestaShop znosi to stabilniej niż WooCommerce, bo obsługa katalogu jest w rdzeniu, a nie w warstwie doklejonej do systemu blogowego.' },
  { t: 'Sprzedaż zagraniczna', d: 'Wiele języków i walut działa od razu po instalacji, bez dokładania wtyczek i bez płacenia za nie co roku. Przy sklepie wysyłającym za granicę to jeden z mocniejszych argumentów.' },
  { t: 'Sprzedaż B2B i B2C jednocześnie', d: 'Grupy klientów, cenniki hurtowe, progi rabatowe, ceny netto dla firm i brutto dla konsumentów. Rozbudowana logika cenowa jest tu standardem, nie modułem za dopłatą.' },
  { t: 'Rosnący obrót', d: 'Brak prowizji od sprzedaży to przewaga, która rośnie wraz z obrotem. Przy platformach abonamentowych każda złotówka sprzedaży zostawia u pośrednika procent — tutaj płacicie za wdrożenie i hosting, koniec.' },
  { t: 'Rozbudowana obsługa zamówień', d: 'Statusy, zwroty, faktury korygujące, wiele magazynów. To wszystko jest w panelu po instalacji — w innych rozwiązaniach część trzeba dokładać.' },
  { t: 'Chcecie pełnej własności', d: 'Pliki, baza, dane klientów. Wszystko Wasze i przenośne w dowolne miejsce, bez zależności od decyzji dostawcy platformy.' },
];

const zakres = [
  { n: '01', t: 'Analiza katalogu i procesów', d: 'Zaczynamy od tego, co i jak sprzedajecie: ile produktów, jakie warianty, jak wygląda obsługa zamówienia od kliknięcia do wysyłki. Od tego zależy cała reszta, łącznie z tym, czy PrestaShop w ogóle jest właściwym wyborem.' },
  { n: '02', t: 'Projekt graficzny i szablon', d: 'Motyw tworzony pod Waszą markę, nie kupiony w marketplace i podmieniony kolorystycznie. Projektujemy przede wszystkim kartę produktu i koszyk, bo to tam zapada decyzja o zakupie.' },
  { n: '03', t: 'Wdrożenie i konfiguracja', d: 'Instalacja, struktura kategorii, warianty, stawki VAT, metody dostawy i płatności, statusy zamówień, wysyłka automatycznych powiadomień do klienta.' },
  { n: '04', t: 'Integracje', d: 'Płatności, kurierzy i paczkomaty, program księgowy, hurtownia albo system magazynowy, marketplace. To zwykle ta część, która decyduje o tym, czy obsługa sklepu jest pracą na pół etatu, czy na dziesięć minut dziennie.' },
  { n: '05', t: 'Migracja i przekierowania', d: 'Przy przenosinach z innej platformy przenosimy produkty, klientów i historię zamówień, a stare adresy dostają przekierowania 301. Bez tego tracicie pozycje w Google budowane latami — to najczęstsza przyczyna spadku ruchu po zmianie sklepu.' },
  { n: '06', t: 'SEO i uruchomienie', d: 'Tytuły i opisy kategorii, dane strukturalne produktów, mapa witryny, Search Console, Analytics z Consent Mode v2, testy zamówienia od początku do końca.' },
];

const faq = [
  { q: 'Ile kosztuje wdrożenie sklepu na PrestaShop?', a: `Od ${zl(PRICING.sklep.from)} przy prostym sklepie z katalogiem do kilkunastu tysięcy przy rozbudowanym projekcie z integracjami i sprzedażą zagraniczną. Największy wpływ na cenę mają: liczba produktów i wariantów, liczba integracji oraz to, ile trzeba zaprogramować poza standardem. Wycena jest wiążąca i podajemy ją przed startem.` },
  { q: 'PrestaShop czy WooCommerce?', a: 'PrestaShop, gdy sklep to trzon projektu: duży katalog, warianty, sprzedaż zagraniczna, cenniki dla grup klientów. WooCommerce, gdy równie ważna jest treść — blog, poradniki, podstrony lokalne, SEO oparte na tekstach. Uproszczony test: jeśli sklep to 80% projektu, a treści 20% — PrestaShop. Jeśli odwrotnie — WooCommerce.' },
  { q: 'Czy PrestaShop jest trudny w obsłudze?', a: 'Panel jest gęstszy niż w WooCommerce, bo oferuje znacznie więcej. Osoba, która ogarnia WordPressa, nie usiądzie do niego od razu. Dlatego przy każdym wdrożeniu porządkujemy panel pod Wasze procesy i prowadzimy szkolenie — po nim dodawanie produktów i obsługa zamówień przestaje być problemem.' },
  { q: 'Ile kosztuje utrzymanie sklepu na PrestaShop?', a: `Hosting — przy sklepie potrzebny mocniejszy pakiet, realnie ${hostingOdnowienie()} rocznie po pierwszym roku. Domena 60–120 zł. Opieka techniczna od ${zl(PRICING.addons.maintenanceMonthly)} miesięcznie, przy sklepie zwykle więcej, bo dochodzą aktualizacje modułów i monitoring płatności. Czego nie płacicie: prowizji od każdej sprzedaży.` },
  { q: 'Czy przeniesiecie mój sklep z innej platformy?', a: 'Tak. Migracje z Shopera, IdoSell, WooCommerce i Shopify są wykonalne — przenosimy produkty, warianty, klientów i historię zamówień. Najważniejszą częścią nie jest jednak przeniesienie danych, tylko mapa przekierowań ze starych adresów. To ona decyduje, czy po migracji zachowacie ruch z Google.' },
  { q: 'Czy aktualizacje PrestaShop są problemem?', a: 'Między wersjami głównymi potrafią być wymagające, zwłaszcza przy mocno zmodyfikowanym sklepie. Dlatego budujemy tak, żeby modyfikacje siedziały w warstwie własnej, a nie w rdzeniu, i testujemy aktualizacje na kopii przed wdrożeniem na sklep. To standard w naszej opiece technicznej.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Wdrożenia sklepów PrestaShop',
  name: 'Sklepy internetowe na PrestaShop',
  description: 'Wdrożenia i migracje sklepów na PrestaShop — duże katalogi, warianty, sprzedaż zagraniczna, cenniki B2B i integracje.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'Country', name: 'Polska' },
  url: 'https://ctrlzstudio.pl/sklepy-internetowe-prestashop',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Sklepy internetowe', item: 'https://ctrlzstudio.pl/sklepy-internetowe' },
    { '@type': 'ListItem', position: 3, name: 'PrestaShop', item: 'https://ctrlzstudio.pl/sklepy-internetowe-prestashop' },
  ],
};
---

<Layout
  title="Sklepy internetowe PrestaShop — wdrożenia | CtrlZ Studio"
  description="Wdrożenia sklepów na PrestaShop: duże katalogi, warianty, sprzedaż zagraniczna i cenniki B2B. Bez prowizji od sprzedaży. Wycena wiążąca przed startem."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-crumbs { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 18px; }
  .srv-crumbs a { color: rgba(255,255,255,.68); text-decoration: none; }
  .srv-crumbs a:hover { color: #c4b5fd; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.64); line-height: 1.75; max-width: 740px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.84); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip { font-size: 12px; padding: 7px 16px; border-radius: 100px; background: rgba(56,189,248,.1); border: 1px solid rgba(56,189,248,.28); color: #7dd3fc; }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.64); line-height: 1.8; max-width: 780px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07); border-radius: 16px; padding: 26px; transition: border-color .25s, transform .25s; }
  .srv-card:hover { border-color: rgba(56,189,248,.3); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 820px; margin-top: 32px; }
  .srv-step { display: flex; gap: 22px; align-items: flex-start; padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .srv-step-n { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: #7dd3fc; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85; }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .cmp { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 34px; max-width: 900px; }
  .cmp-col { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.08); border-radius: 18px; padding: 28px; }
  .cmp-col.accent { border-color: rgba(56,189,248,.32); background: linear-gradient(160deg, rgba(56,189,248,.08), rgba(255,255,255,.02)); }
  .cmp-col h3 { font-family: var(--font-display); font-size: 18px; color: #fff; margin: 0 0 16px; font-weight: 600; }
  .cmp-col ul { list-style: none; padding: 0; margin: 0; }
  .cmp-col li { font-size: 14px; color: rgba(255,255,255,.7); line-height: 1.6; padding-left: 20px; position: relative; margin-bottom: 11px; }
  .cmp-col li::before { content: '→'; position: absolute; left: 0; color: #7dd3fc; font-size: 12px; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid, .cmp { grid-template-columns: 1fr; }
    .srv-hero { padding: 120px 0 48px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-2"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="srv-crumbs"><a href="/">Strona główna</a> · <a href="/sklepy-internetowe">Sklepy internetowe</a> · PrestaShop</div>
    <div class="eyebrow" style="margin-bottom:18px">Usługa</div>
    <h1 class="display-xl" style="margin-bottom:20px">Sklepy internetowe<br>na <span class="grad">PrestaShop</span></h1>
    <p class="srv-lead">
      Silnik zbudowany wyłącznie do sprzedaży — nie nadbudowa nad systemem blogowym.
      <strong>Duże katalogi, warianty, sprzedaż zagraniczna i cenniki B2B bez dokładania wtyczek</strong>,
      a przy tym zero prowizji od każdego zamówienia.
    </p>
    <div class="srv-chips">
      <span class="srv-chip">Bez prowizji od sprzedaży</span>
      <span class="srv-chip">Wielojęzyczność w rdzeniu</span>
      <span class="srv-chip">Cenniki B2B</span>
      <span class="srv-chip">Od {zl(PRICING.sklep.from)}</span>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Kiedy PrestaShop<br>jest <span class="grad-v">właściwym wyborem</span></h2>
    <p class="srv-p">
      Nie zawsze jest — i mówimy to wprost także wtedy, gdy oznacza to mniejsze zlecenie.
      Ale w tych sześciu sytuacjach trudno o lepsze rozwiązanie.
    </p>
    <div class="srv-grid">
      {kiedy.map((k) => (
        <div class="srv-card"><h3>{k.t}</h3><p>{k.d}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">PrestaShop <span class="grad">czy WooCommerce</span></h2>
    <p class="srv-p">
      Najczęstsze pytanie, jakie dostajemy przy sklepach. Różnica nie leży w jakości —
      obie platformy są dojrzałe. Leży w tym, <strong>czym sklep jest w Waszym projekcie</strong>.
    </p>

    <div class="cmp">
      <div class="cmp-col accent">
        <h3>PrestaShop</h3>
        <ul>
          <li>Silnik pisany od początku jako sklep</li>
          <li>Setki i tysiące produktów z wariantami</li>
          <li>Wiele języków i walut bez wtyczek</li>
          <li>Grupy klientów i cenniki hurtowe w standardzie</li>
          <li>Rozbudowana obsługa zamówień i zwrotów</li>
          <li>Słabszy przy blogu i treściach</li>
        </ul>
      </div>
      <div class="cmp-col">
        <h3>WooCommerce</h3>
        <ul>
          <li>Wtyczka do WordPressa — sklep plus treści</li>
          <li>Blog, poradniki i podstrony lokalne w tym samym systemie</li>
          <li>Łatwiejszy panel i tańsze wdrożenie</li>
          <li>Więcej wykonawców na rynku</li>
          <li>Przy dużym katalogu wymaga świadomej optymalizacji</li>
          <li>Wielojęzyczność i logika cenowa z wtyczek</li>
        </ul>
      </div>
    </div>

    <p class="srv-p" style="margin-top:28px">
      Pełne porównanie z IdoSell, Shoperem i Shopify w tekście
      <a href="/blog/porownanie-platform-sklepowych-polska" style="color:#7dd3fc">porównanie platform sklepowych</a>,
      a szczegóły samego PrestaShop — we wpisie
      <a href="/blog/prestashop-dla-kogo-ma-sens" style="color:#7dd3fc">dla kogo ma sens</a>.
    </p>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co obejmuje <span class="grad-v">wdrożenie</span></h2>
    <div class="srv-steps">
      {zakres.map((z) => (
        <div class="srv-step">
          <div class="srv-step-n">{z.n}</div>
          <div><h3>{z.t}</h3><p>{z.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Porozmawiajmy<br>o <span class="grad">Waszym sklepie</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">
      Opiszcie, co sprzedajecie, ile macie produktów i jak wygląda obsługa zamówienia.
      Powiemy, czy PrestaShop ma u Was sens — także wtedy, gdy odpowiedź brzmi „lepsze będzie coś innego".
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Zapytaj o wycenę</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/sklepy-internetowe" style="color:#7dd3fc">sklepy internetowe</a> ·
      <a href="/strony-internetowe-wordpress" style="color:#7dd3fc">strony na WordPressie</a> ·
      <a href="/hosting-dla-strony-internetowej" style="color:#7dd3fc">hosting pod sklep</a> ·
      <a href="/realizacje" style="color:#7dd3fc">realizacje</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
