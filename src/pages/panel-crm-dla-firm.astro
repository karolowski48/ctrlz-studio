---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { Image } from 'astro:assets';
import { img } from '../data/images';
import { PRICING } from '../data/pricing';

const zl = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} zł`;

const faq = [
  {
    q: 'Ile kosztuje panel CRM na zamówienie?',
    a: `Od ${zl(PRICING.crm)} netto. Ta kwota obejmuje analizę procesu, projekt, wdrożenie podstawowych modułów (klienci, zlecenia, pracownicy) i szkolenie zespołu. Cena rośnie wraz z liczbą modułów i integracji — dokładną wycenę podajemy po rozmowie, w rozpisce z etapami, i jest wiążąca.`,
  },
  {
    q: 'Czym to się różni od gotowego CRM-a z abonamentem?',
    a: 'Gotowy CRM narzuca sposób pracy i płacicie za każdego użytkownika co miesiąc, zwykle też za moduły, których nie używacie. Panel na zamówienie odwzorowuje Wasz proces — ekipy, etapy zleceń, własne dokumenty — i po wdrożeniu nie ma opłaty od osoby. Zostaje koszt serwera i opcjonalna opieka techniczna. Przy zespole powyżej kilku osób różnica zwraca się zwykle w ciągu roku lub dwóch.',
  },
  {
    q: 'Czy połączycie panel z KSeF, Subiektem albo naszym sklepem?',
    a: 'Tak, to najczęstsza część takich wdrożeń. Robiliśmy integracje z KSeF (pobieranie faktur i parowanie ich ze zleceniami), z Subiektem (magazyn i dokumenty), z WooCommerce i PrestaShop (zamówienia), z pocztą i z Google Search Console. Jeśli system ma API, da się go podpiąć — sprawdzamy to przed wyceną, żeby nie obiecywać niczego w ciemno.',
  },
  {
    q: 'Ile trwa wdrożenie?',
    a: 'Podstawowy panel: 6–10 tygodni od akceptacji projektu. Rozbudowany system z integracjami i aplikacją dla pracowników: 3–5 miesięcy. Pracujemy etapami — pierwszy moduł dostajecie do używania, zanim powstanie ostatni, więc firma korzysta z systemu w trakcie budowy, a nie dopiero na końcu.',
  },
  {
    q: 'Gdzie trzymane są nasze dane?',
    a: 'Na Waszym serwerze albo na serwerze, który dla Was konfigurujemy — w Polsce lub UE. Dane są Wasze, robimy kopie zapasowe poza serwerem i przekazujemy pełne dostępy. Nie ma tu uzależnienia od naszej firmy: system możecie w każdej chwili przenieść gdzie indziej.',
  },
  {
    q: 'Czy pracownicy w terenie też będą mieli dostęp?',
    a: 'Tak — zwykle robimy do tego osobną, lekką aplikację PWA na telefon, z widokiem tylko na to, co dotyczy danej osoby. Więcej na stronie o aplikacjach PWA. Uprawnienia ustawia się per osoba: ktoś widzi wyłącznie swoje zadania, ktoś inny finanse całej firmy.',
  },
  {
    q: 'Co jeśli po roku będziemy potrzebowali nowej funkcji?',
    a: 'Dopisujemy ją. System jest Wasz i nie ma w nim limitów narzuconych przez dostawcę. Drobne zmiany mieszczą się w opiece technicznej, większe moduły wyceniamy osobno — też z góry i wiążąco.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Panel CRM dla firm',
  name: 'Dedykowane panele CRM i systemy do zarządzania firmą',
  description: 'Projektowanie i wdrażanie paneli CRM na zamówienie: klienci, zlecenia, pracownicy, finanse, magazyn oraz integracje z KSeF, Subiektem i sklepami internetowymi.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'Country', name: 'Polska' },
  url: 'https://ctrlzstudio.pl/panel-crm-dla-firm',
  offers: {
    '@type': 'Offer',
    price: String(PRICING.crm),
    priceCurrency: 'PLN',
    priceSpecification: {
      '@type': 'PriceSpecification',
      minPrice: String(PRICING.crm),
      priceCurrency: 'PLN',
      valueAddedTaxIncluded: false,
    },
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Usługi', item: 'https://ctrlzstudio.pl/uslugi' },
    { '@type': 'ListItem', position: 3, name: 'Panel CRM dla firm', item: 'https://ctrlzstudio.pl/panel-crm-dla-firm' },
  ],
};
---

<Layout
  title="Panel CRM dla firm — system na zamówienie | CtrlZ Studio"
  description="Dedykowany panel CRM: zlecenia, ekipy, klienci, finanse i magazyn w jednym miejscu. Integracje z KSeF, Subiektem i sklepem. Wdrożenia od 18 000 zł netto."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(124,107,255,.1); border: 1px solid rgba(124,107,255,.26); color: #c4b5fd;
  }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.8); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .srv-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 780px; margin-top: 32px; }
  .srv-step { display: flex; gap: 22px; align-items: flex-start; padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .srv-step-n { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: #c4b5fd; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85; }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .srv-list li { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75; padding: 0 0 0 26px; margin-bottom: 12px; position: relative; }
  .srv-list li::before { content: '→'; position: absolute; left: 0; color: #c4b5fd; font-size: 14px; }
  .srv-shot { width: 100%; height: auto; border-radius: 16px; border: 1px solid rgba(255,255,255,.08); margin-top: 36px; }
  .srv-price-box {
    margin-top: 36px; padding: 26px 28px; border-radius: 16px;
    background: linear-gradient(135deg, rgba(124,107,255,.1), rgba(236,72,153,.05));
    border: 1px solid rgba(124,107,255,.24); max-width: 760px;
  }
  .srv-price-box .amt { font-family: var(--font-display); font-size: 34px; font-weight: 800; color: #fff; line-height: 1; }
  .srv-price-box p { font-size: 14px; color: rgba(255,255,255,.7); line-height: 1.7; margin: 10px 0 0; }
  @media (max-width: 900px) {
    .srv-inner { padding: 0 22px; }
    .srv-hero { padding: 120px 0 48px; }
    .srv-grid { grid-template-columns: 1fr; }
    .srv-section { padding: 52px 0; }
  }
</style>

<section class="srv-hero">
  <div class="srv-inner">
    <div class="eyebrow js-reveal" style="margin-bottom:18px">Panele CRM · systemy na zamówienie</div>
    <h1 class="display-xl js-reveal" style="margin-bottom:22px">Panel CRM,<br>który <span class="grad">działa jak Wasza firma</span></h1>
    <p class="srv-lead js-reveal">
      Zlecenia, klienci, ekipy, finanse i magazyn w jednym miejscu — zbudowane pod Wasz proces,
      a nie pod cudzy szablon. <strong>Bez abonamentu od każdego użytkownika</strong>
      i bez funkcji, za które płacicie, choć ich nie używacie.
    </p>
    <div class="srv-chips js-reveal">
      <span class="srv-chip">Next.js</span>
      <span class="srv-chip">KSeF</span>
      <span class="srv-chip">Subiekt</span>
      <span class="srv-chip">Aplikacja dla pracowników</span>
      <span class="srv-chip">Własny serwer</span>
    </div>
    <div class="srv-price-box js-reveal">
      <div class="amt">od {zl(PRICING.crm)} netto</div>
      <p>W cenie: analiza procesu, projekt, wdrożenie modułów podstawowych i szkolenie zespołu. Dalsze moduły i integracje wyceniamy osobno — zawsze przed startem prac.</p>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Kiedy warto zamówić <span class="grad-v">własny panel</span></h2>
    <p class="srv-p">
      Nie każda firma potrzebuje własnego systemu. Ale są sygnały, przy których arkusz kalkulacyjny
      i komunikator zaczynają kosztować więcej niż wdrożenie:
    </p>
    <ul class="srv-list">
      <li>Te same dane przepisujecie do kilku miejsc — arkusz, program do faktur, magazyn, kalendarz.</li>
      <li>Nikt nie wie na pewno, co dana ekipa robi dziś i czy materiał na jutro jest zamówiony.</li>
      <li>Ustalenia z klientem giną w mailach i wiadomościach, a potem nie ma do czego wrócić.</li>
      <li>Gotowy CRM kosztuje coraz więcej przy rosnącym zespole i nadal nie robi tego, czego potrzebujecie.</li>
      <li>Nie wiecie, które zlecenia realnie zarabiają, bo liczby są w trzech różnych programach.</li>
    </ul>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co zwykle <span class="grad">wchodzi w skład</span> panelu</h2>
    <div class="srv-grid">
      <div class="srv-card"><h3>Klienci i zlecenia</h3><p>Karta klienta z historią, zlecenia na etapach, terminy, dokumenty i notatki. Wszystko przy jednym rekordzie, a nie w trzech folderach.</p></div>
      <div class="srv-card"><h3>Pracownicy i ekipy</h3><p>Grafik pracy, przydział zadań, urlopy i konflikty terminów widoczne od razu. Uprawnienia ustawiane osobno dla każdej osoby.</p></div>
      <div class="srv-card"><h3>Wyceny i dokumenty</h3><p>Wyceny i protokoły odbioru generowane z danych zlecenia — gotowe PDF-y dla klienta, bez przepisywania do Worda.</p></div>
      <div class="srv-card"><h3>Finanse</h3><p>Przychody i koszty, płatności po terminie, rentowność zleceń. Dane z faktur, nie z ręcznie prowadzonego arkusza.</p></div>
      <div class="srv-card"><h3>Magazyn i materiały</h3><p>Stany, rozchód na zlecenia i braki zgłaszane z terenu. Integracja z programem magazynowym, żeby nie prowadzić tego dwa razy.</p></div>
      <div class="srv-card"><h3>Integracje</h3><p>KSeF, Subiekt, sklep internetowy, poczta, Google Analytics i Search Console. Podpinamy to, co ma API — sprawdzamy przed wyceną.</p></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jak to wygląda <span class="grad-v">w praktyce</span></h2>
    <p class="srv-p">
      Panel dla firmy stolarskiej z Andrychowa. Właściciel wchodzi rano na jeden ekran: montaże na dziś,
      zlecenia zagrożone terminem, wyceny bez odpowiedzi i płatności po terminie. Obok harmonogram ekip
      w formie osi czasu, razem z urlopami i konfliktami terminów.
    </p>
    <Image
      src={img('beskid-crm-pulpit.webp')!}
      alt="Pulpit panelu CRM: montaże dziś, zlecenia w toku, wyceny bez odpowiedzi, płatności po terminie i harmonogram ekip"
      widths={[640, 960, 1400]}
      sizes="(max-width: 900px) 92vw, 1100px"
      quality={78}
      loading="lazy"
      decoding="async"
      class="srv-shot"
    />
    <p class="srv-p" style="margin-top:24px">
      Pracownicy dostali osobną <a href="/aplikacje-pwa" style="color:#c4b5fd">aplikację PWA</a> z zadaniami na dziś,
      a biuro — podgląd finansów i magazynu. Panel łączy się z KSeF i Subiektem.
      <a href="/realizacje/beskid-stolarstwo" style="color:#c4b5fd">Zobacz całą realizację →</a>
    </p>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jak <span class="grad-v">przebiega wdrożenie</span></h2>
    <div class="srv-steps">
      <div class="srv-step"><div class="srv-step-n">01</div><div><h3>Analiza procesu</h3><p>Siadamy i rozpisujemy, jak firma pracuje dziś: kto, co, kiedy i w czym. Z tego wychodzi lista modułów — zwykle krótsza, niż się na początku wydaje.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">02</div><div><h3>Wycena i etapy</h3><p>Konkretna kwota, zakres i kolejność prac na piśmie. Wycena jest wiążąca, a moduły ustawiamy tak, żeby najpotrzebniejszy powstał pierwszy.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">03</div><div><h3>Projekt ekranów</h3><p>Klikalne makiety najważniejszych widoków przed kodowaniem. Tu jest najtańszy moment na zmiany i wtedy je wprowadzamy.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">04</div><div><h3>Budowa modułami</h3><p>Pierwszy moduł trafia do używania, zanim powstanie ostatni. Na bieżąco zbieramy uwagi od osób, które realnie z panelu korzystają.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">05</div><div><h3>Integracje i dane</h3><p>Podpinamy KSeF, magazyn, sklep czy pocztę i przenosimy dane z dotychczasowych arkuszy, żeby nie zaczynać od pustego systemu.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">06</div><div><h3>Szkolenie i opieka</h3><p>Szkolenie zespołu, dostępy, kopie zapasowe i monitoring. Potem opcjonalna opieka techniczna z godziną na drobne zmiany.</p></div></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Opowiedzcie,<br>jak <span class="grad">pracuje Wasza firma</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">Pierwsza rozmowa jest bezpłatna. Powiemy wprost, czy własny panel ma u Was sens, czy wystarczy dobrze ustawiony gotowy program.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Porozmawiajmy o systemie</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">Zobacz też: <a href="/aplikacje-pwa" style="color:#c4b5fd">aplikacje PWA</a> · <a href="/realizacje/beskid-stolarstwo" style="color:#c4b5fd">realizacja: panel dla firmy stolarskiej</a> · <a href="/sklepy-internetowe" style="color:#c4b5fd">sklepy internetowe</a> · <a href="/uslugi" style="color:#c4b5fd">wszystkie usługi</a></p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
