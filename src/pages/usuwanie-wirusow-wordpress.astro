---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { PRICING } from '../data/pricing';

/**
 * USUWANIE WIRUSÓW / ODWIRUSOWANIE WORDPRESS
 * ══════════════════════════════════════════
 * Frazy pilne, o wysokiej intencji: „usuwanie wirusów wordpress",
 * „odwirusowanie strony", „zhakowana strona", „strona przekierowuje na inną".
 *
 * Przewaga, której nie ma konkurencja: PRZESZLIŚMY TO NA WŁASNEJ DOMENIE.
 * Liczby w sekcji „nasza historia" są prawdziwe — pochodzą z Search Console
 * ctrlzstudio.pl. Nie zmieniać ich bez sprawdzenia w GSC.
 */

const zl = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} zł`;

const objawy = [
  { t: 'Google ostrzega przed stroną', d: 'Czerwony ekran „Strona wprowadzająca w błąd" albo komunikat w wynikach wyszukiwania. Najbardziej dotkliwy objaw, bo odcina cały ruch w jednej chwili.' },
  { t: 'Strona przekierowuje gdzie indziej', d: 'Wejście z telefonu albo z wyników Google kończy się na obcej witrynie — kasyno, apteka, oszustwo inwestycyjne. Z komputera i po wpisaniu adresu wprost często wygląda normalnie, dlatego właściciele odkrywają to późno.' },
  { t: 'W Google są podstrony, których nie tworzyliście', d: 'Wpiszcie w wyszukiwarkę site:wasza-domena.pl. Jeśli widzicie tysiące adresów zamiast kilkunastu, macie odpowiedź.' },
  { t: 'Nieznane konta administratorów', d: 'W panelu pojawiają się użytkownicy, których nikt nie zakładał. Czasem z nazwami przypominającymi systemowe.' },
  { t: 'Strona zwolniła bez powodu', d: 'Zainfekowany serwer często wysyła spam albo obsługuje cudzy ruch. Objawem bywa nagły wzrost obciążenia i wiadomość od hostingu.' },
  { t: 'Poczta trafia do spamu', d: 'Jeśli z Waszego serwera rozsyłany jest spam, domena ląduje na czarnych listach. Wtedy przestają docierać także zwykłe maile do klientów.' },
];

const proces = [
  { n: '01', t: 'Zabezpieczenie i kopia', d: 'Zanim cokolwiek usuniemy, robimy pełną kopię plików i bazy. Nawet zainfekowana strona jest materiałem dowodowym i punktem wyjścia do odtworzenia treści.' },
  { n: '02', t: 'Znalezienie punktu wejścia', d: 'Samo usunięcie złośliwego kodu nic nie daje, jeśli dziura zostaje. Szukamy przyczyny: nieaktualna wtyczka, słabe hasło, wykradzione dane FTP, luka w motywie.' },
  { n: '03', t: 'Czyszczenie', d: 'Usuwamy złośliwy kod z plików i bazy danych, kasujemy podrzucone konta administratorów, sprawdzamy zaplanowane zadania i pliki konfiguracyjne. Rdzeń WordPressa wymieniamy na czysty.' },
  { n: '04', t: 'Uszczelnienie', d: 'Aktualizacje, wymiana wszystkich haseł i kluczy bezpieczeństwa, ukrycie wersji, zablokowanie publicznej listy użytkowników, nagłówki ochronne, dwuskładnikowe logowanie do panelu.' },
  { n: '05', t: 'Sprzątanie po stronie Google', d: 'Zgłoszenie do ponownego sprawdzenia w Search Console, usunięcie śmieciowych adresów z indeksu, kontrola przekierowań. To najdłuższy etap i najczęściej pomijany przez firmy, które „czyszczą stronę".' },
  { n: '06', t: 'Monitoring', d: 'Przez kolejne tygodnie obserwujemy, czy infekcja nie wraca, i pilnujemy, jak wygląda indeks w Google.' },
];

const faq = [
  { q: 'Ile kosztuje usunięcie wirusa ze strony?', a: `Od ${zl(600)} przy pojedynczej stronie z prostą infekcją do ${zl(2500)} przy rozbudowanym serwisie albo sklepie, gdzie złośliwy kod siedzi w wielu miejscach. Osobno wyceniamy sprzątanie w Google, jeśli atak wygenerował tysiące śmieciowych adresów — to praca rozłożona na tygodnie. Dokładną kwotę podajemy po sprawdzeniu strony, przed rozpoczęciem pracy.` },
  { q: 'Ile to trwa?', a: 'Samo wyczyszczenie i uszczelnienie strony zwykle 1–3 dni robocze, przy pilnych przypadkach zaczynamy tego samego dnia. Zdjęcie ostrzeżenia Google to kolejne kilka dni po zgłoszeniu do ponownego sprawdzenia. Najdłużej trwa usuwanie śmieciowych adresów z indeksu — to miesiące, nie dni, i tu trzeba być szczerym.' },
  { q: 'Czy stracę pozycje w Google?', a: 'Krótkoterminowo zwykle tak, zwłaszcza jeśli pojawiło się ostrzeżenie o niebezpiecznej stronie. Długoterminowo pozycje wracają, o ile strona zostanie wyczyszczona, uszczelniona i poprawnie zgłoszona do ponownego sprawdzenia. Widzieliśmy to na własnej domenie — proces opisaliśmy we wpisie o odzyskiwaniu pozycji.' },
  { q: 'Skąd wziął się atak, skoro nic nie zmienialiśmy?', a: 'Właśnie dlatego. Ataki na WordPressa są prawie zawsze automatyczne — boty skanują internet w poszukiwaniu znanych podatności w nieaktualnych wtyczkach. Nie trzeba nikogo interesować ani nic robić, wystarczy nie aktualizować przez kilka miesięcy.' },
  { q: 'Czy da się to zrobić samodzielnie?', a: 'Przy prostej infekcji czasem tak — przywrócenie czystej kopii sprzed ataku i aktualizacja wszystkiego bywa wystarczające. Problem w tym, że bez znalezienia punktu wejścia infekcja wraca w ciągu kilku dni, a przywrócona kopia często jest już zainfekowana, tylko objawy jeszcze nie wyszły.' },
  { q: 'Co zrobić, żeby to się nie powtórzyło?', a: `Trzy rzeczy załatwiają większość ryzyka: regularne aktualizacje systemu i wtyczek, mocne hasła z dwuskładnikowym logowaniem oraz kopie zapasowe przechowywane poza serwerem strony. Wszystkie trzy wchodzą w naszą opiekę techniczną za ${zl(PRICING.addons.maintenanceMonthly)} miesięcznie — ale możecie też prowadzić to samodzielnie.` },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Usuwanie wirusów ze stron WordPress',
  name: 'Usuwanie wirusów i odwirusowanie strony WordPress',
  description: 'Czyszczenie zainfekowanych stron WordPress, uszczelnienie zabezpieczeń i przywrócenie widoczności w Google po ataku.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'Country', name: 'Polska' },
  url: 'https://ctrlzstudio.pl/usuwanie-wirusow-wordpress',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Usługi', item: 'https://ctrlzstudio.pl/uslugi' },
    { '@type': 'ListItem', position: 3, name: 'Usuwanie wirusów WordPress', item: 'https://ctrlzstudio.pl/usuwanie-wirusow-wordpress' },
  ],
};
---

<Layout
  title="Usuwanie wirusów WordPress — odwirusowanie strony | CtrlZ Studio"
  description="Zhakowana strona WordPress? Czyścimy, uszczelniamy i przywracamy widoczność w Google. Sami przez to przeszliśmy — 75 tys. śmieciowych adresów po ataku."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-crumbs { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 18px; }
  .srv-crumbs a { color: rgba(255,255,255,.68); text-decoration: none; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.64); line-height: 1.75; max-width: 740px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.84); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip { font-size: 12px; padding: 7px 16px; border-radius: 100px; background: rgba(248,113,113,.1); border: 1px solid rgba(248,113,113,.3); color: #fca5a5; }
  .srv-section { padding: 68px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.64); line-height: 1.8; max-width: 780px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07); border-radius: 16px; padding: 26px; transition: border-color .25s, transform .25s; }
  .srv-card:hover { border-color: rgba(248,113,113,.3); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 820px; margin-top: 32px; }
  .srv-step { display: flex; gap: 22px; align-items: flex-start; padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .srv-step-n { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: #fca5a5; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85; }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .case { max-width: 860px; border: 1px solid rgba(248,113,113,.26); border-radius: 20px; padding: 34px; background: linear-gradient(135deg, rgba(248,113,113,.07), rgba(255,255,255,.02)); }
  .case h3 { font-family: var(--font-display); font-size: 21px; color: #fff; margin: 0 0 14px; font-weight: 600; }
  .case p { font-size: 15px; color: rgba(255,255,255,.72); line-height: 1.8; margin: 0 0 14px; }
  .case-nums { display: grid; grid-template-columns: repeat(3,1fr); gap: 14px; margin: 24px 0 6px; }
  .case-box { background: rgba(10,10,26,.45); border: 1px solid rgba(255,255,255,.09); border-radius: 12px; padding: 18px 14px; text-align: center; }
  .case-n { font-family: var(--font-display); font-size: 26px; font-weight: 800; line-height: 1; margin-bottom: 7px; }
  .case-l { font-size: 10.5px; letter-spacing: .09em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .alert { max-width: 820px; margin-top: 30px; padding: 24px 26px; border-radius: 16px; background: rgba(251,191,36,.07); border: 1px solid rgba(251,191,36,.3); }
  .alert h3 { font-family: var(--font-display); font-size: 17px; color: #fbbf24; margin: 0 0 12px; font-weight: 600; }
  .alert p { font-size: 14.5px; color: rgba(255,255,255,.75); line-height: 1.75; margin: 0 0 10px; }
  .alert ol { margin: 12px 0 0; padding-left: 22px; }
  .alert li { font-size: 14px; color: rgba(255,255,255,.74); line-height: 1.7; margin-bottom: 8px; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid { grid-template-columns: 1fr; }
    .case-nums { grid-template-columns: 1fr; }
    .case { padding: 24px 20px; }
    .srv-hero { padding: 120px 0 48px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-2"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="srv-crumbs"><a href="/">Strona główna</a> · <a href="/uslugi">Usługi</a> · Usuwanie wirusów</div>
    <div class="eyebrow" style="margin-bottom:18px">Pomoc awaryjna</div>
    <h1 class="display-xl" style="margin-bottom:20px">Usuwanie wirusów<br>ze stron <span class="grad">WordPress</span></h1>
    <p class="srv-lead">
      Strona przekierowuje na obcą witrynę, Google ostrzega przed nią albo w wynikach pojawiły się
      tysiące adresów, których nie tworzyliście. <strong>Czyścimy, uszczelniamy i doprowadzamy do porządku
      to, co zostało po ataku w Google</strong> — bo samo usunięcie kodu to dopiero połowa roboty.
    </p>
    <div class="srv-chips">
      <span class="srv-chip">Start tego samego dnia</span>
      <span class="srv-chip">Znajdujemy punkt wejścia</span>
      <span class="srv-chip">Sprzątanie indeksu Google</span>
    </div>
  </div>
</section>

<!-- NASZA HISTORIA -->
<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Przeszliśmy przez to<br><span class="grad-v">na własnej stronie</span></h2>
    <div class="case">
      <h3>75 000 śmieciowych adresów w Google</h3>
      <p>
        Nasza wcześniejsza strona stała na WordPressie i została zainfekowana. Atak wygenerował
        <strong>dziesiątki tysięcy podstron ze spamem</strong>, które Google zaczęło indeksować.
        Nie chodziło o kilka podejrzanych plików — chodziło o domenę, która w oczach wyszukiwarki
        zamieniła się w farmę spamu.
      </p>
      <p>
        Odbudowa polegała na trzech rzeczach naraz: wyczyszczeniu i przeniesieniu strony na technologię
        bez bazy danych, systematycznym zgłaszaniu śmieciowych adresów do usunięcia i cierpliwym pilnowaniu
        indeksu w Search Console. To nie była praca na tydzień.
      </p>
      <div class="case-nums">
        <div class="case-box"><div class="case-n" style="color:#f87171">75 tys.</div><div class="case-l">adresów po ataku</div></div>
        <div class="case-box"><div class="case-n" style="color:#fbbf24">8,5 tys.</div><div class="case-l">po dwóch miesiącach</div></div>
        <div class="case-box"><div class="case-n" style="color:#6ee7a8">85</div><div class="case-l">poprawnych podstron w indeksie</div></div>
      </div>
      <p style="margin-top:18px;font-size:13.5px;color:rgba(255,255,255,.55)">
        Dane z Search Console ctrlzstudio.pl. Liczba śmieciowych adresów nadal spada.
      </p>
    </div>
    <p class="srv-p" style="margin-top:28px">
      Piszemy o tym, bo to jest różnica między firmą, która wyczyści Wam pliki, a firmą, która wie,
      co dzieje się <strong>potem</strong> — i ile to realnie trwa. Cały przebieg opisaliśmy we wpisie
      <a href="/blog/zawirusowana-strona-wordpress" style="color:#fca5a5">zawirusowana strona WordPress</a>.
    </p>
  </div>
</section>

<!-- CO ROBIĆ TERAZ -->
<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jeśli to dzieje się<br><span class="grad">właśnie teraz</span></h2>
    <div class="alert">
      <h3>Pięć rzeczy, zanim się do nas odezwiecie</h3>
      <ol>
        <li><strong>Nie kasujcie niczego w panice.</strong> Usunięcie plików bez kopii utrudnia znalezienie przyczyny.</li>
        <li><strong>Zróbcie kopię</strong> plików i bazy, nawet zainfekowaną. Będzie potrzebna.</li>
        <li><strong>Zmieńcie hasła</strong> do panelu, FTP, bazy i hostingu. Wszystkie, nie tylko administratora.</li>
        <li><strong>Sprawdźcie Search Console</strong> — zakładka Bezpieczeństwo powie, czy Google już wykryło problem.</li>
        <li><strong>Powiadomcie hosting.</strong> Część dostawców blokuje zainfekowane konta, lepiej uprzedzić niż zostać odciętym.</li>
      </ol>
      <p style="margin-top:14px">
        Jeśli strona przyjmuje płatności albo zbiera dane osobowe, wyciek może wymagać zgłoszenia do UODO —
        w takim wypadku warto od razu skonsultować to z prawnikiem.
      </p>
    </div>
  </div>
</section>

<!-- OBJAWY -->
<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Po czym poznać, że strona<br><span class="grad-v">jest zainfekowana</span></h2>
    <div class="srv-grid">
      {objawy.map((o) => <div class="srv-card"><h3>{o.t}</h3><p>{o.d}</p></div>)}
    </div>
    <p class="srv-p" style="margin-top:28px">
      Nie macie pewności? Rozpisaliśmy to szczegółowo we wpisie
      <a href="/blog/jak-sprawdzic-czy-strona-jest-zainfekowana" style="color:#fca5a5">jak sprawdzić, czy strona jest zainfekowana</a>,
      albo zamówcie <a href="/bezplatny-audyt" style="color:#fca5a5">bezpłatny audyt</a> — część takich rzeczy wykrywamy automatycznie.
    </p>
  </div>
</section>

<!-- PROCES -->
<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jak wygląda <span class="grad">odwirusowanie</span></h2>
    <div class="srv-steps">
      {proces.map((p) => (
        <div class="srv-step">
          <div class="srv-step-n">{p.n}</div>
          <div><h3>{p.t}</h3><p>{p.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="srv-section srv-section-alt">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Napiszcie <span class="grad">dziś</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">
      Przy infekcji liczy się czas — im dłużej strona rozsyła spam, tym więcej zostaje do posprzątania
      w Google. Podajcie adres strony i opiszcie, co się dzieje. Odpowiadamy tego samego dnia roboczego.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Zgłoś problem</span></a>
      <a href="/wsparcie-techniczne" class="btn-ghost"><span>Opieka nad WordPressem</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/wsparcie-techniczne" style="color:#fca5a5">wsparcie techniczne</a> ·
      <a href="/bezplatny-audyt" style="color:#fca5a5">bezpłatny audyt</a> ·
      <a href="/blog/ile-trwa-odzyskanie-pozycji-w-google" style="color:#fca5a5">ile trwa odzyskanie pozycji</a> ·
      <a href="/strony-internetowe-astro-nextjs" style="color:#fca5a5">strona bez WordPressa</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();
  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
