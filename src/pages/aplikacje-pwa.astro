---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { Image } from 'astro:assets';
import { img } from '../data/images';

const faq = [
  {
    q: 'Czym jest aplikacja PWA?',
    a: 'To aplikacja, która działa w przeglądarce, ale instaluje się na ekranie głównym telefonu i zachowuje jak zwykła aplikacja: pełny ekran, własna ikona, powiadomienia push i działanie także przy słabym zasięgu. Nie trzeba jej publikować w Google Play ani App Store, a aktualizacja dociera do wszystkich od razu, bez czekania na akceptację sklepu.',
  },
  {
    q: 'Ile kosztuje aplikacja PWA?',
    a: 'Wycena jest indywidualna, bo zakres takich projektów bardzo się różni: prosta aplikacja z zadaniami dla pracowników to inna praca niż aplikacja dla klientów z kontem, płatnościami i historią zamówień. Po rozmowie podajemy konkretną kwotę i zakres na piśmie — wiążące, bez faktur za „prace dodatkowe”. Najczęściej PWA powstaje razem z panelem, wtedy liczymy całość jednym budżetem.',
  },
  {
    q: 'PWA czy aplikacja natywna ze sklepu?',
    a: 'Aplikacja natywna ma sens, gdy potrzebujecie pełnego dostępu do sprzętu telefonu albo obecności w sklepie jako kanału sprzedaży. Do zastosowań firmowych — zadania dla ekip, zgłoszenia, raporty z terenu, panel klienta — PWA jest zwykle tańsza o rząd wielkości, szybsza we wdrożeniu i łatwiejsza w utrzymaniu, bo to jedna aplikacja na Androida i iPhone’a zamiast dwóch osobnych.',
  },
  {
    q: 'Czy PWA działa bez internetu?',
    a: 'Częściowo — i to zwykle wystarcza. Aplikacja zapamiętuje ostatnio pobrane dane, więc pracownik na budowie bez zasięgu nadal widzi zadania i adresy. Zmiany zapisują się lokalnie i wysyłają, gdy zasięg wróci. Zakres pracy offline ustalamy przy projekcie, bo pełna praca bez sieci potrafi podnieść koszt bardziej, niż jest warta.',
  },
  {
    q: 'Czy powiadomienia działają na iPhone?',
    a: 'Tak, od iOS 16.4 — pod warunkiem, że aplikacja zostanie dodana do ekranu głównego. To jedyny dodatkowy krok, który trzeba pokazać pracownikom przy wdrożeniu. Na Androidzie powiadomienia działają od razu po instalacji.',
  },
  {
    q: 'Czy aplikacja połączy się z naszym systemem?',
    a: 'Tak — najczęściej robimy PWA jako część większej całości: panel dla biura plus aplikacja dla ludzi w terenie, na tych samych danych. Podpinamy się też do istniejących systemów, jeśli mają API. Zobacz stronę o panelach CRM.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Aplikacje PWA',
  name: 'Tworzenie aplikacji PWA dla firm',
  description: 'Aplikacje PWA instalowane na ekranie głównym telefonu: zadania dla pracowników, zgłoszenia z terenu, panele klienta. Bez publikacji w sklepach, z powiadomieniami push.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'Country', name: 'Polska' },
  url: 'https://ctrlzstudio.pl/aplikacje-pwa',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Usługi', item: 'https://ctrlzstudio.pl/uslugi' },
    { '@type': 'ListItem', position: 3, name: 'Aplikacje PWA', item: 'https://ctrlzstudio.pl/aplikacje-pwa' },
  ],
};
---

<Layout
  title="Aplikacje PWA dla firm — instalacja bez sklepu | CtrlZ Studio"
  description="Tworzymy aplikacje PWA: instalują się na ekranie głównym telefonu, działają przy słabym zasięgu i wysyłają powiadomienia push. Zadania dla ekip, zgłoszenia z terenu, panele klienta."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(124,107,255,.1); border: 1px solid rgba(124,107,255,.26); color: #c4b5fd;
  }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.8); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .srv-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 780px; margin-top: 32px; }
  .srv-step { display: flex; gap: 22px; align-items: flex-start; padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .srv-step-n { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: #c4b5fd; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85; }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .srv-list li { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75; padding: 0 0 0 26px; margin-bottom: 12px; position: relative; }
  .srv-list li::before { content: '→'; position: absolute; left: 0; color: #c4b5fd; font-size: 14px; }
  .srv-split { display: grid; grid-template-columns: minmax(0,1fr) 320px; gap: 48px; align-items: center; margin-top: 36px; }
  .srv-phone { width: 100%; height: auto; border-radius: 26px; }
  .srv-price-box {
    margin-top: 36px; padding: 26px 28px; border-radius: 16px;
    background: linear-gradient(135deg, rgba(124,107,255,.1), rgba(236,72,153,.05));
    border: 1px solid rgba(124,107,255,.24); max-width: 760px;
  }
  .srv-price-box .amt { font-family: var(--font-display); font-size: 30px; font-weight: 800; color: #fff; line-height: 1.1; }
  .srv-price-box p { font-size: 14px; color: rgba(255,255,255,.7); line-height: 1.7; margin: 10px 0 0; }
  @media (max-width: 900px) {
    .srv-inner { padding: 0 22px; }
    .srv-hero { padding: 120px 0 48px; }
    .srv-grid, .srv-split { grid-template-columns: 1fr; }
    .srv-split .srv-phone { max-width: 280px; margin: 0 auto; }
    .srv-section { padding: 52px 0; }
  }
</style>

<section class="srv-hero">
  <div class="srv-inner">
    <div class="eyebrow js-reveal" style="margin-bottom:18px">Aplikacje PWA</div>
    <h1 class="display-xl js-reveal" style="margin-bottom:22px">Aplikacja na telefon<br><span class="grad">bez sklepu z aplikacjami</span></h1>
    <p class="srv-lead js-reveal">
      PWA instaluje się z przeglądarki na ekran główny telefonu i zachowuje jak zwykła aplikacja:
      pełny ekran, własna ikona, powiadomienia push i działanie przy słabym zasięgu.
      <strong>Jedna aplikacja na Androida i iPhone’a</strong> — bez czekania na akceptację Google i Apple.
    </p>
    <div class="srv-chips js-reveal">
      <span class="srv-chip">Instalacja z przeglądarki</span>
      <span class="srv-chip">Powiadomienia push</span>
      <span class="srv-chip">Działa offline</span>
      <span class="srv-chip">Android + iOS</span>
      <span class="srv-chip">Next.js</span>
    </div>
    <div class="srv-price-box js-reveal">
      <div class="amt">Wycena indywidualna</div>
      <p>Zakres takich projektów bardzo się różni, więc nie udajemy jednej ceny dla wszystkich. Po rozmowie dostajecie konkretną kwotę i zakres na piśmie — wiążące przed startem prac.</p>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Do czego to się <span class="grad-v">najlepiej nadaje</span></h2>
    <ul class="srv-list">
      <li><strong>Zadania dla pracowników w terenie</strong> — każdy widzi tylko swoje zlecenia na dziś, z adresem i nawigacją.</li>
      <li><strong>Zgłoszenia z budowy czy montażu</strong> — zdjęcia, brakujący materiał, usterka: wszystko trafia od razu do biura.</li>
      <li><strong>Ewidencja czasu pracy</strong> — start i koniec pracy odbijany w telefonie, bez papierowych list.</li>
      <li><strong>Panel klienta</strong> — status zlecenia, dokumenty i zgłoszenia bez dzwonienia do biura.</li>
      <li><strong>Program lojalnościowy albo zamówienia</strong> dla stałych klientów, z powiadomieniem o gotowym zamówieniu.</li>
    </ul>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Przykład: <span class="grad">aplikacja dla ekip montażowych</span></h2>
    <div class="srv-split">
      <div>
        <p class="srv-p">
          Pracownik odpala rano aplikację i widzi bieżące zlecenie: adres, godziny i dystans.
          Nawigacja i telefon do klienta są jednym kliknięciem, czas pracy odbija się w aplikacji,
          a zadania odhacza się po kolei.
        </p>
        <p class="srv-p">
          Trzy duże przyciski — <strong>zdjęcie</strong>, <strong>materiał</strong>, <strong>usterka</strong> — zastąpiły
          wysyłanie zdjęć na komunikator. Wszystko ląduje przy zleceniu w panelu biura, razem z godziną i autorem.
        </p>
        <p class="srv-p">
          Aplikacja powstała razem z <a href="/panel-crm-dla-firm" style="color:#c4b5fd">panelem CRM</a> dla firmy stolarskiej.
          <a href="/realizacje/beskid-stolarstwo" style="color:#c4b5fd">Zobacz całą realizację →</a>
        </p>
      </div>
      <Image
        src={img('beskid-crm-pwa.webp')!}
        alt="Aplikacja PWA pracownika: bieżące zlecenie, czas pracy, przyciski zgłoszeń i lista zadań na dziś"
        widths={[320, 480, 742]}
        sizes="(max-width: 900px) 60vw, 320px"
        quality={80}
        loading="lazy"
        decoding="async"
        class="srv-phone"
      />
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co dostajecie <span class="grad-v">w każdym projekcie</span></h2>
    <div class="srv-grid">
      <div class="srv-card"><h3>Instalacja bez sklepu</h3><p>Pracownik wchodzi na adres, dodaje aplikację do ekranu głównego i gotowe. Żadnych kont deweloperskich ani opłat rocznych.</p></div>
      <div class="srv-card"><h3>Powiadomienia push</h3><p>Nowe zadanie, zmiana terminu, zgłoszenie od klienta. Na Androidzie od razu, na iPhonie po dodaniu do ekranu głównego.</p></div>
      <div class="srv-card"><h3>Praca przy słabym zasięgu</h3><p>Ostatnie dane zostają w telefonie, zmiany wysyłają się, gdy sieć wróci. Budowa w lesie nie blokuje pracy.</p></div>
      <div class="srv-card"><h3>Jeden kod, dwa systemy</h3><p>Android i iPhone obsługiwane tą samą aplikacją. Aktualizacja dociera do wszystkich natychmiast.</p></div>
      <div class="srv-card"><h3>Uprawnienia per osoba</h3><p>Każdy widzi tylko to, co go dotyczy. Pracownik swoje zadania, brygadzista całą ekipę, biuro całość.</p></div>
      <div class="srv-card"><h3>Połączenie z panelem</h3><p>Aplikacja i panel biura pracują na tych samych danych, więc nic nie trzeba przepisywać ani synchronizować ręcznie.</p></div>
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jak <span class="grad-v">przebiega projekt</span></h2>
    <div class="srv-steps">
      <div class="srv-step"><div class="srv-step-n">01</div><div><h3>Rozmowa o dniu pracy</h3><p>Kto ma używać aplikacji, w jakich warunkach i co musi zrobić w pięć sekund jedną ręką. To wyznacza cały projekt.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">02</div><div><h3>Wycena i zakres</h3><p>Konkretna kwota i lista ekranów na piśmie. Wycena wiążąca, bez dopisywania „prac dodatkowych” na końcu.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">03</div><div><h3>Projekt ekranów</h3><p>Makiety na telefonie, testowane na prawdziwym urządzeniu — duże przyciski, czytelne w słońcu i w rękawicach.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">04</div><div><h3>Budowa i testy w terenie</h3><p>Aplikacja idzie na telefony kilku osób, zanim trafi do całej firmy. Poprawki wychodzą z realnego użycia, nie z założeń.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">05</div><div><h3>Wdrożenie w zespole</h3><p>Pokazujemy instalację na ekranie głównym i przechodzimy z ludźmi przez pierwszy dzień pracy w aplikacji.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">06</div><div><h3>Opieka</h3><p>Monitoring, kopie zapasowe i rozwój aplikacji o kolejne funkcje, kiedy firma ich potrzebuje.</p></div></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Opowiedzcie,<br>co ma robić <span class="grad">ta aplikacja</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">Pierwsza rozmowa jest bezpłatna. Powiemy, czy PWA wystarczy, czy w Waszym przypadku potrzebna jest aplikacja natywna — i ile to realnie kosztuje.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Zapytaj o wycenę</span></a>
      <a href="/panel-crm-dla-firm" class="btn-ghost"><span>Zobacz panele CRM</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">Zobacz też: <a href="/panel-crm-dla-firm" style="color:#c4b5fd">panel CRM dla firm</a> · <a href="/realizacje/beskid-stolarstwo" style="color:#c4b5fd">realizacja: panel i aplikacja dla ekip</a> · <a href="/strony-internetowe-astro-nextjs" style="color:#c4b5fd">strony w Next.js</a> · <a href="/uslugi" style="color:#c4b5fd">wszystkie usługi</a></p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
