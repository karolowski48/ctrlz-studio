---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  { q: 'Ile kosztuje strona internetowa?', a: priceAnswer() },
  { q: 'Co jeszcze można dobrać do projektu?', a: addonsAnswer() },
  { q: 'WordPress czy strona pisana od zera?', a: 'WordPress ma sens, gdy chcecie często samodzielnie edytować treści — bloga, aktualności, ofertę. Strona pisana w Astro albo Next.js jest wyraźnie szybsza, bezpieczniejsza i tańsza w utrzymaniu, bo nie ma wtyczek do aktualizowania i nie ma czego zhakować. Decydujemy po rozmowie o tym, jak realnie będziecie strony używać — a nie o tym, co nam wygodniej zrobić.' },
  { q: 'Ile trwa zrobienie strony?', a: 'Wizytówka: 2–4 tygodnie. Strona firmowa z projektem graficznym od zera: 4–8 tygodni. W dziewięciu przypadkach na dziesięć opóźnienia biorą się z czekania na treści i zdjęcia po stronie klienta, nie z naszej pracy. Jeśli macie materiały gotowe, idzie znacznie szybciej.' },
  { q: 'Czy dostanę stronę, którą sam mogę edytować?', a: 'Jeśli tego chcecie — tak. Panel do edycji podnosi trochę cenę i wymaga aktualizacji, więc przy stronie, która zmienia się dwa razy w roku, często nie ma sensu. Powiemy wprost, co się bardziej opłaca w Waszym przypadku.' },
  { q: 'Ile rund poprawek wchodzi w cenę?', a: 'Dwie rundy na etapie projektu graficznego, przed kodowaniem. Nieograniczone poprawki nie istnieją — jeśli ktoś je obiecuje, albo wliczył je w cenę, albo zakończy współpracę zniechęcony.' },
  { q: 'Na kogo będzie zarejestrowana domena?', a: 'Na Was. Dostępy do hostingu i panelu przekazujemy w komplecie po wdrożeniu. Strona jest Waszą własnością i możecie ją w każdej chwili przenieść gdzie indziej.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  name: 'Projektowanie i tworzenie stron internetowych',
  description: 'Projektowanie i kodowanie stron firmowych — od wizytowki po rozbudowany serwis z blogiem i katalogiem uslug.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'województwo małopolskie' },
  url: 'https://ctrlzstudio.pl/strony-internetowe',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Strony internetowe', item: 'https://ctrlzstudio.pl/strony-internetowe' },
  ],
};
---

<Layout
  title="Tworzenie stron internetowych — projektowanie WWW | CtrlZ Studio"
  description="Projektowanie i tworzenie stron internetowych dla firm. Indywidualny projekt, wynik PageSpeed 90+, konfiguracja SEO. Ceny od 2 000 zł. Studio z Małopolski."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(124,107,255,.1); border: 1px solid rgba(124,107,255,.26); color: #c4b5fd;
  }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.8); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .srv-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 780px; margin-top: 32px; }
  .srv-step {
    display: flex; gap: 22px; align-items: flex-start;
    padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07);
  }
  .srv-step-n {
    font-family: var(--font-display); font-size: 26px; font-weight: 800;
    color: #c4b5fd; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85;
  }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .srv-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .srv-list li::before { content: '→'; position: absolute; left: 0; color: #c4b5fd; font-size: 14px; }
  .srv-list strong { color: rgba(255,255,255,.8); font-weight: 500; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid { grid-template-columns: 1fr; }
    .srv-hero { padding: 120px 0 48px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Usługa</div>
    <h1 class="display-xl" style="margin-bottom:20px">Tworzenie stron<br><span class="grad">internetowych</span></h1>
    <p class="srv-lead">Projektujemy i kodujemy strony, które <strong>ładują się w ułamku sekundy i dają się znaleźć w Google</strong>. Od wizytówki dla jednoosobowej firmy po rozbudowany serwis z katalogiem usług i blogiem.</p>
    <div class="srv-chips"><span class="srv-chip">Indywidualny projekt</span>
      <span class="srv-chip">PageSpeed 90+</span>
      <span class="srv-chip">Konfiguracja SEO</span>
      <span class="srv-chip">Od 2 000 zł</span></div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Strona to nie <span class="grad-v">koszt</span> —<br>to narzędzie z policzalnym zwrotem</h2>
    <p class="srv-p">
      Większość rozmów o stronie zaczyna się od pytania „ile to kosztuje", a powinna od pytania
      „ilu klientów ma przynieść". <strong>Jeśli średnie zlecenie zostawia Wam 900 zł marży,
      strona za 6 000 zł zwraca się po siedmiu klientach</strong> — jednorazowo, bo potem pracuje dalej.
    </p>
    <p class="srv-p">
      Dlatego nie robimy stron „ładnych". Robimy takie, które odpowiadają na zapytania,
      jakie realnie wpisują Wasi klienci, ładują się szybciej niż strony konkurencji
      i prowadzą odwiedzającego do kontaktu bez zastanawiania się, gdzie kliknąć.
    </p>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co dostajecie<br>w <span class="grad">każdym projekcie</span></h2>
    <div class="srv-grid">
      <div class="srv-card"><h3>Indywidualny projekt</h3><p>Makiety desktop i mobile tworzone pod Waszą markę. Nie szablon kupiony za dwie stówy i podmieniony kolorystycznie.</p></div>
      <div class="srv-card"><h3>Szybkość ponad 90</h3><p>Celujemy w wynik powyżej 90 w PageSpeed na telefonie. To nie kosmetyka — wolna strona traci klientów i pozycje w Google.</p></div>
      <div class="srv-card"><h3>Konfiguracja SEO</h3><p>Tytuły, opisy, dane strukturalne, mapa witryny, Search Console, Analytics. Część, którą pomija większość tanich ofert.</p></div>
      <div class="srv-card"><h3>Responsywność</h3><p>Około 70% ruchu na stronach lokalnych firm to telefony. Projektujemy od razu pod ten ekran, nie „przy okazji".</p></div>
      <div class="srv-card"><h3>Domena i dostępy</h3><p>Domena rejestrowana na Was, dostępy przekazane w komplecie. Możecie w każdej chwili przenieść stronę gdzie indziej.</p></div>
      <div class="srv-card"><h3>Gwarancja</h3><p>Na błędy techniczne po wdrożeniu, z ustaloną z góry stawką za późniejsze zmiany. Żadnych niespodzianek na fakturze.</p></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jak to <span class="grad-v">przebiega</span></h2>
    <div class="srv-steps">
      <div class="srv-step"><div class="srv-step-n">01</div><div><h3>Rozmowa i analiza</h3><p>Pytamy o branżę, konkurencję i o to, skąd dziś przychodzą klienci. Sprawdzamy, na jakie frazy warto celować. Bez tego nie da się zaprojektować niczego sensownego.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">02</div><div><h3>Wycena</h3><p>Konkretna kwota i zakres na piśmie. Cena jest wiążąca — nie dokładamy faktur za „prace dodatkowe".</p></div></div>
      <div class="srv-step"><div class="srv-step-n">03</div><div><h3>Projekt graficzny</h3><p>Makiety wersji desktop i mobilnej. Dwie rundy poprawek w cenie, akceptacja przed napisaniem pierwszej linijki kodu.</p></div></div>
      <div class="srv-step"><div class="srv-step-n">04</div><div><h3>Kodowanie</h3><p>Astro, Next.js albo WordPress — zależnie od tego, jak będziecie strony używać. Pisane pod szybkość, nie „żeby działało".</p></div></div>
      <div class="srv-step"><div class="srv-step-n">05</div><div><h3>SEO i wdrożenie</h3><p>Dane strukturalne, mapa witryny, Search Console, Analytics, certyfikat SSL. Strona startuje gotowa do indeksowania, nie „do dokonfigurowania kiedyś".</p></div></div>
      <div class="srv-step"><div class="srv-step-n">06</div><div><h3>Po starcie</h3><p>Gwarancja, przekazanie dostępów i krótka instrukcja. Opcjonalnie opieka techniczna, jeśli nie chcecie zajmować się tym sami.</p></div></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Zróbmy stronę,<br>która <span class="grad">przynosi zapytania</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">Pierwsza rozmowa jest bezpłatna i niezobowiązująca. Powiemy wprost, czego Wasza firma potrzebuje, a czego nie warto kupować.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">Zobacz też: <a href="/strony-internetowe-wordpress" style="color:#c4b5fd">strony na WordPressie</a> · <a href="/strony-internetowe-astro-nextjs" style="color:#c4b5fd">Astro i Next.js</a> · <a href="/ile-kosztuje-strona-internetowa" style="color:#c4b5fd">ile kosztuje strona</a> · <a href="/sklepy-internetowe" style="color:#c4b5fd">sklepy internetowe</a> · <a href="/pozycjonowanie-seo" style="color:#c4b5fd">pozycjonowanie SEO</a> · <a href="/audyt-strony" style="color:#c4b5fd">audyt strony</a> · <a href="/realizacje" style="color:#c4b5fd">realizacje</a></p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
