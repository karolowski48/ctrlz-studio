---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  {
    q: 'Ile kosztuje strona internetowa dla firmy ze Skawiny?',
    a: priceAnswer('Skawiny'),
  },
  {
    q: 'Co jeszcze można dobrać do projektu?',
    a: addonsAnswer(),
  },
  {
    q: 'Czy trzeba się spotkać osobiście?',
    a: 'Nie trzeba, ale można. Ze Skawiny do naszego biura w Izdebniku jest kilkanaście minut drogi i chętnie się spotkamy — przy pierwszym projekcie to zwykle pomaga. Cały proces da się też przeprowadzić zdalnie, jeśli tak Ci wygodniej.',
  },
  {
    q: 'Jak długo trwa zrobienie strony?',
    a: 'Strona wizytówkowa: 2–4 tygodnie. Strona firmowa z projektem graficznym od zera: 4–8 tygodni. Sklep: 8–16 tygodni. Największym źródłem opóźnień są treści i zdjęcia po stronie klienta — jeśli masz je przygotowane, terminy skracają się wyraźnie.',
  },
  {
    q: 'Czy pomożecie mi wyjść wyżej w Google na frazy ze Skawiną?',
    a: 'Tak, to element każdego projektu. Konfigurujemy dane strukturalne LocalBusiness, zgłaszamy mapę witryny do Search Console, budujemy strukturę podstron pod konkretne usługi i doradzamy przy wizytówce Google. Nie obiecujemy pierwszego miejsca — nikt uczciwy tego nie obiecuje — ale przygotowujemy stronę tak, żeby miała o co walczyć.',
  },
  {
    q: 'Czy domena i hosting będą moje?',
    a: 'Zawsze. Domenę rejestrujemy na Twoje dane, dostępy do hostingu i panelu przekazujemy w komplecie po wdrożeniu. Możesz w każdej chwili przenieść stronę gdzie indziej — to Twoja własność, nie nasza dźwignia.',
  },
  {
    q: 'Robicie strony na WordPressie czy pisane od zera?',
    a: 'Zależy od potrzeby. WordPress ma sens, gdy chcesz często samodzielnie edytować treści. Strona pisana w Astro lub Next.js jest wyraźnie szybsza, bezpieczniejsza i tańsza w utrzymaniu, ale zmiany w układzie wymagają kontaktu z nami. Doradzamy po rozmowie o tym, jak realnie będziesz strony używać.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: {
    '@type': 'City',
    name: 'Skawina',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'powiat krakowski, województwo małopolskie' },
  },
  url: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-skawina',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Tworzenie stron internetowych — Skawina', item: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-skawina' },
  ],
};
---

<Layout
  title="Tworzenie stron internetowych Skawina | CtrlZ Studio"
  description="Projektowanie i tworzenie stron internetowych dla firm ze Skawiny, Radziszowa, Woli Radziszowskiej i okolic. Szybkie strony WWW, sklepy i SEO lokalne."
>
<SharedNav />

<main id="main-content">

<style>
  .loc-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .loc-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .loc-h1 { margin-bottom: 20px; }
  .loc-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .loc-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }

  .loc-quick { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .loc-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(124,107,255,.1); border: 1px solid rgba(124,107,255,.24);
    color: #c4b5fd;
  }

  .loc-section { padding: 72px 0; background: var(--bg-base); }
  .loc-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .loc-h2 { margin-bottom: 18px; }
  .loc-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .loc-p strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .loc-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .loc-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .loc-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .loc-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }

  .loc-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .loc-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .loc-list li::before {
    content: '→'; position: absolute; left: 0; color: #7c6bff; font-size: 14px;
  }
  .loc-list strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-villages { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.9; max-width: 820px; margin-top: 18px; }

  @media (max-width: 1024px) { .loc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .loc-inner { padding: 0 24px; }
    .loc-grid { grid-template-columns: 1fr; }
    .loc-hero { padding: 120px 0 48px; }
  }
</style>

<!-- HERO -->
<section class="loc-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="loc-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Skawina i okolice</div>
    <h1 class="display-xl loc-h1">
      Tworzenie stron<br>
      internetowych<br>
      <span class="grad">Skawina</span>
    </h1>
    <p class="loc-lead">
      Projektujemy i kodujemy strony WWW dla firm ze Skawiny, Radziszowa, Woli Radziszowskiej
      i całej gminy. <strong>Studio mamy w Izdebniku — kilkanaście minut od Was.</strong>
      Robimy strony, które ładują się w ułamku sekundy i dają się znaleźć w Google,
      kiedy ktoś z okolicy szuka Waszej usługi.
    </p>
    <div class="loc-quick">
      <span class="loc-chip">Strony firmowe</span>
      <span class="loc-chip">Sklepy internetowe</span>
      <span class="loc-chip">SEO lokalne</span>
      <span class="loc-chip">Projekt UX/UI</span>
    </div>
  </div>
</section>

<!-- DLACZEGO SKAWINA -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Skawina to <span class="grad-v">trudniejszy rynek</span><br>niż się wydaje</h2>
    <p class="loc-p">
      Skawina ma specyficzną sytuację: leży kwadrans od Krakowa, więc firmy stąd konkurują
      nie tylko ze sobą, ale też z krakowskimi. Mieszkańcy dojeżdżają do pracy do Krakowa
      i przywożą stamtąd przyzwyczajenia — <strong>jeśli lokalna firma wygląda gorzej niż krakowska,
      klient po prostu wybierze tę z miasta.</strong>
    </p>
    <p class="loc-p">
      Z drugiej strony to jedno z najbardziej uprzemysłowionych miejsc w powiecie krakowskim.
      Strefa aktywności gospodarczej, dużo firm produkcyjnych, usługowych i podwykonawców.
      Rynek jest, tylko rzadko kto walczy o niego w internecie — a to znaczy,
      że frazy w rodzaju „tworzenie stron www Skawina" czy „elektryk Skawina"
      są nadal do wzięcia niewielkim nakładem.
    </p>
    <p class="loc-p">
      W praktyce oznacza to jedno: strona firmy ze Skawiny musi wyglądać na tyle dobrze,
      żeby wytrzymać porównanie z krakowską konkurencją, i być na tyle poprawnie zrobiona
      technicznie, żeby wygrywać lokalne wyszukiwania. To dwa różne zadania i oba trzeba zrobić.
    </p>
  </div>
</section>

<!-- CO ROBIMY -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Co robimy dla firm<br>ze <span class="grad">Skawiny</span></h2>
    <div class="loc-grid">
      <div class="loc-card">
        <h3>Strony firmowe</h3>
        <p>Od wizytówki dla jednoosobowej działalności po rozbudowany serwis z katalogiem usług. Indywidualny projekt, nie szablon podmieniony kolorystycznie.</p>
      </div>
      <div class="loc-card">
        <h3>Sklepy internetowe</h3>
        <p>WooCommerce albo rozwiązanie pisane od zera, jeśli macie nietypowe procesy. Integracje z płatnościami, kurierami i systemami magazynowymi.</p>
      </div>
      <div class="loc-card">
        <h3>SEO lokalne</h3>
        <p>Konfiguracja pod wyszukiwania z nazwą miejscowości, dane strukturalne, wizytówka Google, strategia treści. To ta część, którą pomija większość tanich ofert.</p>
      </div>
      <div class="loc-card">
        <h3>Projekt UX/UI</h3>
        <p>Makiety i prototyp przed napisaniem pierwszej linijki kodu. Wiecie, jak strona będzie wyglądać, zanim zaczniemy ją budować.</p>
      </div>
      <div class="loc-card">
        <h3>Przyspieszanie stron</h3>
        <p>Macie stronę, ale ładuje się wieczność i przez to traci klientów oraz pozycje w Google? Robimy audyt i optymalizację bez przepisywania całości.</p>
      </div>
      <div class="loc-card">
        <h3>Opieka po wdrożeniu</h3>
        <p>Aktualizacje, kopie zapasowe, monitoring i drobne zmiany. Możecie mieć stronę pod opieką albo obsługiwać ją samodzielnie — jak wolicie.</p>
      </div>
    </div>
  </div>
</section>

<!-- JAK PRACUJEMY -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Jak wygląda <span class="grad-v">współpraca</span></h2>
    <ul class="loc-list">
      <li><strong>Rozmowa.</strong> Telefon, spotkanie w Skawinie albo u nas w Izdebniku. Pytamy o branżę, konkurencję i o to, skąd dziś przychodzą klienci. Bez tego nie da się zaprojektować niczego sensownego.</li>
      <li><strong>Wycena.</strong> Konkretna kwota i zakres na piśmie. Cena jest wiążąca — nie dokładamy faktur za „prace dodatkowe".</li>
      <li><strong>Projekt graficzny.</strong> Makiety wersji desktop i mobilnej. Dwie rundy poprawek w cenie, akceptacja przed kodowaniem.</li>
      <li><strong>Kodowanie.</strong> Strona pisana pod szybkość — celujemy w wynik powyżej 90 w PageSpeed na telefonie, nie w „jakoś działa".</li>
      <li><strong>SEO i wdrożenie.</strong> Dane strukturalne, mapa witryny, Search Console, Analytics, certyfikat SSL. Domena rejestrowana na Was, dostępy przekazane w komplecie.</li>
      <li><strong>Po starcie.</strong> Gwarancja na błędy techniczne i ustalona z góry stawka za późniejsze zmiany, żebyście wiedzieli, na czym stoicie.</li>
    </ul>
  </div>
</section>

<!-- OBSZAR -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Gdzie <span class="grad">pracujemy</span></h2>
    <p class="loc-p">
      Biuro mamy w Izdebniku w gminie Lanckorona — do Skawiny jest stąd kilkanaście minut.
      Obsługujemy całą gminę Skawina i sąsiednie miejscowości:
    </p>
    <p class="loc-villages">
      Skawina · Radziszów · Wola Radziszowska · Rzozów · Jaśkowice · Kopanka · Borek Szlachecki ·
      Krzęcin · Facimiech · Polanka Hallera · Zelczyna · Wielkie Drogi · Ochodza · Grabie ·
      Jurczyce · Krzywaczka · Brzeźnica · Kalwaria Zebrzydowska · Lanckorona · Izdebnik
    </p>
    <p class="loc-p" style="margin-top:24px">
      Działamy też zdalnie w całej Polsce, ale przy firmach z okolicy możliwość spotkania
      na miejscu realnie zmienia jakość projektu — łatwiej zrozumieć biznes,
      gdy się go zobaczy, a nie tylko o nim usłyszy.
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner" style="text-align:center">
    <h2 class="display-md loc-h2">Zróbmy stronę,<br>która <span class="grad">przynosi zapytania</span></h2>
    <p class="loc-p" style="margin:0 auto 32px">
      Napisz albo zadzwoń — pierwsza rozmowa jest bezpłatna i niezobowiązująca.
      Powiemy wprost, czego Wasza firma potrzebuje, a czego nie warto kupować.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="loc-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/realizacje" style="color:#c4b5fd">nasze realizacje</a> ·
      <a href="/blog/ile-kosztuje-strona-internetowa-malopolska" style="color:#c4b5fd">ile kosztuje strona w Małopolsce</a> ·
      <a href="/tworzenie-stron-internetowych-sulkowice" style="color:#c4b5fd">Sułkowice</a> ·
      <a href="/tworzenie-stron-internetowych-myslenice" style="color:#c4b5fd">Myślenice</a> ·
      <a href="/tworzenie-stron-internetowych-wadowice" style="color:#c4b5fd">Wadowice</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
