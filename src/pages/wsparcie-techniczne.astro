---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  { q: 'Ile kosztuje opieka nad stroną?', a: 'Opieka techniczna to 350 zł miesięcznie — aktualizacje, kopie zapasowe, monitoring dostępności i drobne zmiany w treści. Przy stronach pisanych bez CMS-a (Astro, Next.js) opieka bywa niepotrzebna, bo nie ma wtyczek do aktualizowania — wtedy mówimy o tym wprost i płacicie tylko za realne zmiany.' },
  { q: 'Co jeszcze można dobrać do projektu?', a: addonsAnswer() },
  { q: 'Opiekujecie się stronami, których nie robiliście?', a: 'Tak, ale zaczynamy od audytu. Musimy wiedzieć, co przejmujemy — na czym strona stoi, jakie ma zaległości w aktualizacjach i czy nie ma już otwartych luk bezpieczeństwa. Bez tego przejęcie opieki oznaczałoby wzięcie odpowiedzialności za coś, czego nie znamy.' },
  { q: 'Co dokładnie robicie w ramach abonamentu?', a: 'Aktualizacje WordPressa, motywu i wtyczek — po sprawdzeniu na kopii, nie na żywej stronie. Cotygodniowe kopie zapasowe przechowywane poza serwerem. Monitoring dostępności, który powiadamia nas, gdy strona przestaje odpowiadać. Podstawowe zabezpieczenia i przegląd logów. Plus godzina miesięcznie na drobne zmiany w treści.' },
  { q: 'Co, jeśli strona padnie?', a: 'Monitoring wykrywa awarię zwykle szybciej, niż zauważycie ją Wy. Przy typowych problemach — nieudana aktualizacja, konflikt wtyczek, zapełniony serwer — przywracamy działanie z kopii zapasowej. Odpowiadamy w dni robocze; jeśli potrzebujecie gwarancji reakcji także w weekendy, ustalamy to osobno.' },
  { q: 'Czy mogę zrezygnować w dowolnym momencie?', a: 'Tak, opieka jest miesięczna i bez okresu wypowiedzenia. Nie trzymamy klientów umową — jeśli usługa przestaje mieć sens, lepiej żebyście to powiedzieli, niż płacili za coś, czego nie potrzebujecie.' },
  { q: 'Czy dostanę raport z tego, co zrobiliście?', a: 'Tak, comiesięczne podsumowanie: co zaktualizowano, czy były awarie, ile kopii wykonano i co zmieniliśmy na Waszą prośbę. Bez tego opieka techniczna to abonament, za który płacicie w ciemno.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Opieka techniczna nad stroną internetową',
  name: 'Wsparcie techniczne i opieka nad stroną',
  description: 'Aktualizacje, kopie zapasowe, monitoring dostepnosci, bezpieczenstwo i drobne zmiany w tresci.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'województwo małopolskie' },
  url: 'https://ctrlzstudio.pl/wsparcie-techniczne',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Wsparcie techniczne', item: 'https://ctrlzstudio.pl/wsparcie-techniczne' },
  ],
};
---

<Layout
  title="Wsparcie techniczne i opieka nad stroną | CtrlZ Studio"
  description="Aktualizacje, kopie zapasowe, monitoring i bezpieczeństwo Twojej strony. Opieka techniczna od 350 zł miesięcznie, bez umowy na czas określony."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.26); color: #86efac;
  }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.8); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .srv-card:hover { border-color: rgba(34,197,94,.26); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.44); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 780px; margin-top: 32px; }
  .srv-step {
    display: flex; gap: 22px; align-items: flex-start;
    padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07);
  }
  .srv-step-n {
    font-family: var(--font-display); font-size: 26px; font-weight: 800;
    color: #86efac; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85;
  }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.45); line-height: 1.7; margin: 0; }
  .srv-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .srv-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .srv-list li::before { content: '→'; position: absolute; left: 0; color: #86efac; font-size: 14px; }
  .srv-list strong { color: rgba(255,255,255,.8); font-weight: 500; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid { grid-template-columns: 1fr; }
    .srv-hero { padding: 120px 0 48px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-2"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Usługa</div>
    <h1 class="display-xl" style="margin-bottom:20px">Wsparcie<br><span class="grad-v">techniczne</span></h1>
    <p class="srv-lead">Strona to nie mebel — <strong>raz postawiona nie stoi sama przez pięć lat</strong>. Aktualizacje, kopie zapasowe, monitoring i bezpieczeństwo. Zajmujemy się tym, żebyście nie musieli o tym myśleć.</p>
    <div class="srv-chips"><span class="srv-chip">Aktualizacje</span>
      <span class="srv-chip">Kopie zapasowe</span>
      <span class="srv-chip">Monitoring 24/7</span>
      <span class="srv-chip">350 zł / mies.</span></div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Zaniedbana strona<br>psuje się <span class="grad">po cichu</span></h2>
    <p class="srv-p">
      Awaria rzadko wygląda jak awaria. Częściej jest tak: wtyczka nie była aktualizowana przez rok,
      ktoś wykorzystał znaną lukę i wstawił do serwisu ukryte linki. Strona działa,
      wygląda normalnie, a Google powoli obniża jej pozycje. <strong>Dowiadujecie się po pół roku,
      kiedy przestaje dzwonić telefon.</strong>
    </p>
    <p class="srv-p">
      Drugi scenariusz jest bardziej brutalny: hosting pada w piątek wieczorem, nikt tego nie zauważa
      do poniedziałku, a kopii zapasowej nie ma, bo „hosting chyba robi backupy".
      Zwykle robi — przez ostatnie 7 dni i nadpisując najstarszą.
    </p>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co robimy<br>w ramach <span class="grad-v">opieki</span></h2>
    <div class="srv-grid">
      <div class="srv-card"><h3>Aktualizacje</h3><p>WordPress, motyw i wtyczki — sprawdzane najpierw na kopii, dopiero potem wgrywane na żywą stronę. Aktualizacja, która psuje układ, to nie jest teoretyczne ryzyko.</p></div>
      <div class="srv-card"><h3>Kopie zapasowe</h3><p>Cotygodniowe, przechowywane poza serwerem strony. Kopia na tym samym serwerze co strona nie jest kopią — ginie razem z nią.</p></div>
      <div class="srv-card"><h3>Monitoring dostępności</h3><p>Sprawdzanie co kilka minut, czy strona odpowiada. Zwykle wiemy o awarii wcześniej niż Wy.</p></div>
      <div class="srv-card"><h3>Bezpieczeństwo</h3><p>Przegląd logów, blokowanie prób logowania, aktualne certyfikaty, kontrola uprawnień. Podstawy, których brak kosztuje najwięcej.</p></div>
      <div class="srv-card"><h3>Drobne zmiany</h3><p>Godzina miesięcznie na poprawki w treści, wymianę zdjęć, dodanie aktualności. Bez wystawiania faktury za każdą literówkę.</p></div>
      <div class="srv-card"><h3>Raport miesięczny</h3><p>Co zaktualizowano, czy były awarie, ile kopii wykonano, co zmieniono. Żebyście wiedzieli, za co płacicie.</p></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Kiedy opieka <span class="grad">nie jest potrzebna</span></h2>
    <p class="srv-p">
      Mówimy o tym wprost, bo to najczęstsza rzecz, za którą klienci płacą niepotrzebnie.
    </p>
    <ul class="srv-list">
      <li><strong>Strona pisana bez CMS-a</strong> — w Astro albo Next.js nie ma wtyczek do aktualizowania i praktycznie nie ma czego zhakować. Wtedy zamiast abonamentu płacicie tylko za realne zmiany.</li>
      <li><strong>Prosta wizytówka, którą sami ogarniacie</strong> — jeśli macie kogoś, kto klika aktualizacje i pilnuje kopii, opieka jest dublowaniem pracy.</li>
      <li><strong>Strona, która i tak idzie do przebudowy</strong> — nie ma sensu utrzymywać czegoś, co za trzy miesiące zniknie.</li>
    </ul>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Przejmiemy opiekę<br>nad <span class="grad-v">Waszą stroną</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">Zaczynamy od audytu — sprawdzimy, w jakim stanie jest strona i czy opieka w ogóle jest Wam potrzebna. Czasem odpowiedź brzmi „nie" i tak też ją powiemy.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">Zobacz też: <a href="/usuwanie-wirusow-wordpress" style="color:#c4b5fd">usuwanie wirusów WordPress</a> · <a href="/audyt-strony" style="color:#c4b5fd">audyt strony</a> · <a href="/strony-internetowe" style="color:#c4b5fd">strony internetowe</a> · <a href="/uslugi" style="color:#c4b5fd">wszystkie usługi</a></p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
