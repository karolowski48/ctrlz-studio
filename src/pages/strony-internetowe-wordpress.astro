---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { PRICING, priceAnswer } from '../data/pricing';
import { hostingPierwszyRok, hostingOdnowienie } from '../data/hosting';

/**
 * WORDPRESS — frazy „tworzenie stron internetowych wordpress" (210/mies.)
 * i „strona internetowa wordpress cena" (70/mies.).
 * ══════════════════════════════════════════════════════════════════════
 * Uwaga na kanibalizację z /strony-internetowe (ogólna usługa) i z wpisem
 * /blog/wordpress-vs-custom (porównanie technologii). Ta strona celuje wyłącznie
 * w osoby, które już wiedzą, że chcą WordPressa, i szukają wykonawcy albo ceny.
 */

const zl = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} zł`;

const forWho = [
  { t: 'Chcecie sami edytować treści', d: 'Aktualności, oferta, cennik, realizacje — zmieniane co tydzień albo co miesiąc bez dzwonienia do wykonawcy. To jest główny powód, dla którego WordPress nadal wygrywa.' },
  { t: 'Planujecie bloga', d: 'Publikowanie artykułów, kategorie, tagi, planowanie wpisów na przyszłość. WordPress powstał do tego i nadal robi to najwygodniej.' },
  { t: 'Potrzebujecie sklepu w tej samej stronie', d: 'WooCommerce jest wtyczką do WordPressa, więc sklep i treści działają w jednym panelu, na jednej domenie i pod jednym systemem.' },
  { t: 'Chcecie mieć wybór wykonawców', d: 'WordPress obsługuje w Polsce więcej firm niż jakąkolwiek inną technologię. Jeśli kiedyś zmienicie wykonawcę, znajdziecie następcę bez problemu.' },
  { t: 'Zależy Wam na krótszym wdrożeniu', d: 'Dojrzały ekosystem oznacza, że sporo rzeczy jest już zbudowanych. Przy typowej stronie firmowej skraca to projekt o tygodnie.' },
  { t: 'Budżet jest ograniczony', d: 'WordPress jest tańszy we wdrożeniu od strony pisanej od zera. Dopłacacie za to w utrzymaniu, ale rozłożonym na miesiące.' },
];

const how = [
  { t: 'Motyw pisany pod projekt', d: 'Nie kupujemy gotowych szablonów z marketplace. Motyw powstaje pod Wasz projekt graficzny, więc nie ciągnie kodu obsługującego pięćdziesiąt układów, z których używacie jednego.' },
  { t: 'Bez page builderów', d: 'Popularne kreatory typu „przeciągnij i upuść" są wygodne przy budowaniu, a potem ładują megabajty kodu przy każdym wejściu. To najczęstsza przyczyna wyniku poniżej 40 punktów na telefonie.' },
  { t: 'Minimum wtyczek', d: 'Każda wtyczka to kod do pobrania, aktualizacja do pilnowania i potencjalna luka bezpieczeństwa. Instalujemy tylko te, bez których się nie da.' },
  { t: 'Panel uporządkowany pod Was', d: 'Pola do edycji opisane po ludzku, ukryte wszystko, czego nie używacie. Panel, w którym da się pracować bez szkolenia za każdym razem.' },
  { t: 'Optymalizacja od startu', d: 'Zdjęcia konwertowane do WebP w kilku rozmiarach, cache, ograniczenie skryptów. Celujemy w wynik powyżej 90 na telefonie — także na WordPressie.' },
  { t: 'Konfiguracja SEO', d: 'Tytuły i opisy każdej podstrony, dane strukturalne, mapa witryny, Search Console, Analytics z Consent Mode v2. Wszystko gotowe w dniu startu.' },
];

const faq = [
  { q: 'Ile kosztuje strona internetowa na WordPressie?', a: priceAnswer() },
  { q: 'Czy WordPress jest wolny?', a: 'Sam WordPress nie. Wolne są strony zbudowane na gotowym szablonie z page builderem i dwudziestoma wtyczkami — a takich jest większość, stąd opinia. WordPress z motywem pisanym pod projekt i zoptymalizowanymi zdjęciami spokojnie osiąga ponad 90 punktów w PageSpeed na telefonie. Różnica leży w wykonaniu, nie w samym systemie.' },
  { q: 'Czy WordPress jest bezpieczny?', a: 'Jest bezpieczny dokładnie tak długo, jak długo jest aktualizowany. Ponieważ napędza ogromną część internetu, jest też najczęstszym celem automatów skanujących znane podatności. Nieaktualizowany przez rok to kwestia czasu, nie ryzyka. Dlatego przy WordPressie opieka techniczna nie jest dodatkiem, tylko częścią kosztu utrzymania.' },
  { q: 'Ile kosztuje utrzymanie strony na WordPressie?', a: `Domena około 60–120 zł rocznie, hosting ${hostingPierwszyRok()} w pierwszym roku i ${hostingOdnowienie()} przy odnowieniu, do tego opieka techniczna — u nas ${zl(PRICING.addons.maintenanceMonthly)} miesięcznie. Razem, po pierwszym roku, zwykle około 4 700 zł rocznie. Opiekę możecie prowadzić sami, jeśli macie kogoś, kto tego dopilnuje.` },
  { q: 'WordPress czy strona pisana od zera?', a: `WordPress ma sens, gdy chcecie często samodzielnie edytować treści i prowadzić bloga. Strona pisana w Astro albo Next.js jest wyraźnie szybsza, bezpieczniejsza i tańsza w utrzymaniu — nie ma wtyczek do aktualizowania i nie ma czego zhakować — ale to ${PRICING.techSurcharge} do wyceny i mniejsza wygoda przy codziennej edycji. Decydujemy po rozmowie o tym, jak realnie będziecie strony używać.` },
  { q: 'Czy przeniesiecie moją obecną stronę na WordPressa?', a: 'Tak. Najważniejszą częścią takiej migracji nie jest przeniesienie treści, tylko mapowanie starych adresów na nowe przekierowaniami 301. Bez tego tracicie pozycje w Google budowane latami — i to jest najczęstsza przyczyna spadku ruchu po zmianie strony.' },
  { q: 'Czy dostanę szkolenie z obsługi?', a: `Tak. Krótkie szkolenie z panelu jest w cenie każdego projektu z CMS-em, a rozszerzoną wersję z nagraniem i instrukcją wyceniamy na ${zl(PRICING.addons.cmsTraining)}. W praktyce po godzinie większość osób radzi sobie z edycją treści samodzielnie.` },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych WordPress',
  name: 'Strony internetowe na WordPressie',
  description: 'Tworzenie stron internetowych na WordPressie — motyw pisany pod projekt, bez page builderów, z konfiguracją SEO i optymalizacją szybkości.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'Country', name: 'Polska' },
  url: 'https://ctrlzstudio.pl/strony-internetowe-wordpress',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Strony internetowe', item: 'https://ctrlzstudio.pl/strony-internetowe' },
    { '@type': 'ListItem', position: 3, name: 'WordPress', item: 'https://ctrlzstudio.pl/strony-internetowe-wordpress' },
  ],
};
---

<Layout
  title="Tworzenie stron internetowych WordPress — cena | CtrlZ Studio"
  description="Strony na WordPressie z motywem pisanym pod projekt, bez page builderów. Wynik PageSpeed 90+, konfiguracja SEO i panel, w którym da się pracować. Od 2 000 zł."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-crumbs { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 18px; }
  .srv-crumbs a { color: rgba(255,255,255,.68); text-decoration: none; }
  .srv-crumbs a:hover { color: #c4b5fd; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.64); line-height: 1.75; max-width: 740px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.84); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip { font-size: 12px; padding: 7px 16px; border-radius: 100px; background: rgba(124,107,255,.1); border: 1px solid rgba(124,107,255,.26); color: #c4b5fd; }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.64); line-height: 1.8; max-width: 780px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07); border-radius: 16px; padding: 26px; transition: border-color .25s, transform .25s; }
  .srv-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .wp-compare { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 36px; max-width: 900px; }
  .wp-col { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.08); border-radius: 18px; padding: 28px; }
  .wp-col.accent { border-color: rgba(124,107,255,.35); background: linear-gradient(160deg, rgba(124,107,255,.08), rgba(255,255,255,.02)); }
  .wp-col h3 { font-family: var(--font-display); font-size: 18px; color: #fff; margin: 0 0 16px; font-weight: 600; }
  .wp-col ul { list-style: none; padding: 0; margin: 0; }
  .wp-col li { font-size: 14px; color: rgba(255,255,255,.7); line-height: 1.6; padding-left: 20px; position: relative; margin-bottom: 11px; }
  .wp-col li::before { content: '→'; position: absolute; left: 0; color: #c4b5fd; font-size: 12px; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid, .wp-compare { grid-template-columns: 1fr; }
    .srv-hero { padding: 120px 0 48px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="srv-crumbs"><a href="/">Strona główna</a> · <a href="/strony-internetowe">Strony internetowe</a> · WordPress</div>
    <div class="eyebrow" style="margin-bottom:18px">Usługa</div>
    <h1 class="display-xl" style="margin-bottom:20px">Strony internetowe<br>na <span class="grad">WordPressie</span></h1>
    <p class="srv-lead">
      Motyw pisany pod Wasz projekt, <strong>bez page builderów i bez dwudziestu wtyczek</strong>.
      Panel, w którym da się pracować, i wynik powyżej 90 punktów na telefonie — bo WordPress
      nie musi być wolny.
    </p>
    <div class="srv-chips">
      <span class="srv-chip">Motyw pod projekt</span>
      <span class="srv-chip">PageSpeed 90+</span>
      <span class="srv-chip">Samodzielna edycja</span>
      <span class="srv-chip">Od {zl(PRICING.landing)}</span>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Kiedy WordPress<br>jest <span class="grad-v">dobrym wyborem</span></h2>
    <p class="srv-p">
      Nie zawsze jest — i mówimy to wprost. Ale w tych sześciu sytuacjach trudno o lepsze rozwiązanie.
    </p>
    <div class="srv-grid">
      {forWho.map((f) => (
        <div class="srv-card"><h3>{f.t}</h3><p>{f.d}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Dlaczego WordPress<br>ma opinię <span class="grad">wolnego</span></h2>
    <p class="srv-p">
      Bo większość stron na nim zbudowanych faktycznie jest wolna — tylko winny nie jest sam system.
      <strong>Winne jest to, jak się go używa.</strong>
    </p>

    <div class="wp-compare">
      <div class="wp-col">
        <h3>Typowa strona na WordPressie</h3>
        <ul>
          <li>Gotowy szablon obsługujący pięćdziesiąt układów</li>
          <li>Page builder ładujący megabajty kodu</li>
          <li>Kilkanaście wtyczek, z których połowa nieużywana</li>
          <li>Zdjęcia wrzucone w oryginalnym rozmiarze</li>
          <li>Wynik na telefonie: często poniżej 40</li>
        </ul>
      </div>
      <div class="wp-col accent">
        <h3>Nasze podejście</h3>
        <ul>
          <li>Motyw pisany wyłącznie pod Wasz projekt</li>
          <li>Zero page builderów, czysty kod szablonu</li>
          <li>Tylko te wtyczki, bez których się nie da</li>
          <li>Zdjęcia w WebP, w kilku rozmiarach, doczytywane</li>
          <li>Wynik na telefonie: powyżej 90</li>
        </ul>
      </div>
    </div>

    <p class="srv-p" style="margin-top:30px">
      Różnicę widać nie tylko w punktach. Wolna strona traci klientów, zanim zobaczą ofertę,
      i traci pozycje w Google, bo szybkość jest czynnikiem rankingowym.
    </p>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Jak budujemy<br><span class="grad-v">strony na WordPressie</span></h2>
    <div class="srv-grid">
      {how.map((h) => (
        <div class="srv-card"><h3>{h.t}</h3><p>{h.d}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Zróbmy stronę,<br>którą <span class="grad">poprowadzicie sami</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">
      Opiszcie, co ma robić strona i jak często chcecie ją zmieniać. Powiemy, czy WordPress ma u Was sens —
      także wtedy, gdy odpowiedź brzmi „lepsze będzie coś innego".
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Poproś o wycenę</span></a>
      <a href="/ile-kosztuje-strona-internetowa" class="btn-ghost"><span>Zobacz cennik</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/usuwanie-wirusow-wordpress" style="color:#c4b5fd">usuwanie wirusów</a> · <a href="/strony-internetowe-astro-nextjs" style="color:#c4b5fd">Astro i Next.js</a> · <a href="/hosting-dla-strony-internetowej" style="color:#c4b5fd">hosting pod WordPressa</a> · <a href="/strony-internetowe" style="color:#c4b5fd">strony internetowe</a> ·
      <a href="/sklepy-internetowe" style="color:#c4b5fd">sklepy internetowe</a> ·
      <a href="/wsparcie-techniczne" style="color:#c4b5fd">opieka nad WordPressem</a> ·
      <a href="/blog/wordpress-vs-custom" style="color:#c4b5fd">WordPress czy strona pisana od zera</a> ·
      <a href="/realizacje/twierdze-od-nowa" style="color:#c4b5fd">dedykowany motyw dla ZBK Kraków</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
