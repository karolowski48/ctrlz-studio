---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  {
    q: 'Ile kosztuje strona internetowa dla firmy z Andrychowa?',
    a: priceAnswer('Andrychowa'),
  },
  {
    q: 'Co jeszcze można dobrać do projektu?',
    a: addonsAnswer(),
  },
  {
    q: 'Produkujemy i sprzedajemy do innych firm. Czy strona nam się przyda?',
    a: 'W B2B strona rzadko sprzedaje bezpośrednio — ale prawie zawsze decyduje, czy zapytanie w ogóle wyjdzie. Kupiec, który dostał Waszą ofertę, sprawdzi firmę w internecie przed odpowiedzią. Jeśli znajdzie stronę z parkiem maszynowym, certyfikatami i realizacjami, rozmowa zaczyna się z zupełnie innego poziomu. Jeśli nie znajdzie nic, Wasza oferta ląduje niżej na liście.',
  },
  {
    q: 'Potrzebujemy strony po angielsku i niemiecku — robicie takie?',
    a: 'Tak i przy firmach produkcyjnych z Andrychowa to częsty wymóg. Robimy to poprawnie technicznie: osobne adresy dla każdej wersji językowej i znaczniki hreflang, żeby Google nie traktował ich jako duplikatów. Tłumaczenie techniczne zwykle zlecacie Wy albo my organizujemy je z tłumaczem branżowym.',
  },
  {
    q: 'Jak daleko macie do Andrychowa?',
    a: 'Studio mamy w Izdebniku koło Kalwarii Zebrzydowskiej — do Andrychowa jest stąd około pół godziny. Na spotkanie podjedziemy bez problemu, także do Kęt, Wieprza czy Zatora.',
  },
  {
    q: 'Mamy stronę sprzed lat. Odświeżyć czy robić od nowa?',
    a: 'Zaczynamy od audytu, bo odpowiedź zależy od tego, co siedzi pod spodem. Jeśli strona ma sensowną strukturę i tylko zestarzał się wygląd, odświeżenie bywa o połowę tańsze. Jeśli jest zbudowana na przestarzałym systemie, nie działa na telefonie i ma poważne braki techniczne, łatanie kosztuje więcej niż napisanie od nowa. Powiemy wprost, co się bardziej opłaca — nawet gdy to oznacza mniejsze zlecenie dla nas.',
  },
  {
    q: 'Na kogo będzie zarejestrowana domena?',
    a: 'Na Waszą firmę. Dostępy do hostingu i panelu przekazujemy w komplecie po wdrożeniu — możecie w każdej chwili przenieść stronę gdzie indziej.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: {
    '@type': 'City',
    name: 'Andrychów',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'powiat wadowicki, województwo małopolskie' },
  },
  url: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-andrychow',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Tworzenie stron internetowych — Andrychów', item: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-andrychow' },
  ],
};
---

<Layout
  title="Tworzenie stron internetowych Andrychów | CtrlZ Studio"
  description="Strony internetowe dla firm z Andrychowa, Kęt, Wieprza i Zatora. Strony firmowe, B2B, wersje obcojęzyczne i SEO lokalne. Studio z powiatu wadowickiego."
>
<SharedNav />

<main id="main-content">

<style>
  .loc-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .loc-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .loc-h1 { margin-bottom: 20px; }
  .loc-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .loc-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }

  .loc-quick { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .loc-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(56,189,248,.1); border: 1px solid rgba(56,189,248,.26);
    color: #7dd3fc;
  }

  .loc-section { padding: 72px 0; background: var(--bg-base); }
  .loc-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .loc-h2 { margin-bottom: 18px; }
  .loc-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .loc-p strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .loc-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .loc-card:hover { border-color: rgba(56,189,248,.28); transform: translateY(-2px); }
  .loc-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .loc-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }

  .loc-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .loc-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .loc-list li::before { content: '→'; position: absolute; left: 0; color: #38bdf8; font-size: 14px; }
  .loc-list strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-villages { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.9; max-width: 820px; margin-top: 18px; }

  @media (max-width: 1024px) { .loc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .loc-inner { padding: 0 24px; }
    .loc-grid { grid-template-columns: 1fr; }
    .loc-hero { padding: 120px 0 48px; }
  }
</style>

<!-- HERO -->
<section class="loc-hero">
  <div class="orb orb-3"></div>
  <div class="grid-bg"></div>
  <div class="loc-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Andrychów, Kęty, Wieprz, Zator</div>
    <h1 class="display-xl loc-h1">
      Tworzenie stron<br>
      internetowych<br>
      <span class="grad">Andrychów</span>
    </h1>
    <p class="loc-lead">
      Robimy strony WWW dla firm z Andrychowa, Kęt, Wieprza i Zatora —
      od wizytówek dla usługowców po rozbudowane serwisy B2B z wersjami obcojęzycznymi.
      <strong>Jesteśmy z tego samego powiatu, z Izdebnika koło Kalwarii.</strong>
    </p>
    <div class="loc-quick">
      <span class="loc-chip">Strony B2B i produkcja</span>
      <span class="loc-chip">Wersje obcojęzyczne</span>
      <span class="loc-chip">Sklepy internetowe</span>
      <span class="loc-chip">SEO lokalne</span>
    </div>
  </div>
</section>

<!-- SPECYFIKA -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Andrychów ma<br><span class="grad-v">przemysł</span> — a przemysł<br>ma inne potrzeby</h2>
    <p class="loc-p">
      Andrychów to jeden z niewielu ośrodków w regionie z realną tradycją przemysłową
      i sporą liczbą firm produkcyjnych oraz podwykonawczych. To zmienia zupełnie zadanie,
      jakie stoi przed stroną. <strong>W produkcji i B2B strona nie sprzedaje — ona uwiarygadnia.</strong>
    </p>
    <p class="loc-p">
      Wygląda to tak: wysyłacie ofertę, a osoba po drugiej stronie wpisuje nazwę Waszej firmy
      w Google, zanim odpisze. Jeśli znajdzie stronę z parkiem maszynowym, certyfikatami,
      zdjęciami hali i listą realizacji — traktuje Was jak poważnego dostawcę.
      Jeśli nie znajdzie nic albo znajdzie stronę sprzed dziesięciu lat, która nie otwiera się
      na telefonie, Wasza oferta spada na dół listy. Nie z powodu ceny.
    </p>
    <p class="loc-p">
      Drugi wątek to eksport. Firmy z okolicy sprzedają do Czech, Niemiec i dalej,
      a strona tylko po polsku odcina ten kanał całkowicie. Wersja obcojęzyczna zrobiona
      poprawnie — z osobnymi adresami i hreflangiem, a nie automatycznym tłumaczem —
      bywa najlepiej zwracającą się częścią całego projektu.
    </p>
    <p class="loc-p">
      Obok tego jest zwykły rynek lokalny: usługi dla mieszkańców Andrychowa, Kęt i Wieprza,
      gdzie liczy się wizytówka Google, opinie i szybka strona. Te dwa światy wymagają
      innych stron i to jest pierwsza rzecz, którą ustalamy na rozmowie.
    </p>
  </div>
</section>

<!-- CO ROBIMY -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Co robimy dla firm<br>z <span class="grad">Andrychowa</span></h2>
    <div class="loc-grid">
      <div class="loc-card">
        <h3>Strony B2B i produkcyjne</h3>
        <p>Park maszynowy, możliwości produkcyjne, certyfikaty, realizacje, materiały do pobrania. Zbudowane pod kupca, który weryfikuje dostawcę.</p>
      </div>
      <div class="loc-card">
        <h3>Wersje obcojęzyczne</h3>
        <p>Angielski, niemiecki, czeski. Osobne adresy i hreflang — nie automatyczny tłumacz, który psuje SEO i wygląda nieprofesjonalnie.</p>
      </div>
      <div class="loc-card">
        <h3>Katalogi produktów</h3>
        <p>Filtrowanie po parametrach, karty produktów, pliki techniczne do pobrania, zapytanie ofertowe zamiast koszyka.</p>
      </div>
      <div class="loc-card">
        <h3>Sklepy internetowe</h3>
        <p>WooCommerce albo rozwiązanie pisane od zera, z integracjami do magazynu, kurierów i księgowości.</p>
      </div>
      <div class="loc-card">
        <h3>Strony usługowe</h3>
        <p>Dla firm obsługujących mieszkańców — warsztaty, gabinety, budowlanka. Prosto, szybko i z naciskiem na wyszukiwania lokalne.</p>
      </div>
      <div class="loc-card">
        <h3>Audyt i modernizacja</h3>
        <p>Zanim zaproponujemy nową stronę, sprawdzamy, czy obecnej nie da się naprawić taniej. Czasem wychodzi, że tak.</p>
      </div>
    </div>
  </div>
</section>

<!-- JAK PRACUJEMY -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Jak wygląda <span class="grad-v">współpraca</span></h2>
    <ul class="loc-list">
      <li><strong>Rozmowa.</strong> Ustalamy, czy strona ma pracować na rynek lokalny, na B2B, czy na oba naraz — bo to dwa różne projekty.</li>
      <li><strong>Wycena.</strong> Konkretna kwota i zakres na piśmie, zgodne z <a href="/kalkulator" style="color:#c4b5fd">kalkulatorem</a>. Cena jest wiążąca.</li>
      <li><strong>Projekt graficzny.</strong> Makiety desktop i mobile, dwie rundy poprawek w cenie, akceptacja przed kodowaniem.</li>
      <li><strong>Kodowanie.</strong> Celujemy w wynik powyżej 90 w PageSpeed na telefonie — także dlatego, że wolna strona wygląda w B2B na zaniedbaną firmę.</li>
      <li><strong>SEO i wdrożenie.</strong> Dane strukturalne, mapa witryny, Search Console, Analytics, SSL. Domena rejestrowana na Was.</li>
      <li><strong>Po starcie.</strong> Gwarancja na błędy techniczne i ustalona z góry stawka za późniejsze zmiany.</li>
    </ul>
  </div>
</section>

<!-- OBSZAR -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Gdzie <span class="grad">pracujemy</span></h2>
    <p class="loc-p">
      Studio mamy w Izdebniku koło Kalwarii Zebrzydowskiej — to ten sam powiat wadowicki,
      około pół godziny od Andrychowa. Obsługujemy miasto i okolicę:
    </p>
    <p class="loc-villages">
      Andrychów · Kęty · Wieprz · Zator · Wadowice · Choczni · Inwałd · Roczyny ·
      Sułkowice-Bolęcina · Targanice · Rzyki · Brzezinka · Nidek · Bulowice ·
      Osiek · Polanka Wielka · Przeciszów · Spytkowice
    </p>
    <p class="loc-p" style="margin-top:24px">
      Pracujemy też zdalnie w całej Polsce, ale przy większych projektach
      spotkanie na miejscu — zwłaszcza w hali albo zakładzie — zmienia wszystko.
      Trudno opisać park maszynowy, którego się nie widziało.
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner" style="text-align:center">
    <h2 class="display-md loc-h2">Zróbmy stronę,<br>która <span class="grad">buduje wiarygodność</span></h2>
    <p class="loc-p" style="margin:0 auto 32px">
      Pierwsza rozmowa jest bezpłatna. Powiemy wprost, czego Wasza firma potrzebuje,
      a czego nie warto kupować — nawet jeśli to oznacza mniejsze zlecenie dla nas.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="loc-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/tworzenie-stron-internetowych-wadowice" style="color:#c4b5fd">Wadowice</a> ·
      <a href="/tworzenie-stron-internetowych-kalwaria-zebrzydowska" style="color:#c4b5fd">Kalwaria Zebrzydowska</a> ·
      <a href="/realizacje" style="color:#c4b5fd">nasze realizacje</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
