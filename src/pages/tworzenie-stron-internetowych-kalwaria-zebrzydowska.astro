---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  {
    q: 'Ile kosztuje strona internetowa dla firmy z Kalwarii Zebrzydowskiej?',
    a: priceAnswer('Kalwarii Zebrzydowskiej'),
  },
  {
    q: 'Co jeszcze można dobrać do projektu?',
    a: addonsAnswer(),
  },
  {
    q: 'Robię meble i chciałbym sprzedawać je online. Sklep czy katalog?',
    a: 'Przy meblach na wymiar sklep zwykle nie ma sensu — nikt nie kupuje szafy przez koszyk, bo każda jest inna. Lepiej działa rozbudowany katalog realizacji z formularzem zapytania i możliwością opisania wymiarów. Sklep zaczyna się opłacać przy produktach powtarzalnych, sprzedawanych z półki. Doradzimy po obejrzeniu tego, co robicie.',
  },
  {
    q: 'Czy warto mieć wersję angielską?',
    a: 'Jeśli sprzedajecie meble lub wyroby poza Polskę albo obsługujecie ruch pielgrzymkowy — tak, i to się zwraca. Jeśli klienci są wyłącznie lokalni, to zbędny koszt. Wersja obcojęzyczna to zwykle kilkanaście procent do wyceny i robimy ją poprawnie: osobne adresy plus znaczniki hreflang.',
  },
  {
    q: 'Jak daleko macie do Kalwarii?',
    a: 'Bardzo blisko — nasze studio jest w Izdebniku, w sąsiedniej gminie Lanckorona. To kilka minut drogi. Jesteśmy stąd, znamy okolicę i firmy, które tu działają.',
  },
  {
    q: 'Mam małą firmę, czy strona mi się w ogóle opłaci?',
    a: 'Policzcie tak: ile zostaje Wam z jednego zlecenia i ile takich zleceń musi przyjść, żeby strona za 4–6 tysięcy się zwróciła. Przy marży rzędu 900 zł to siedmiu klientów — jednorazowo, bo potem strona pracuje dalej. Jeśli macie komplet zleceń i nie chcecie rosnąć, uczciwie powiemy, że lepiej podnieść ceny. Rozpisaliśmy to szczegółowo w artykule o firmach z małych miejscowości.',
  },
  {
    q: 'Na kogo będzie zarejestrowana domena?',
    a: 'Na Was. Dostępy do hostingu i panelu przekazujemy w komplecie po wdrożeniu — strona jest Waszą własnością i możecie ją w każdej chwili przenieść gdzie indziej.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: {
    '@type': 'City',
    name: 'Kalwaria Zebrzydowska',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'powiat wadowicki, województwo małopolskie' },
  },
  url: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-kalwaria-zebrzydowska',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Tworzenie stron internetowych — Kalwaria Zebrzydowska', item: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-kalwaria-zebrzydowska' },
  ],
};
---

<Layout
  title="Strony internetowe Kalwaria Zebrzydowska | CtrlZ Studio"
  description="Strony internetowe dla firm z Kalwarii Zebrzydowskiej, Lanckorony, Izdebnika, Brodów i Stanisława Dolnego. Projektowanie, kodowanie i SEO lokalne."
>
<SharedNav />

<main id="main-content">

<style>
  .loc-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .loc-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .loc-h1 { margin-bottom: 20px; }
  .loc-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .loc-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }

  .loc-quick { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .loc-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(245,158,11,.1); border: 1px solid rgba(245,158,11,.26);
    color: #fcd34d;
  }

  .loc-section { padding: 72px 0; background: var(--bg-base); }
  .loc-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .loc-h2 { margin-bottom: 18px; }
  .loc-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .loc-p strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .loc-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .loc-card:hover { border-color: rgba(245,158,11,.28); transform: translateY(-2px); }
  .loc-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .loc-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }

  .loc-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .loc-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .loc-list li::before { content: '→'; position: absolute; left: 0; color: #f59e0b; font-size: 14px; }
  .loc-list strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-villages { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.9; max-width: 820px; margin-top: 18px; }

  @media (max-width: 1024px) { .loc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .loc-inner { padding: 0 24px; }
    .loc-grid { grid-template-columns: 1fr; }
    .loc-hero { padding: 120px 0 48px; }
  }
</style>

<!-- HERO -->
<section class="loc-hero">
  <div class="orb orb-2"></div>
  <div class="grid-bg"></div>
  <div class="loc-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Kalwaria Zebrzydowska i okolica</div>
    <h1 class="display-xl loc-h1">
      Tworzenie stron<br>
      internetowych<br>
      <span class="grad">Kalwaria</span>
    </h1>
    <p class="loc-lead">
      Projektujemy i kodujemy strony WWW dla firm z Kalwarii Zebrzydowskiej, Lanckorony,
      Brodów, Barwałdu i Stanisława Dolnego. <strong>Nasze studio jest w Izdebniku —
      w sąsiedniej gminie, kilka minut stąd.</strong> Nie jesteśmy agencją z miasta,
      która wpisała Waszą miejscowość w wyszukiwarkę. Jesteśmy stąd.
    </p>
    <div class="loc-quick">
      <span class="loc-chip">Meblarstwo i stolarstwo</span>
      <span class="loc-chip">Strony firmowe</span>
      <span class="loc-chip">Turystyka</span>
      <span class="loc-chip">SEO lokalne</span>
    </div>
  </div>
</section>

<!-- SPECYFIKA -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Meble i pielgrzymi —<br>dwa <span class="grad-v">osobne rynki</span></h2>
    <p class="loc-p">
      Kalwaria to przede wszystkim meblarstwo. Setki zakładów, warsztatów i firm rodzinnych,
      z których zdecydowana większość sprzedaje przez hurtowników, targi i polecenia.
      <strong>To model, który działał przez dekady i który powoli przestaje wystarczać</strong> —
      bo klient końcowy szukający mebli na wymiar zaczyna dziś od Google, a nie od objazdu warsztatów.
    </p>
    <p class="loc-p">
      Firma meblarska z porządną stroną i galerią realizacji może sprzedawać bezpośrednio,
      z pominięciem pośrednika — a to jest różnica nie w liczbie zleceń, tylko w marży.
      Widzimy to u klientów: ten sam produkt, wyższa cena, bo klient kupuje od wytwórcy,
      którego zna z nazwy, a nie anonimowy mebel z hurtowni.
    </p>
    <p class="loc-p">
      Drugi rynek to ruch pielgrzymkowy i turystyczny wokół sanktuarium. Noclegi,
      gastronomia, pamiątki, usługi. Tu obowiązuje odwrotna logika niż w meblarstwie:
      klient jest przejezdny, nikt go nie poleci, a decyzję podejmuje w pięć minut
      na podstawie tego, co znajdzie w telefonie. Bez wizytówki Google i szybkiej strony
      po prostu Was nie zobaczy.
    </p>
  </div>
</section>

<!-- CO ROBIMY -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Co robimy dla firm<br>z <span class="grad">Kalwarii</span></h2>
    <div class="loc-grid">
      <div class="loc-card">
        <h3>Strony dla meblarstwa</h3>
        <p>Galeria realizacji jako serce strony, formularz zapytania z wymiarami, opis procesu produkcji. Zdjęcia ładowane tak, żeby nie zabijały szybkości.</p>
      </div>
      <div class="loc-card">
        <h3>Noclegi i gastronomia</h3>
        <p>Menu, galeria, godziny, mapa, kontakt jednym kliknięciem. Projektowane pod telefon, bo stamtąd przychodzi ruch przejezdny.</p>
      </div>
      <div class="loc-card">
        <h3>Strony firmowe</h3>
        <p>Od wizytówki po serwis z katalogiem usług i blogiem. Indywidualny projekt pod Waszą markę, nie szablon.</p>
      </div>
      <div class="loc-card">
        <h3>Wersje obcojęzyczne</h3>
        <p>Angielska, niemiecka, włoska. Osobne adresy i hreflang, żeby Google pokazywał właściwą wersję właściwemu odbiorcy.</p>
      </div>
      <div class="loc-card">
        <h3>Wizytówka Google</h3>
        <p>Zakładamy albo porządkujemy profil, ustawiamy kategorie i obszar działania, pokazujemy, jak zbierać opinie. Dla firm z ruchem przejezdnym to podstawa.</p>
      </div>
      <div class="loc-card">
        <h3>SEO lokalne</h3>
        <p>Dane strukturalne, strategia fraz, podstrony pod usługi i miejscowości. Ta część decyduje, czy ktokolwiek stronę znajdzie.</p>
      </div>
    </div>
  </div>
</section>

<!-- DLACZEGO MY -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Dlaczego <span class="grad-v">akurat my</span></h2>
    <ul class="loc-list">
      <li><strong>Jesteśmy sąsiadami.</strong> Izdebnik leży w gminie Lanckorona, kilka minut od Kalwarii. Możemy podjechać na spotkanie tego samego dnia, obejrzeć warsztat i zobaczyć, co warto pokazać.</li>
      <li><strong>Znamy ten rynek.</strong> Wiemy, jak działa meblarstwo w tej okolicy i czym różni się klient z targów od klienta z internetu. Nie trzeba nam tego tłumaczyć od zera.</li>
      <li><strong>Nie znikamy po wdrożeniu.</strong> W małej okolicy reputacja jest jedynym kapitałem — jedna zawalona współpraca kosztuje więcej niż jedno zlecenie.</li>
      <li><strong>Mówimy wprost.</strong> Jeśli uważamy, że nie potrzebujecie sklepu albo wersji obcojęzycznej, powiemy to, zamiast dopisywać pozycję do faktury.</li>
      <li><strong>Domena i dostępy są Wasze.</strong> Zawsze, bez wyjątków. Możecie w każdej chwili odejść.</li>
    </ul>
  </div>
</section>

<!-- OBSZAR -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Gdzie <span class="grad">pracujemy</span></h2>
    <p class="loc-p">
      Studio mamy w Izdebniku przy ulicy Dworskiej — to sąsiednia gmina.
      Obsługujemy Kalwarię i całą okolicę:
    </p>
    <p class="loc-villages">
      Kalwaria Zebrzydowska · Lanckorona · Izdebnik · Brody · Barwałd Dolny · Barwałd Górny ·
      Barwałd Średni · Stanisław Dolny · Zebrzydowice · Leńcze · Podchybie · Skawinki ·
      Zarzyce · Przytkowice · Brzeźnica · Wadowice · Sułkowice · Skawina
    </p>
    <p class="loc-p" style="margin-top:24px">
      Na spotkanie podjedziemy do Was — do warsztatu, zakładu albo biura.
      Przy pierwszym projekcie to zwykle najlepszy sposób, żeby zrozumieć, czym się zajmujecie.
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner" style="text-align:center">
    <h2 class="display-md loc-h2">Porozmawiajmy<br>o <span class="grad">Waszej stronie</span></h2>
    <p class="loc-p" style="margin:0 auto 32px">
      Jesteśmy z sąsiedniej gminy — możemy się po prostu spotkać.
      Pierwsza rozmowa nic nie kosztuje i do niczego nie zobowiązuje.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="loc-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/tworzenie-stron-internetowych-wadowice" style="color:#c4b5fd">Wadowice</a> ·
      <a href="/tworzenie-stron-internetowych-andrychow" style="color:#c4b5fd">Andrychów</a> ·
      <a href="/tworzenie-stron-internetowych-sulkowice" style="color:#c4b5fd">Sułkowice</a> ·
      <a href="/blog/strona-internetowa-dla-firmy-z-malej-miejscowosci" style="color:#c4b5fd">czy strona się opłaca</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
