---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { Image } from 'astro:assets';
import { img } from '../data/images';
import { PROJECTS } from '../data/projects';

const projects = PROJECTS;

/* Kategorie filtra. Dopasowanie jest „luźne" — po fragmencie pola `tag`
   realizacji — bo tagi są opisowe („E-commerce B2B · PrestaShop · 2026").
   Liczniki muszą używać DOKŁADNIE tej samej reguły, co skrypt w przeglądarce,
   inaczej licznik obiecywałby inną liczbę kart niż filtr faktycznie pokazuje. */
const CAT_NAMES = [
  'Wszystkie',
  'WordPress',
  'E-commerce',
  'Strona firmowa',
  'Personal Brand',
  'Custom Dev',
  'UI/UX',
  'Astro.js',
];

const matchesCat = (tag: string, cat: string) =>
  cat === 'Wszystkie' || tag.toLowerCase().includes(cat.toLowerCase());

const cats = CAT_NAMES.map((name) => ({
  name,
  count: PROJECTS.filter((p) => matchesCat(p.tag, name)).length,
}))
  /* Kategoria bez ani jednej realizacji nie ma po co istnieć — przycisk,
     który pokazuje pustą listę, wygląda jak zepsuty filtr. Dzięki temu
     lista przycisków utrzymuje się sama, gdy dochodzą nowe realizacje. */
  .filter((c) => c.count > 0);

/* Ile kart widać przed kliknięciem „Pokaż więcej" — 9 = trzy pełne rzędy
   w siatce trzykolumnowej, tak samo jak na blogu. */
const VISIBLE = 9;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Realizacje', item: 'https://ctrlzstudio.pl/realizacje' },
  ],
};
---

<Layout title="Realizacje — CtrlZ Studio" description="Portfolio projektów CtrlZ Studio — strony firmowe, sklepy WooCommerce, landing pages, custom solutions.">

<SharedNav />

<main id="main-content">

<style>
  .port-city {
    font-size: 12px;
    color: rgba(255,255,255,.68);
    margin: -4px 0 8px;
    display: flex;
    align-items: center;
    gap: 5px;
  }
  .port-city::before {
    content: '';
    width: 5px; height: 5px; border-radius: 50%;
    background: #7c6bff;
    flex-shrink: 0;
  }
  .page-hero { padding-top:140px; padding-bottom:64px; text-align:center; position:relative; overflow:hidden; }
  .filter-bar { display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-bottom:52px; }
  .filter-btn { font-size:12px; padding:8px 18px; border-radius:var(--radius-pill); border:1px solid rgba(255,255,255,.1); background:transparent; color:rgba(255,255,255,.68); cursor:none; transition:all var(--transition); font-family:var(--font-body); }
  .filter-btn:hover { color:rgba(255,255,255,.8); border-color:rgba(255,255,255,.25); }
  .filter-btn.active { background:rgba(124,107,255,.18); border-color:rgba(124,107,255,.42); color:#c4b5fd; }
  .projects-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; }
  /* Filtr ZAWĘŻA listę zamiast wygaszać karty — tak samo jak na blogu.
     Wszystkie realizacje są w HTML od pierwszego wczytania, więc Google
     widzi komplet linków niezależnie od tego, co ukrywa przeglądarka. */
  .project-card.is-hidden { display:none; }
  .project-card { border-radius:var(--radius-lg); overflow:hidden; position:relative; height:280px; cursor:none; transition:transform .35s cubic-bezier(.34,1.56,.64,1); text-decoration:none; display:block; }
  .project-card:hover { transform:scale(1.02); }
  .project-card .port-info { position:absolute; bottom:0; left:0; right:0; z-index:2; opacity:1; transform:none; }
  .project-card:hover .port-glow { transform:scale(1.3); }
  .project-card.featured { height:280px; }
  .cta-strip { background:rgba(124,107,255,.07); border:1px solid rgba(124,107,255,.18); border-radius:var(--radius-lg); padding:48px; text-align:center; margin-top:64px; }
  .cta-strip-title { font-family:var(--font-display); font-size:32px; font-weight:700; color:#fff; letter-spacing:-.03em; margin-bottom:12px; }
  .cta-strip-sub { font-size:15px; color:rgba(255,255,255,.62); margin-bottom:28px; }
  @media(max-width:1024px){ .projects-grid{grid-template-columns:repeat(2,1fr);} }
  @media(max-width:640px){ .projects-grid{grid-template-columns:1fr;} .filter-bar{gap:6px;} .filter-btn{font-size:12px;padding:7px 14px;} .cta-strip{padding:32px 20px;} }
</style>

<section class="page-hero" style="background:var(--bg-base);position:relative;overflow:hidden">
  <div class="orb orb-1"></div><div class="orb orb-2"></div>
  <div class="grid-bg"></div>
  <div class="container" style="position:relative">
    <div class="eyebrow" style="justify-content:center;margin-bottom:20px" id="ph-ey">Nasze portfolio</div>
    <h1 class="display-xl" style="text-align:center;margin-bottom:18px" id="ph-title">
      Projekty, z których<br><span class="grad">jesteśmy dumni.</span>
    </h1>
    <p id="ph-sub" style="font-size:16px;color:rgba(255,255,255,.68);text-align:center;max-width:480px;margin:0 auto 48px;font-weight:300;line-height:1.7">
      Każdy projekt to unikalne rozwiązanie — zero szablonów, tylko przemyślany design i precyzyjny kod.
    </p>
    <div class="filter-bar" id="filter-bar">
      {cats.map((c,i) => (
        <button
          type="button"
          class={`filter-btn${i===0?' active':''}`}
          data-cat={c.name}
          aria-pressed={i===0?'true':'false'}
        >{c.name} <span class="blog-tag-count">{c.count}</span></button>
      ))}
    </div>
  </div>
</section>

<section class="section" style="background:var(--bg-base);padding-top:0">
  <div class="container">
    <div class="projects-grid" id="projects-grid">
      {projects.map((p, i) => (
        <a
          href={`/realizacje/${p.slug}`}
          class={`project-card ${p.bg}${p.featured?' featured':''} js-scale${i >= VISIBLE ? ' is-hidden' : ''}`}
          data-delay={String((i % 3) * 0.08)}
          data-cat={p.tag}
        >
          {img(p.img)
            ? <Image
                src={img(p.img)!}
                alt={`${p.name} — realizacja CtrlZ Studio${p.city ? ', ' + p.city : ''}`}
                class="port-bg-img"
                widths={[400, 640, 900]}
                sizes="(max-width: 640px) 92vw, (max-width: 1024px) 46vw, 400px"
                quality={72}
                decoding="async"
                loading={i < 3 ? 'eager' : 'lazy'}
              />
            : <><div class={`port-glow ${p.glow}`}></div>{p.featured && <div class="port-mock"><div class="mock-line"></div><div class="mock-line"></div><div class="mock-line"></div></div>}</>
          }
          <div class="port-info">
            <div class="port-tag">{p.tag}</div>
            <div class="port-name">{p.name}</div>
            {p.city && <div class="port-city">{p.city}</div>}
            <p style="font-size:12px;color:rgba(255,255,255,.68);line-height:1.5;margin-bottom:8px">{p.desc}</p>
            <div class="port-pills">
              <span class="port-pill accent">{p.pill1}</span>
              <span class="port-pill">{p.pill2}</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <p class="blog-empty" id="proj-empty" hidden>
      Brak realizacji w tej kategorii. <button type="button" class="blog-empty-reset" id="proj-reset">Pokaż wszystkie</button>
    </p>

    <div class="blog-more-wrap">
      <button type="button" class="blog-more" id="proj-more">
        Pokaż więcej realizacji <span id="proj-more-count"></span>
      </button>
    </div>

    <div class="cta-strip js-reveal">
      <div class="cta-strip-title">Chcesz dołączyć do grona klientów?</div>
      <p class="cta-strip-sub">Każdy projekt zaczyna się od rozmowy. Pierwsza konsultacja jest bezpłatna.</p>
      <a href="/#kontakt" class="btn-primary"><span>Porozmawiaj o projekcie →</span></a>
    </div>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

</Layout>

<script>
import { initPage } from '../utils/pageInit';
import gsap from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);
initPage();

gsap.fromTo('#ph-ey',   {opacity:0,y:16},{opacity:1,y:0,duration:.7,ease:'power3.out',delay:.2});
gsap.fromTo('#ph-title',{opacity:0,y:28},{opacity:1,y:0,duration:.9,ease:'power3.out',delay:.35});
gsap.fromTo('#ph-sub',  {opacity:0,y:18},{opacity:1,y:0,duration:.7,ease:'power3.out',delay:.5});
gsap.fromTo('#filter-bar',{opacity:0,y:14},{opacity:1,y:0,duration:.6,ease:'power3.out',delay:.65});

document.querySelectorAll<HTMLElement>('.js-scale').forEach(el=>{
  const d=parseFloat(el.dataset.delay||'0');
  gsap.fromTo(el,{opacity:0,scale:.93},{opacity:1,scale:1,duration:.85,ease:'power3.out',delay:d,
    scrollTrigger:{trigger:el,start:'top 92%',toggleActions:'play none none none'}});
});
document.querySelectorAll<HTMLElement>('.js-reveal').forEach(el=>{
  gsap.fromTo(el,{opacity:0,y:28},{opacity:1,y:0,duration:.8,ease:'power3.out',
    scrollTrigger:{trigger:el,start:'top 88%',toggleActions:'play none none none'}});
});

// Tilt on project cards
document.querySelectorAll<HTMLElement>('.project-card').forEach(card=>{
  card.addEventListener('mousemove',(e:MouseEvent)=>{
    const r=card.getBoundingClientRect();
    gsap.to(card,{rotateX:-((e.clientY-r.top)/r.height-.5)*8,rotateY:((e.clientX-r.left)/r.width-.5)*8,
      duration:.4,ease:'power2.out',transformPerspective:1000});
  });
  card.addEventListener('mouseleave',()=>gsap.to(card,{rotateX:0,rotateY:0,duration:.5,ease:'power3.out'}));
});

// ── Filtr kategorii + „Pokaż więcej" ─────────────────────────────
// Identyczna mechanika jak na blogu: filtr ZAWĘŻA listę (karty poza kategorią
// znikają, a nie tylko blakną), a reszta doładowuje się partiami po kliknięciu.
// Wszystkie realizacje są w HTML od razu — to jest doładowywanie po stronie
// przeglądarki, nie zapytanie do serwera, więc nie gubimy linków dla Google.
(function () {
  const VISIBLE = 9;
  const grid     = document.getElementById('projects-grid');
  const moreBtn  = document.getElementById('proj-more') as HTMLButtonElement | null;
  const moreWrap = document.querySelector('.blog-more-wrap') as HTMLElement | null;
  const moreCnt  = document.getElementById('proj-more-count');
  const empty    = document.getElementById('proj-empty') as HTMLElement | null;
  const resetBtn = document.getElementById('proj-reset');
  const filterBtns = Array.from(document.querySelectorAll<HTMLButtonElement>('.filter-btn'));
  const cards      = Array.from(document.querySelectorAll<HTMLElement>('.project-card'));
  if (!grid || !moreBtn || !moreWrap) return;

  let activeCat = 'Wszystkie';
  let shown = VISIBLE;

  // Ta sama reguła dopasowania, której użyliśmy do policzenia liczników w HTML.
  const matching = () =>
    cards.filter((c) =>
      activeCat === 'Wszystkie' ||
      (c.dataset.cat || '').toLowerCase().includes(activeCat.toLowerCase())
    );

  function render(animateFrom = -1) {
    const list = matching();

    cards.forEach((c) => { c.classList.add('is-hidden'); c.style.pointerEvents = 'none'; });
    list.slice(0, shown).forEach((c, i) => {
      c.classList.remove('is-hidden');
      c.style.pointerEvents = 'auto';
      // GSAP mógł zostawić na karcie opacity/scale z animacji wejścia —
      // czyścimy, żeby świeżo odsłonięta karta nie została niewidoczna.
      gsap.set(c, { opacity: 1, scale: 1, clearProps: 'transform' });
      if (animateFrom >= 0 && i >= animateFrom) {
        c.animate(
          [{ opacity: 0, transform: 'translateY(12px)' }, { opacity: 1, transform: 'none' }],
          { duration: 320, easing: 'cubic-bezier(.4,0,.2,1)', delay: (i - animateFrom) * 45, fill: 'both' }
        );
      }
    });

    const left = list.length - shown;
    moreWrap.hidden = left <= 0;
    if (moreCnt) moreCnt.textContent = left > 0 ? `(${left})` : '';
    if (empty) empty.hidden = list.length > 0;
  }

  function setCat(cat: string) {
    // Z podstron realizacji przychodzą ?cat= z dowolnym tagiem (np. „Stomatologia"),
    // który nie musi być jednym z sześciu przycisków — wtedy wracamy do „Wszystkie".
    const match = filterBtns.find((b) => {
      const bc = (b.dataset.cat || '').toLowerCase();
      const c = cat.toLowerCase();
      return bc === c || bc.includes(c) || c.includes(bc);
    });
    activeCat = match?.dataset.cat || 'Wszystkie';
    shown = VISIBLE;
    filterBtns.forEach((b) => {
      const on = b.dataset.cat === activeCat;
      b.classList.toggle('active', on);
      b.setAttribute('aria-pressed', String(on));
    });
    render();
  }

  filterBtns.forEach((btn) => btn.addEventListener('click', () => setCat(btn.dataset.cat || 'Wszystkie')));
  resetBtn?.addEventListener('click', () => setCat('Wszystkie'));

  moreBtn.addEventListener('click', () => {
    const from = shown;
    shown += VISIBLE;
    render(from);
  });

  render();

  // Filtr z adresu ?cat= — linkowany z podstron realizacji.
  const urlCat = new URLSearchParams(window.location.search).get('cat');
  if (urlCat) {
    setCat(urlCat);
    document.getElementById('filter-bar')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
})();
</script>
