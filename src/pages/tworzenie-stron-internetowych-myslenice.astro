---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  {
    q: 'Ile kosztuje strona internetowa dla firmy z Myślenic?',
    a: priceAnswer('Myślenic'),
  },
  {
    q: 'Co jeszcze można dobrać do projektu?',
    a: addonsAnswer(),
  },
  {
    q: 'Mam już stronę, ale klienci i tak dzwonią z polecenia. Po co mi lepsza?',
    a: 'Polecenia zostają — strona ich nie zastąpi i nie ma takiego zadania. Robi dwie inne rzeczy: domyka polecenia, które już dostajecie (bo dziś prawie każdy sprawdza firmę w Google przed telefonem), i otwiera dostęp do klientów spoza kręgu znajomych. Jeśli macie komplet zleceń na rok do przodu, uczciwie powiemy, że lepiej podnieść ceny niż inwestować w stronę.',
  },
  {
    q: 'Ile trwa zrobienie strony?',
    a: 'Wizytówka: 2–4 tygodnie. Strona firmowa z projektem graficznym od zera: 4–8 tygodni. Sklep: 8–16 tygodni. W dziewięciu przypadkach na dziesięć opóźnienia biorą się nie z naszej pracy, tylko z czekania na treści i zdjęcia — jeśli macie je przygotowane, terminy skracają się wyraźnie.',
  },
  {
    q: 'Jak daleko macie do Myślenic?',
    a: 'Studio mamy w Izdebniku przy ulicy Dworskiej — do Myślenic jest stąd około dwudziestu minut przez Sułkowice. Na spotkanie podjedziemy do Was, do Dobczyc, Pcimia czy Sieprawia również.',
  },
  {
    q: 'Robicie strony na WordPressie czy pisane od zera?',
    a: 'Oba. WordPress ma sens, gdy chcecie często samodzielnie edytować treści. Strona pisana w Astro albo Next.js jest wyraźnie szybsza, bezpieczniejsza i tańsza w utrzymaniu — nie ma wtyczek do aktualizowania i nie ma czego zhakować. Decyzję podejmujemy po rozmowie o tym, jak realnie będziecie strony używać, a nie na podstawie tego, co nam wygodniej zrobić.',
  },
  {
    q: 'Na kogo będzie zarejestrowana domena?',
    a: 'Na Was. Dostępy do hostingu i panelu przekazujemy w komplecie po wdrożeniu. To Wasza własność — możecie w każdej chwili przenieść stronę gdzie indziej.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: {
    '@type': 'City',
    name: 'Myślenice',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'powiat myślenicki, województwo małopolskie' },
  },
  url: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-myslenice',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Tworzenie stron internetowych — Myślenice', item: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-myslenice' },
  ],
};
---

<Layout
  title="Tworzenie stron internetowych Myślenice — projektowanie stron WWW | CtrlZ Studio"
  description="Strony internetowe dla firm z Myślenic, Dobczyc, Sułkowic, Pcimia i powiatu myślenickiego. Projektowanie, kodowanie, sklepy i SEO lokalne. Studio z Izdebnika."
>
<SharedNav />

<main id="main-content">

<style>
  .loc-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .loc-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .loc-h1 { margin-bottom: 20px; }
  .loc-lead { font-size: 17px; color: rgba(255,255,255,.5); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .loc-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }

  .loc-quick { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .loc-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(236,72,153,.1); border: 1px solid rgba(236,72,153,.26);
    color: #f9a8d4;
  }

  .loc-section { padding: 72px 0; background: var(--bg-base); }
  .loc-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .loc-h2 { margin-bottom: 18px; }
  .loc-p { font-size: 15px; color: rgba(255,255,255,.5); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .loc-p strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .loc-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .loc-card:hover { border-color: rgba(236,72,153,.28); transform: translateY(-2px); }
  .loc-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .loc-card p { font-size: 14px; color: rgba(255,255,255,.55); line-height: 1.7; margin: 0; }

  .loc-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .loc-list li {
    font-size: 15px; color: rgba(255,255,255,.5); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .loc-list li::before { content: '→'; position: absolute; left: 0; color: #ec4899; font-size: 14px; }
  .loc-list strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-villages { font-size: 14px; color: rgba(255,255,255,.55); line-height: 1.9; max-width: 820px; margin-top: 18px; }

  @media (max-width: 1024px) { .loc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .loc-inner { padding: 0 24px; }
    .loc-grid { grid-template-columns: 1fr; }
    .loc-hero { padding: 120px 0 48px; }
  }
</style>

<!-- HERO -->
<section class="loc-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="loc-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Myślenice i powiat myślenicki</div>
    <h1 class="display-xl loc-h1">
      Tworzenie stron<br>
      internetowych<br>
      <span class="grad-v">Myślenice</span>
    </h1>
    <p class="loc-lead">
      Robimy strony WWW dla firm z Myślenic, Dobczyc, Sułkowic, Pcimia i Sieprawia.
      <strong>Studio mamy w Izdebniku — dwadzieścia minut przez Sułkowice.</strong>
      Strony, które ładują się błyskawicznie i wychodzą wysoko w wyszukiwaniach z okolicy.
    </p>
    <div class="loc-quick">
      <span class="loc-chip">Strony firmowe</span>
      <span class="loc-chip">Sklepy internetowe</span>
      <span class="loc-chip">SEO lokalne</span>
      <span class="loc-chip">Audyt istniejącej strony</span>
    </div>
  </div>
</section>

<!-- SPECYFIKA -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Myślenice to <span class="grad">rynek tranzytowy</span> —<br>i to jest szansa</h2>
    <p class="loc-p">
      Przez Myślenice przechodzi zakopianka, a to oznacza dwie rzeczy naraz.
      Po pierwsze, przez miasto przejeżdżają setki tysięcy ludzi rocznie, którzy
      w razie potrzeby wpiszą w telefon „warsztat Myślenice" albo „obiad Myślenice".
      <strong>To ruch, który trafia wyłącznie do firm widocznych w Google — polecenia tu nie działają,
      bo nikt tych ludzi nie zna.</strong>
    </p>
    <p class="loc-p">
      Po drugie, Myślenice są ośrodkiem powiatu i naturalnym punktem odniesienia
      dla mieszkańców całej okolicy — Dobczyc, Pcimia, Sułkowic, Sieprawia, Tokarni.
      Firma z Myślenic, która dobrze wypada w wyszukiwaniach, obsługuje nie tylko miasto,
      ale cały powiat.
    </p>
    <p class="loc-p">
      W praktyce oznacza to, że warto celować szerzej niż w samą nazwę miasta.
      Strona zbudowana z osobnymi podstronami pod usługi i okoliczne miejscowości
      zbiera ruch, do którego konkurencja w ogóle się nie zabrała — bo większość
      lokalnych firm kończy na jednej stronie o wszystkim.
    </p>
  </div>
</section>

<!-- CO ROBIMY -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Co robimy dla firm<br>z <span class="grad-v">Myślenic</span></h2>
    <div class="loc-grid">
      <div class="loc-card">
        <h3>Strony firmowe</h3>
        <p>Od wizytówki po serwis z katalogiem usług i blogiem. Indywidualny projekt graficzny, nie szablon podmieniony kolorystycznie.</p>
      </div>
      <div class="loc-card">
        <h3>Struktura pod usługi</h3>
        <p>Osobna podstrona pod każdą usługę i kluczową miejscowość. Jedna strona nie wygra naraz o „Myślenice" i „Dobczyce" — kilka wygra.</p>
      </div>
      <div class="loc-card">
        <h3>Sklepy internetowe</h3>
        <p>WooCommerce albo rozwiązanie pisane od zera. Płatności, kurierzy, integracje z magazynem i księgowością.</p>
      </div>
      <div class="loc-card">
        <h3>SEO lokalne</h3>
        <p>Dane strukturalne, wizytówka Google, strategia fraz, opinie. Ta część decyduje, czy ktokolwiek stronę znajdzie — i najczęściej wypada z tanich ofert.</p>
      </div>
      <div class="loc-card">
        <h3>Audyt istniejącej strony</h3>
        <p>Zanim zaproponujemy nową, sprawdzamy, czy obecnej nie da się naprawić taniej. Szybkość, konfiguracja techniczna, widoczność w Google.</p>
      </div>
      <div class="loc-card">
        <h3>Opieka po wdrożeniu</h3>
        <p>Aktualizacje, kopie zapasowe, monitoring i drobne zmiany. Możecie mieć stronę pod opieką albo obsługiwać ją sami — jak wolicie.</p>
      </div>
    </div>
  </div>
</section>

<!-- DLA KOGO -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Komu to najbardziej<br><span class="grad">się opłaca</span></h2>
    <ul class="loc-list">
      <li><strong>Gastronomia i noclegi przy zakopiance</strong> — tu praktycznie cały ruch przypadkowy przychodzi z wyszukiwarki i map.</li>
      <li><strong>Warsztaty i usługi motoryzacyjne</strong> — awaria na trasie oznacza wyszukiwanie z telefonu i telefon do pierwszej sensownie wyglądającej firmy.</li>
      <li><strong>Firmy budowlane i wykończeniowe</strong> — gdzie klient chce najpierw zobaczyć realizacje, a dopiero potem dzwoni.</li>
      <li><strong>Gabinety i usługi zdrowotne</strong> — decyduje wizytówka Google, opinie i możliwość szybkiego umówienia się.</li>
      <li><strong>Firmy obsługujące cały powiat</strong> — jeśli jeździcie do Dobczyc, Pcimia i Sułkowic, strona powinna to jasno komunikować, także Google.</li>
    </ul>
    <p class="loc-p" style="margin-top:28px">
      W <a href="/realizacje" style="color:#c4b5fd">naszych realizacjach</a> znajdziecie firmy
      dokładnie takiego typu. Jak policzyć, czy strona się opłaci w Waszym przypadku,
      rozpisałem w tekście
      <a href="/blog/strona-internetowa-dla-firmy-z-malej-miejscowosci" style="color:#c4b5fd">o firmach z małych miejscowości</a>.
    </p>
  </div>
</section>

<!-- OBSZAR -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Gdzie <span class="grad-v">dojedziemy</span></h2>
    <p class="loc-p">
      Biuro mamy w Izdebniku — do Myślenic jest stąd około dwudziestu minut przez Sułkowice.
      Obsługujemy miasto i cały powiat:
    </p>
    <p class="loc-villages">
      Myślenice · Dobczyce · Sułkowice · Pcim · Siepraw · Tokarnia · Raciechowice ·
      Wiśniowa · Lubień · Biertowice · Krzywaczka · Harbutowice · Głogoczów ·
      Jawornik · Trzemeśnia · Osieczany · Izdebnik · Skawina
    </p>
    <p class="loc-p" style="margin-top:24px">
      Na spotkanie podjedziemy do Was — do biura, zakładu albo lokalu.
      Przy pierwszym projekcie to zwykle najlepszy sposób, żeby zrozumieć,
      co warto pokazać na stronie.
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Najczęstsze <span class="grad">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner" style="text-align:center">
    <h2 class="display-md loc-h2">Porozmawiajmy<br>o <span class="grad-v">Waszej stronie</span></h2>
    <p class="loc-p" style="margin:0 auto 32px">
      Pierwsza rozmowa nic nie kosztuje i do niczego nie zobowiązuje.
      Powiemy szczerze, co w Waszym przypadku ma sens — także wtedy,
      gdy naszym zdaniem strona się nie opłaci.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="loc-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/tworzenie-stron-internetowych-sulkowice" style="color:#c4b5fd">strony WWW w Sułkowicach</a> ·
      <a href="/tworzenie-stron-internetowych-skawina" style="color:#c4b5fd">w Skawinie</a> ·
      <a href="/tworzenie-stron-internetowych-wadowice" style="color:#c4b5fd">w Wadowicach</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
