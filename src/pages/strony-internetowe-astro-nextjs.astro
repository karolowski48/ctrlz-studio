---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { PRICING, priceAnswer } from '../data/pricing';

/**
 * ASTRO / NEXT.JS — jedna podstrona dla obu technologii.
 * ═════════════════════════════════════════════════════
 * ŚWIADOMA DECYZJA: nie robimy osobnych podstron dla Astro i dla Next.js.
 * Klienci nie wpisują w Google „strona w Astro" — wpisują „szybka strona
 * internetowa" albo „strona bez WordPressa". Dwie podstrony konkurowałyby
 * o te same, znikome frazy i rozcieńczały moc linków.
 *
 * Kanibalizacja: /strony-internetowe zostaje stroną ogólną,
 * /strony-internetowe-wordpress obsługuje drugą technologię,
 * ta celuje w klienta, dla którego liczy się szybkość i bezpieczeństwo.
 */

const zl = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} zł`;

const zalety = [
  { t: 'Szybkość, której WordPress nie osiąga', d: 'Serwer wysyła gotowy plik HTML zamiast składać stronę przy każdym wejściu. Nie ma zapytań do bazy, nie ma wtyczek do wczytania. W praktyce oznacza to wynik powyżej 95 punktów na telefonie, a nie walkę o przekroczenie 60.' },
  { t: 'Nie ma czego zhakować', d: 'Bez bazy danych, bez panelu logowania pod znanym adresem, bez wtyczek z podatnościami. Znika cała kategoria zagrożeń, która przy WordPressie wymaga stałego pilnowania.' },
  { t: 'Tańsze utrzymanie', d: 'Nie ma obowiązkowych aktualizacji, bo nie ma czego aktualizować co tydzień. Hosting jest tańszy — przy niewielkim ruchu często darmowy, bo serwer nie wykonuje żadnego kodu.' },
  { t: 'Pełna swoboda projektu', d: 'Układ nie jest ograniczony tym, co potrafi motyw. Nietypowe animacje, kalkulatory, konfiguratory, interaktywne sekcje — wszystko wykonalne, bo piszemy to od zera.' },
  { t: 'Bardzo dobra baza pod SEO', d: 'Czysty kod, kontrola nad każdym znacznikiem, dane strukturalne dokładnie tam, gdzie trzeba, i szybkość jako czynnik rankingowy po Waszej stronie.' },
  { t: 'Treści nadal do edycji', d: 'Można podpiąć panel do zarządzania treścią — treści edytujecie jak w WordPressie, a strona pozostaje statyczna i szybka. To rozwiązanie zwane headless.' },
];

const kiedy = [
  { n: '01', t: 'Szybkość jest przewagą konkurencyjną', d: 'Sklep, portal albo strona z dużym ruchem, gdzie każda sekunda ładowania przekłada się wprost na przychód. Także wtedy, gdy konkurencja ma wolne strony i chcecie to wykorzystać.' },
  { n: '02', t: 'Strona ma nietypowe funkcje', d: 'Kalkulator wyceny, konfigurator produktu, interaktywna mapa, rozbudowane filtrowanie. Rzeczy, które w WordPressie wymagałyby wtyczki albo w ogóle nie istnieją.' },
  { n: '03', t: 'Zależy Wam na bezpieczeństwie', d: 'Branże, w których przejęcie strony byłoby poważnym problemem — usługi finansowe, medyczne, przetargi publiczne.' },
  { n: '04', t: 'Treści zmieniają się rzadko', d: 'Strona firmowa albo katalogowa aktualizowana kilka razy w roku. Wtedy wygoda codziennej edycji przestaje być argumentem, a zostaje szybkość i niskie utrzymanie.' },
  { n: '05', t: 'Planujecie stronę na lata', d: 'Wyższy koszt wejścia rozkłada się na czas życia projektu, a niższe utrzymanie zaczyna go zwracać już w drugim roku.' },
];

const kiedyNie = [
  'Chcecie codziennie samodzielnie zmieniać treści i dokładać podstrony bez kontaktu z nami',
  'Prowadzicie intensywnie bloga i zależy Wam na najwygodniejszym możliwym edytorze',
  'Budżet jest napięty — WordPress będzie tańszy we wdrożeniu',
  'Potrzebujecie funkcji, która w WordPressie jest gotową wtyczką, a tutaj wymagałaby napisania',
  'Zależy Wam na maksymalnym wyborze wykonawców na przyszłość',
];

const faq = [
  { q: 'Ile kosztuje strona w Astro albo Next.js?', a: priceAnswer() },
  { q: 'Czym różni się Astro od Next.js?', a: 'Astro buduje stronę jako zestaw gotowych plików i dokłada JavaScript tylko tam, gdzie jest naprawdę potrzebny — idealne przy stronach firmowych, katalogach i blogach. Next.js to pełne środowisko aplikacyjne: sprawdza się, gdy strona ma logować użytkowników, obsługiwać panel klienta albo działać jak aplikacja. Przy typowej stronie firmowej wybieramy Astro, bo daje ten sam efekt mniejszym kosztem.' },
  { q: 'Czy będę mógł sam edytować treści?', a: 'Tak, jeśli tego potrzebujecie — dokładamy panel do zarządzania treścią i strona przebudowuje się automatycznie po zapisaniu zmian. Warto jednak policzyć: przy stronie zmienianej kilka razy w roku panel podnosi cenę i nie daje wiele w zamian. Powiemy wprost, co się w Waszym przypadku opłaca.' },
  { q: 'Czy taka strona jest dobra pod SEO?', a: 'Bardzo dobra i to jest jeden z głównych argumentów. Mamy pełną kontrolę nad każdym znacznikiem, danymi strukturalnymi i strukturą adresów, a szybkość — jeden z czynników rankingowych — jest znacznie wyższa niż przy typowej stronie na WordPressie. Ta strona, na której właśnie jesteście, jest zbudowana w Astro.' },
  { q: 'Ile kosztuje utrzymanie?', a: 'Zdecydowanie mniej niż przy WordPressie. Nie ma obowiązkowej opieki technicznej, bo nie ma wtyczek do aktualizowania ani bazy do zabezpieczania. Hosting jest tańszy, przy niewielkim ruchu często darmowy. Realnie: domena plus symboliczny hosting, czyli kilkaset złotych rocznie zamiast kilku tysięcy.' },
  { q: 'Czy to nie uzależnia mnie od Was?', a: 'Nie bardziej niż WordPress. Kod jest Wasz, repozytorium przekazujemy w komplecie, technologie są otwarte i popularne wśród programistów. Wykonawców jest mniej niż przy WordPressie i to uczciwie trzeba powiedzieć — ale nie jest to zamknięty ekosystem jednej firmy.' },
  { q: 'Dlaczego to droższe od WordPressa?', a: `Bo więcej rzeczy piszemy od zera zamiast konfigurować gotowe. Dopłata wynosi ${PRICING.techSurcharge} do wyceny. Zwraca się w utrzymaniu — brak opieki technicznej to oszczędność rzędu kilku tysięcy złotych rocznie, więc przy horyzoncie trzech lat różnica zwykle wychodzi na zero albo na Waszą korzyść.` },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych Astro i Next.js',
  name: 'Strony internetowe pisane od zera — Astro i Next.js',
  description: 'Strony pisane w Astro i Next.js: wynik PageSpeed powyżej 95, brak wtyczek do aktualizowania i niskie koszty utrzymania.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'Country', name: 'Polska' },
  url: 'https://ctrlzstudio.pl/strony-internetowe-astro-nextjs',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Strony internetowe', item: 'https://ctrlzstudio.pl/strony-internetowe' },
    { '@type': 'ListItem', position: 3, name: 'Astro i Next.js', item: 'https://ctrlzstudio.pl/strony-internetowe-astro-nextjs' },
  ],
};
---

<Layout
  title="Strony w Astro i Next.js — bez WordPressa | CtrlZ Studio"
  description="Strony pisane od zera w Astro i Next.js. Wynik PageSpeed powyżej 95, brak wtyczek do aktualizowania i wyraźnie niższe koszty utrzymania niż przy WordPressie."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-crumbs { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 18px; }
  .srv-crumbs a { color: rgba(255,255,255,.68); text-decoration: none; }
  .srv-crumbs a:hover { color: #c4b5fd; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.64); line-height: 1.75; max-width: 740px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.84); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip { font-size: 12px; padding: 7px 16px; border-radius: 100px; background: rgba(124,107,255,.1); border: 1px solid rgba(124,107,255,.26); color: #c4b5fd; }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.64); line-height: 1.8; max-width: 780px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07); border-radius: 16px; padding: 26px; transition: border-color .25s, transform .25s; }
  .srv-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 820px; margin-top: 32px; }
  .srv-step { display: flex; gap: 22px; align-items: flex-start; padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .srv-step-n { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: #c4b5fd; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85; }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-list { max-width: 780px; margin: 24px 0 0; padding: 0; list-style: none; }
  .srv-list li { font-size: 15px; color: rgba(255,255,255,.66); line-height: 1.75; padding: 0 0 0 26px; margin-bottom: 12px; position: relative; }
  .srv-list li::before { content: '✕'; position: absolute; left: 0; color: #f87171; font-size: 13px; }
  .spd { display: grid; grid-template-columns: repeat(3,1fr); gap: 16px; margin-top: 36px; max-width: 780px; }
  .spd-box { background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 22px 18px; text-align: center; }
  .spd-n { font-family: var(--font-display); font-size: 30px; font-weight: 800; line-height: 1; margin-bottom: 8px; }
  .spd-l { font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid { grid-template-columns: 1fr; }
    .spd { grid-template-columns: 1fr 1fr; }
    .srv-hero { padding: 120px 0 48px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="srv-crumbs"><a href="/">Strona główna</a> · <a href="/strony-internetowe">Strony internetowe</a> · Astro i Next.js</div>
    <div class="eyebrow" style="margin-bottom:18px">Usługa</div>
    <h1 class="display-xl" style="margin-bottom:20px">Strony pisane od zera<br>w <span class="grad">Astro i Next.js</span></h1>
    <p class="srv-lead">
      Dla firm, dla których <strong>szybkość i bezpieczeństwo są ważniejsze niż codzienna edycja treści</strong>.
      Bez bazy danych, bez wtyczek, bez obowiązkowych aktualizacji — i z wynikiem, którego
      strona na gotowym szablonie po prostu nie osiągnie.
    </p>
    <div class="srv-chips">
      <span class="srv-chip">PageSpeed 95+</span>
      <span class="srv-chip">Brak wtyczek do aktualizacji</span>
      <span class="srv-chip">Niskie koszty utrzymania</span>
      <span class="srv-chip">{PRICING.techSurcharge} do wyceny</span>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Ta strona jest<br><span class="grad-v">tego przykładem</span></h2>
    <p class="srv-p">
      Serwis, na którym właśnie jesteście, jest zbudowany w Astro. Nie musicie wierzyć nam na słowo —
      <strong>wklejcie jego adres w PageSpeed Insights i porównajcie z dowolną stroną agencji z okolicy</strong>.
      To jest najuczciwszy sposób oceny wykonawcy, jaki znamy.
    </p>
    <div class="spd">
      <div class="spd-box"><div class="spd-n grad">95+</div><div class="spd-l">PageSpeed mobile</div></div>
      <div class="spd-box"><div class="spd-n grad">0</div><div class="spd-l">wtyczek do aktualizacji</div></div>
      <div class="spd-box"><div class="spd-n grad">&lt; 1 s</div><div class="spd-l">czas do pierwszej treści</div></div>
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co daje <span class="grad">rezygnacja z WordPressa</span></h2>
    <div class="srv-grid">
      {zalety.map((z) => (
        <div class="srv-card"><h3>{z.t}</h3><p>{z.d}</p></div>
      ))}
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Kiedy warto<br>wybrać <span class="grad-v">to rozwiązanie</span></h2>
    <div class="srv-steps">
      {kiedy.map((k) => (
        <div class="srv-step">
          <div class="srv-step-n">{k.n}</div>
          <div><h3>{k.t}</h3><p>{k.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Kiedy <span class="grad">odradzamy</span></h2>
    <p class="srv-p">
      Mówimy to klientom regularnie, mimo że oznacza to niższą wycenę. W tych sytuacjach
      <strong>WordPress będzie lepszym wyborem</strong> i nie ma sensu dopłacać:
    </p>
    <ul class="srv-list">
      {kiedyNie.map((k) => <li>{k}</li>)}
    </ul>
    <p class="srv-p" style="margin-top:28px">
      Jeśli rozpoznajecie się w którymkolwiek z tych punktów, zajrzyjcie na stronę
      <a href="/strony-internetowe-wordpress" style="color:#c4b5fd">strony na WordPressie</a>.
      Porównanie obu podejść jest też we wpisie
      <a href="/blog/wordpress-vs-custom" style="color:#c4b5fd">WordPress czy rozwiązanie pisane od zera</a>.
    </p>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Zróbmy stronę,<br>która <span class="grad">wyprzedzi konkurencję</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">
      Opiszcie, co ma robić strona i jak często chcecie ją zmieniać. Powiemy, czy warto dopłacić
      za technologię, czy lepiej zostać przy WordPressie.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Poproś o wycenę</span></a>
      <a href="/ile-kosztuje-strona-internetowa" class="btn-ghost"><span>Zobacz cennik</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/strony-internetowe" style="color:#c4b5fd">strony internetowe</a> ·
      <a href="/strony-internetowe-wordpress" style="color:#c4b5fd">WordPress</a> ·
      <a href="/sklepy-internetowe-prestashop" style="color:#c4b5fd">sklepy PrestaShop</a> ·
      <a href="/realizacje" style="color:#c4b5fd">realizacje</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
