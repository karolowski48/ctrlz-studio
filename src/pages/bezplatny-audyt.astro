---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';

/**
 * BEZPŁATNY AUDYT — magnes na leady
 * ═════════════════════════════════
 *
 * Logika podziału: DIAGNOZA za darmo, RECEPTA za pieniądze.
 * Wersja bezpłatna pokazuje wyniki i trzy najpoważniejsze problemy
 * (problem + wpływ), ale BEZ kolumny „rekomendacja".
 * Wersja premium (300–1000 zł, patrz /audyt-strony) dokłada rekomendacje,
 * pełną listę, problemy przekrojowe, plan działań i rozmowę.
 *
 * FORMULARZ: na razie działa na mailto, tak jak /kontakt.
 * Po podpięciu Formspree/Web3Forms wystarczy:
 *   1. dodać do <form> atrybuty action="https://…" method="POST"
 *   2. usunąć preventDefault() w skrypcie na dole
 */

const compare = [
  { row: 'Wyniki punktowe (wydajność, SEO, dostępność, dobre praktyki)', free: true, paid: true },
  { row: 'Zrzuty strony — widok desktop i mobile', free: true, paid: true },
  { row: 'Trzy najpoważniejsze problemy z opisem skutków', free: true, paid: true },
  { row: 'Status RODO, zgód i Consent Mode v2', free: true, paid: true },
  { row: 'Rekomendacja naprawy przy każdym problemie', free: false, paid: true },
  { row: 'Pełna lista wykrytych problemów z priorytetami', free: false, paid: true },
  { row: 'Problemy przekrojowe — ile podstron dotyczy i które', free: false, paid: true },
  { row: 'Analiza UX i ścieżki do zapytania', free: false, paid: true },
  { row: 'Bezpieczeństwo i warstwa techniczna', free: false, paid: true },
  { row: 'Plan działań w rekomendowanej kolejności', free: false, paid: true },
  { row: 'Rozmowa omawiająca wyniki', free: false, paid: true },
];

const scope = [
  { t: 'Szybkość działania', d: 'Pomiar wydajności na telefonie i komputerze — w tym moment, w którym pojawia się kluczowa treść, i to, po jakim czasie strona reaguje na dotknięcie.' },
  { t: 'SEO techniczne', d: 'Tytuły, opisy, nagłówki, znaczniki canonical, mapa witryny. Rzeczy, które decydują o tym, czy Google w ogóle rozumie, o czym jest Twoja strona.' },
  { t: 'Dostępność', d: 'Testy zgodności z WCAG — kontrasty, opisy alternatywne, struktura nagłówków, obsługa klawiaturą. Przy zamówieniach publicznych bywa to wymóg formalny.' },
  { t: 'Zgody i RODO', d: 'Czy narzędzia analityczne uruchamiają się przed zgodą użytkownika, czy działa Consent Mode v2, czy polityka prywatności jest na miejscu. To obszar z realnym ryzykiem kary.' },
  { t: 'Bezpieczeństwo', d: 'Nagłówki ochronne, ujawnianie wersji oprogramowania, publicznie dostępne dane, które ułatwiają atak.' },
  { t: 'Ścieżka do kontaktu', d: 'Czy odwiedzający wie, co ma zrobić dalej, i czy zapytanie da się wysłać bez szukania. Najczęstsza przyczyna ruchu, który nie zamienia się w klientów.' },
];

const steps = [
  { n: '01', t: 'Zgłoszenie', d: 'Zostawiasz adres strony i e-mail. Cztery pola, minuta pracy.' },
  { n: '02', t: 'Analiza', d: 'Przechodzimy przez serwis zestawem testów technicznych, a wyniki weryfikujemy ręcznie — narzędzia potrafią zgłaszać rzeczy, które w kontekście są w porządku.' },
  { n: '03', t: 'Raport w 48 godzin', d: 'Dostajesz PDF z wynikami, zrzutami i trzema najpoważniejszymi problemami. Bez rozmowy sprzedażowej na wejściu.' },
  { n: '04', t: 'Decyzja należy do Ciebie', d: 'Możesz naprawić to sam, zlecić komukolwiek albo zamówić pełny raport. Nie dzwonimy trzy razy w tygodniu.' },
];

const faq = [
  { q: 'Gdzie jest haczyk?', a: 'Nie ma haczyku, jest interes. Robimy strony i pozycjonowanie, więc część firm, które dostaną raport, wróci do nas ze zleceniem — a część naprawi wszystko sama i tyle nas z tego będzie. Uznaliśmy, że lepiej pokazać, co potrafimy, niż wysyłać kolejną ofertę, której nikt nie czyta.' },
  { q: 'Czym różni się bezpłatny raport od płatnego?', a: 'Bezpłatny mówi, co jest nie tak. Płatny mówi, co z tym zrobić, w jakiej kolejności i dlaczego akurat tak. W wersji bezpłatnej pokazujemy wyniki, zrzuty i trzy najpoważniejsze problemy wraz z ich skutkami, ale bez rekomendacji naprawy. Pełny raport zawiera rekomendację przy każdym problemie, kompletną listę z priorytetami, problemy dotyczące wielu podstron naraz, plan działań i rozmowę omawiającą wyniki.' },
  { q: 'Ile kosztuje pełny audyt?', a: 'Od 300 do 1000 zł, zależnie od wielkości serwisu i liczby podstron do przeanalizowania. Przy prostej stronie wizytówkowej to dolna granica, przy rozbudowanym serwisie albo sklepie — górna. Dokładną kwotę podajemy po zobaczeniu strony, przed rozpoczęciem pracy.' },
  { q: 'Czy muszę dać dostęp do strony albo hasła?', a: 'Nie. Analizujemy wyłącznie to, co jest publicznie dostępne — dokładnie tak, jak widzi Twoją stronę Google i każdy odwiedzający. Żadnych dostępów, haseł ani ingerencji w serwis.' },
  { q: 'Co, jeśli moja strona wypadnie źle?', a: 'To najczęstszy scenariusz i nie ma w nim nic wstydliwego — większość stron powstawała lata temu, przy innych wymaganiach i innym internecie. Raport pokazuje stan faktyczny, a nie ocenę Twojej firmy. Zresztą im gorszy wynik, tym więcej łatwych do zdobycia poprawek.' },
  { q: 'Robicie audyty stron, których nie budowaliście?', a: 'Prawie wyłącznie takie. Nie ma znaczenia, kto i w czym zbudował stronę — WordPress, gotowy kreator, autorskie rozwiązanie. Testy sprawdzają efekt końcowy, czyli to, co dostaje użytkownik i wyszukiwarka.' },
  { q: 'Co się dzieje z moimi danymi?', a: 'Adres e-mail wykorzystujemy wyłącznie do przesłania raportu i ewentualnego pytania, czy coś wyjaśnić. Nie sprzedajemy danych, nie zapisujemy nikogo do newslettera i nie dzwonimy uporczywie. Szczegóły w polityce prywatności.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Bezpłatny audyt strony internetowej',
  name: 'Bezpłatny audyt strony internetowej',
  description:
    'Bezpłatna analiza strony: wydajność, SEO techniczne, dostępność, zgody RODO i Consent Mode v2. Raport w 48 godzin.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'Polska' },
  url: 'https://ctrlzstudio.pl/bezplatny-audyt',
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'PLN',
    description: 'Bezpłatny raport diagnostyczny — wyniki punktowe i trzy najpoważniejsze problemy.',
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Bezpłatny audyt', item: 'https://ctrlzstudio.pl/bezplatny-audyt' },
  ],
};
---

<Layout
  title="Bezpłatny audyt strony — raport w 48 h | CtrlZ Studio"
  description="Sprawdzimy szybkość, SEO, dostępność i zgodność z RODO Twojej strony. Bezpłatny raport z wynikami i trzema najpoważniejszymi problemami w 48 godzin."
>
<SharedNav />

<main id="main-content">

<style>
  .ba-hero { padding: 150px 0 56px; position: relative; overflow: hidden; background: var(--bg-base); }
  .ba-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .ba-narrow { max-width: 820px; }
  .ba-lead { font-size: 17px; color: rgba(255,255,255,.64); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .ba-lead strong { color: rgba(255,255,255,.85); font-weight: 500; }
  .ba-section { padding: 72px 0; background: var(--bg-base); }
  .ba-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .ba-h2 { margin-bottom: 18px; }
  .ba-p { font-size: 15px; color: rgba(255,255,255,.64); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .ba-p strong { color: rgba(255,255,255,.82); font-weight: 500; }

  .ba-badges { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 30px; }
  .ba-badge {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(124,107,255,.1); border: 1px solid rgba(124,107,255,.26); color: #c4b5fd;
  }

  /* ── siatka wyników jak w raporcie ── */
  .ba-scores { display: grid; grid-template-columns: repeat(4,1fr); gap: 16px; margin-top: 40px; max-width: 820px; }
  .ba-score {
    background: rgba(255,255,255,.03); border: 1px solid rgba(255,255,255,.08);
    border-radius: 14px; padding: 22px 18px; text-align: center;
  }
  .ba-score-n { font-family: var(--font-display); font-size: 34px; font-weight: 800; line-height: 1; margin-bottom: 8px; }
  .ba-score-l { font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.6); }

  /* ── tabela porównawcza ── */
  .ba-table { margin-top: 40px; border: 1px solid rgba(255,255,255,.08); border-radius: 16px; overflow: hidden; }
  .ba-tr { display: grid; grid-template-columns: 1fr 132px 132px; align-items: center; }
  .ba-tr + .ba-tr { border-top: 1px solid rgba(255,255,255,.06); }
  .ba-th { background: rgba(255,255,255,.04); }
  .ba-th > div { padding: 16px 20px; font-size: 12px; letter-spacing: .08em; text-transform: uppercase; color: rgba(255,255,255,.72); font-weight: 600; }
  .ba-th .ba-c { text-align: center; }
  .ba-td { padding: 15px 20px; font-size: 14.5px; color: rgba(255,255,255,.74); line-height: 1.6; }
  .ba-c { text-align: center; padding: 15px 10px; font-size: 16px; }
  .ba-yes { color: #6ee7a8; }
  .ba-no { color: rgba(255,255,255,.28); }
  .ba-col-paid { background: rgba(124,107,255,.05); }

  .ba-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .ba-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 26px; transition: border-color .25s, transform .25s;
  }
  .ba-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .ba-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .ba-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }

  .ba-steps { max-width: 780px; margin-top: 32px; }
  .ba-step { display: flex; gap: 22px; align-items: flex-start; padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .ba-step-n { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: #c4b5fd; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85; }
  .ba-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .ba-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }

  /* ── formularz ── */
  .ba-form-wrap {
    max-width: 720px; margin: 0 auto; background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.09); border-radius: 20px; padding: 40px;
  }
  .ba-form { display: grid; gap: 18px; }
  .ba-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .ba-label { display: block; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: rgba(255,255,255,.72); margin-bottom: 8px; font-weight: 500; }
  .ba-input {
    width: 100%; box-sizing: border-box; padding: 14px 16px; border-radius: 12px;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.12);
    color: #fff; font-size: 15px; font-family: inherit; transition: border-color .2s, background .2s;
  }
  .ba-input:focus { outline: none; border-color: rgba(124,107,255,.6); background: rgba(255,255,255,.06); }
  .ba-input::placeholder { color: rgba(255,255,255,.42); }
  textarea.ba-input { resize: vertical; min-height: 110px; }
  .ba-consent { display: flex; gap: 12px; align-items: flex-start; font-size: 13px; color: rgba(255,255,255,.62); line-height: 1.65; }
  .ba-consent input { margin-top: 3px; width: 17px; height: 17px; flex-shrink: 0; accent-color: #7c6bff; }
  .ba-consent a { color: #c4b5fd; }
  .ba-note { font-size: 13px; color: rgba(255,255,255,.55); line-height: 1.7; text-align: center; margin-top: 20px; }

  @media (max-width: 1024px) { .ba-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .ba-inner { padding: 0 24px; }
    .ba-grid, .ba-row { grid-template-columns: 1fr; }
    .ba-scores { grid-template-columns: 1fr 1fr; }
    .ba-hero { padding: 120px 0 40px; }
    .ba-form-wrap { padding: 26px 20px; }
    .ba-tr { grid-template-columns: 1fr 74px 74px; }
    .ba-td { padding: 13px 14px; font-size: 13.5px; }
    .ba-th > div { padding: 13px 14px; font-size: 10.5px; }
  }
</style>

<!-- HERO -->
<section class="ba-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="ba-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Bezpłatnie · Raport w 48 godzin</div>
    <h1 class="display-xl" style="margin-bottom:20px">Sprawdzimy Twoją stronę<br><span class="grad">za darmo</span></h1>
    <p class="ba-lead">
      Szybkość, SEO, dostępność, bezpieczeństwo i zgodność z RODO.
      <strong>Dostaniesz raport z wynikami i trzema najpoważniejszymi problemami</strong> —
      bez rozmowy sprzedażowej na wejściu i bez zobowiązań.
    </p>
    <div class="ba-badges">
      <span class="ba-badge">Bez dostępu do strony</span>
      <span class="ba-badge">Bez zobowiązań</span>
      <span class="ba-badge">Raport PDF w 48 h</span>
    </div>

    <div class="ba-scores">
      <div class="ba-score"><div class="ba-score-n" style="color:#f87171">34</div><div class="ba-score-l">Wydajność</div></div>
      <div class="ba-score"><div class="ba-score-n" style="color:#fb923c">58</div><div class="ba-score-l">Dostępność</div></div>
      <div class="ba-score"><div class="ba-score-n" style="color:#fbbf24">67</div><div class="ba-score-l">SEO</div></div>
      <div class="ba-score"><div class="ba-score-n" style="color:#fb923c">61</div><div class="ba-score-l">Dobre praktyki</div></div>
    </div>
    <p class="ba-p" style="font-size:13.5px;margin-top:14px;color:rgba(255,255,255,.5)">
      Przykładowe wyniki z raportu przygotowanego dla jednego z klientów.
    </p>
  </div>
</section>

<!-- CO SPRAWDZAMY -->
<section class="ba-section">
  <div class="ba-inner">
    <h2 class="display-md ba-h2">Co <span class="grad-v">sprawdzamy</span></h2>
    <p class="ba-p">
      Analizujemy wyłącznie to, co publicznie dostępne — dokładnie tak, jak widzi Twoją stronę Google
      i każdy odwiedzający. Nie potrzebujemy żadnych dostępów ani haseł.
    </p>
    <div class="ba-grid">
      {scope.map((s) => (
        <div class="ba-card"><h3>{s.t}</h3><p>{s.d}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- DIAGNOZA vs RECEPTA -->
<section class="ba-section ba-section-alt">
  <div class="ba-inner">
    <h2 class="display-md ba-h2">Bezpłatny mówi <span class="grad">co</span>,<br>pełny mówi <span class="grad-v">co z tym zrobić</span></h2>
    <p class="ba-p">
      Nie ukrywamy, gdzie przebiega granica. Bezpłatny raport to <strong>diagnoza</strong> —
      pokazuje stan strony i najpoważniejsze problemy wraz z ich skutkami.
      Pełny audyt to <strong>recepta</strong> — przy każdym problemie dostajesz konkretną rekomendację naprawy,
      całość ułożoną w kolejności wdrażania i rozmowę, na której to omawiamy.
    </p>

    <div class="ba-table">
      <div class="ba-tr ba-th">
        <div>Zakres</div>
        <div class="ba-c">Bezpłatny</div>
        <div class="ba-c ba-col-paid">Pełny audyt</div>
      </div>
      {compare.map((c) => (
        <div class="ba-tr">
          <div class="ba-td">{c.row}</div>
          <div class={`ba-c ${c.free ? 'ba-yes' : 'ba-no'}`}>{c.free ? '✓' : '—'}</div>
          <div class={`ba-c ba-col-paid ${c.paid ? 'ba-yes' : 'ba-no'}`}>{c.paid ? '✓' : '—'}</div>
        </div>
      ))}
    </div>

    <p class="ba-p" style="margin-top:26px">
      Pełny audyt kosztuje <strong>od 300 do 1000 zł</strong> w zależności od wielkości serwisu.
      Szczegóły na stronie <a href="/audyt-strony" style="color:#c4b5fd">audyt strony</a>.
      Nikt nie musi go zamawiać, żeby otrzymać wersję bezpłatną.
    </p>
  </div>
</section>

<!-- JAK TO WYGLĄDA -->
<section class="ba-section">
  <div class="ba-inner">
    <h2 class="display-md ba-h2">Jak to <span class="grad">przebiega</span></h2>
    <div class="ba-steps">
      {steps.map((s) => (
        <div class="ba-step">
          <div class="ba-step-n">{s.n}</div>
          <div><h3>{s.t}</h3><p>{s.d}</p></div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- FORMULARZ -->
<section class="ba-section ba-section-alt" id="formularz">
  <div class="ba-inner">
    <div style="text-align:center;margin-bottom:36px">
      <h2 class="display-md ba-h2">Zamów <span class="grad">bezpłatny audyt</span></h2>
      <p class="ba-p" style="margin:0 auto">Cztery pola. Raport wraca na podany adres w ciągu 48 godzin.</p>
    </div>

    <div class="ba-form-wrap">
      <form class="ba-form" id="audyt-form">
        <div>
          <label class="ba-label" for="ba-url">Adres strony</label>
          <input class="ba-input" type="text" name="url" id="ba-url" placeholder="np. mojafirma.pl" required />
        </div>

        <div class="ba-row">
          <div>
            <label class="ba-label" for="ba-email">Adres e-mail</label>
            <input class="ba-input" type="email" name="email" id="ba-email" placeholder="jan@firma.pl" required />
          </div>
          <div>
            <label class="ba-label" for="ba-branza">Branża</label>
            <input class="ba-input" type="text" name="branza" id="ba-branza" placeholder="np. gabinet, budowlanka, sklep" />
          </div>
        </div>

        <div>
          <label class="ba-label" for="ba-problem">Co najbardziej uwiera Cię na obecnej stronie?</label>
          <textarea class="ba-input" name="problem" id="ba-problem"
            placeholder="Jedno–dwa zdania wystarczą. To pytanie pomaga nam wybrać to, co w raporcie faktycznie ma dla Ciebie znaczenie."></textarea>
        </div>

        <label class="ba-consent">
          <input type="checkbox" name="zgoda" id="ba-zgoda" required />
          <span>
            Zgadzam się na kontakt w sprawie raportu i przetwarzanie podanych danych w tym celu.
            Szczegóły w <a href="/polityka-prywatnosci">polityce prywatności</a>.
          </span>
        </label>

        <button type="submit" class="btn-primary" style="width:100%;justify-content:center;padding:16px">
          <span>Zamów bezpłatny audyt →</span>
        </button>
      </form>

      <p class="ba-note">
        Bez zobowiązań i bez zapisu do newslettera. Jeśli nie odezwiesz się po raporcie, my też nie będziemy naciskać.
      </p>
    </div>
  </div>
</section>

<!-- FAQ -->
<section class="ba-section">
  <div class="ba-inner">
    <h2 class="display-md ba-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
