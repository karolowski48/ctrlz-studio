<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });

  // Tymczasowo mailto — spójnie z /kontakt.
  // Po podpięciu Formspree/Web3Forms: dodaj do <form> action + method="POST"
  // i usuń całą poniższą obsługę submit.
  document.getElementById('audyt-form')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const form = e.currentTarget as HTMLFormElement;
    const fd = new FormData(form);
    const g = (k: string) => (fd.get(k) || '').toString();

    const subject = encodeURIComponent(`Bezpłatny audyt — ${g('url')}`);
    const body = encodeURIComponent(
      `Adres strony: ${g('url')}\nEmail: ${g('email')}\nBranża: ${g('branza')}\n\n` +
      `Co uwiera na obecnej stronie:\n${g('problem')}\n\n` +
      `Zgoda na kontakt: tak`
    );
  (window as any).czTrack?.('generate_lead', { form_id: 'bezplatny-audyt' });
    window.location.href = `mailto:kontakt@ctrlzstudio.pl?subject=${subject}&body=${body}`;
  });
</script>

