---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';

/**
 * AUDYT DOSTĘPNOŚCI / WCAG — satelita klastra audytowego.
 * Frazy: „audyt dostępności strony internetowej" (20+20/mies.),
 * „audyt strony internetowej wcag 2.1" (10/mies.), „strony internetowe wcag".
 * Niska konkurencja, wysoka wartość — mamy do tego własne narzędzie.
 *
 * Kanibalizacja: /audyt-strony = pełny audyt, /audyt-seo = widoczność,
 * ta = wyłącznie dostępność i zgodność z WCAG.
 */

const zl = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} zł`;

const obszary = [
  { t: 'Zakres raportu', d: 'Każde naruszenie opisane osobno: czego dotyczy, na której podstronie występuje, jaki ma wpływ na użytkownika i co konkretnie trzeba zmienić. Bez zbiorczych stwierdzeń w rodzaju „popraw kontrasty".' },
  { t: 'Priorytety, nie alfabet', d: 'Naruszenia uszeregowane według tego, ile osób realnie blokują. Niedziałający formularz jest wyżej niż brakujący opis grafiki dekoracyjnej — a większość raportów traktuje je jednakowo.' },
  { t: 'Weryfikacja ręczna', d: 'Wyniki narzędzi przechodzą przez człowieka. Usuwamy fałszywe alarmy i dopisujemy to, czego automat nie widzi — sens opisów alternatywnych, logikę kolejności treści, zrozumiałość komunikatów błędu.' },
  { t: 'Testy na czytniku ekranu', d: 'Przechodzimy przez kluczowe ścieżki — kontakt, formularz, menu — tak, jak zrobi to osoba niewidoma. To jest część, której nie zastąpi żaden skaner.' },
  { t: 'Wskazanie wzorców', d: 'Jeśli ten sam błąd wraca na trzydziestu podstronach, nie wypisujemy go trzydzieści razy. Pokazujemy, w którym elemencie szablonu siedzi przyczyna.' },
  { t: 'Wycena naprawy', d: 'Do raportu dokładamy orientacyjny nakład pracy przy każdej grupie poprawek, żebyście mogli zdecydować, co robicie sami, a co zlecacie.' },
];

const komu = [
  { n: '01', t: 'Podmioty publiczne', d: 'Urzędy, szkoły, jednostki samorządowe i podmioty finansowane ze środków publicznych. Tu obowiązek istnieje od lat i jest egzekwowany.' },
  { n: '02', t: 'Firmy startujące w przetargach', d: 'Wymóg dostępności coraz częściej pojawia się w dokumentacji zamówień publicznych, a poważne naruszenia potrafią zadecydować o odrzuceniu oferty. To najczęstszy powód, dla którego trafiają do nas firmy prywatne.' },
  { n: '03', t: 'Sprzedaż konsumentom online', d: 'Regulacje unijne dotyczące dostępności produktów i usług cyfrowych stopniowo obejmują e-commerce i usługi elektroniczne. Zakres i terminy zależą od rodzaju działalności i wielkości firmy — warto sprawdzić własną sytuację u prawnika, a nie zakładać, że temat nie dotyczy.' },
];

const faq = [
  { q: 'Ile kosztuje audyt dostępności?', a: `Od ${zl(400)} przy prostej stronie wizytówkowej do ${zl(1500)} przy rozbudowanym serwisie albo sklepie. Cena zależy od liczby unikalnych szablonów do sprawdzenia, a nie od liczby podstron — dziesięć podstron zbudowanych na tym samym układzie sprawdza się raz.` },
  { q: 'Czy narzędzia automatyczne wystarczą?', a: 'Nie. Wykrywają szacunkowo około jednej trzeciej naruszeń — te mierzalne, jak kontrast czy brakujące etykiety. Nie ocenią, czy opis alternatywny ma sens, czy kolejność treści jest logiczna ani czy komunikat błędu w formularzu jest zrozumiały. Dlatego każdy nasz raport przechodzi przez ręczną weryfikację, w której usuwamy też fałszywe alarmy.' },
  { q: 'Czy dostępność zmusi nas do brzydkiej strony?', a: 'Nie i to jest najczęstszy mit w tym temacie. Dostępność oznacza wystarczający kontrast tekstu, sensowną strukturę nagłówków i to, że po stronie da się poruszać klawiszem Tab. Żadna z tych rzeczy nie ogranicza projektu graficznego — ogranicza wyłącznie sięganie po jasnoszary tekst na białym tle.' },
  { q: 'Ile kosztuje naprawa znalezionych błędów?', a: 'Przy istniejącej stronie zwykle kilka do kilkunastu godzin pracy. Najwięcej czasu zajmuje kontrast, bo dotyka całej palety kolorów, i formularze, bo często trzeba je przebudować, a nie tylko poprawić. Przy stronie budowanej od zera dostępność praktycznie nic nie kosztuje — pod warunkiem że pomyśli się o niej na etapie projektu.' },
  { q: 'Czy dostępność pomaga w SEO?', a: 'Pośrednio, ale realnie. Poprawna struktura nagłówków, opisy alternatywne obrazków i sensowne nazwy linków to jednocześnie wymogi dostępności i sygnały, z których korzysta wyszukiwarka. Robot Google porusza się po stronie w sposób bardzo podobny do czytnika ekranu.' },
  { q: 'Czy wystawiacie dokument potwierdzający?', a: 'Wystawiamy raport opisujący stan strony wobec wytycznych WCAG na poziomie AA wraz z listą naruszeń i rekomendacjami. Nie jest to certyfikat ani opinia prawna — deklarację dostępności, jeśli jest wymagana, przygotowuje podmiot na podstawie takiego raportu.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Audyt dostępności cyfrowej WCAG',
  name: 'Audyt dostępności strony internetowej (WCAG 2.1)',
  description: 'Audyt dostępności strony według wytycznych WCAG 2.1 na poziomie AA — kontrasty, opisy alternatywne, formularze, obsługa klawiaturą.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'Country', name: 'Polska' },
  url: 'https://ctrlzstudio.pl/audyt-dostepnosci-wcag',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Usługi', item: 'https://ctrlzstudio.pl/uslugi' },
    { '@type': 'ListItem', position: 3, name: 'Audyt dostępności WCAG', item: 'https://ctrlzstudio.pl/audyt-dostepnosci-wcag' },
  ],
};
---

<Layout
  title="Audyt dostępności strony — WCAG 2.1 | CtrlZ Studio"
  description="Audyt dostępności według WCAG 2.1 na poziomie AA: kontrasty, opisy alternatywne, formularze i obsługa klawiaturą. Raport z rekomendacjami, od 400 zł."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-crumbs { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 18px; }
  .srv-crumbs a { color: rgba(255,255,255,.68); text-decoration: none; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.64); line-height: 1.75; max-width: 740px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.84); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip { font-size: 12px; padding: 7px 16px; border-radius: 100px; background: rgba(110,231,168,.09); border: 1px solid rgba(110,231,168,.28); color: #6ee7a8; }
  .srv-section { padding: 68px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.64); line-height: 1.8; max-width: 780px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07); border-radius: 16px; padding: 26px; transition: border-color .25s, transform .25s; }
  .srv-card:hover { border-color: rgba(110,231,168,.28); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 820px; margin-top: 32px; }
  .srv-step { display: flex; gap: 22px; align-items: flex-start; padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .srv-step-n { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: #6ee7a8; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85; }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid { grid-template-columns: 1fr; }
    .srv-hero { padding: 120px 0 48px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-3"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="srv-crumbs"><a href="/">Strona główna</a> · <a href="/uslugi">Usługi</a> · Audyt dostępności</div>
    <div class="eyebrow" style="margin-bottom:18px">Usługa</div>
    <h1 class="display-xl" style="margin-bottom:20px">Audyt dostępności<br>strony <span class="grad">WCAG 2.1</span></h1>
    <p class="srv-lead">
      Sprawdzamy, czy z Waszej strony może skorzystać także osoba, która nie widzi ekranu,
      nie używa myszy albo słabo rozróżnia kolory. <strong>Raport z listą naruszeń, priorytetami
      i konkretnymi rekomendacjami</strong> — na poziomie AA, czyli tym, do którego odwołują się regulacje.
    </p>
    <div class="srv-chips">
      <span class="srv-chip">Poziom AA</span>
      <span class="srv-chip">Testy automatyczne i ręczne</span>
      <span class="srv-chip">Od 400 zł</span>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Kogo to <span class="grad-v">realnie dotyczy</span></h2>
    <div class="srv-steps">
      {komu.map((k) => (
        <div class="srv-step">
          <div class="srv-step-n">{k.n}</div>
          <div><h3>{k.t}</h3><p>{k.d}</p></div>
        </div>
      ))}
    </div>
    <p class="srv-p" style="margin-top:28px">
      Poza obowiązkiem jest argument prostszy: <strong>część tych poprawek zwiększa czytelność dla wszystkich</strong>.
      Zbyt jasny szary tekst jest problemem nie tylko dla osoby słabowidzącej, ale też dla każdego,
      kto czyta ofertę na telefonie w pełnym słońcu.
    </p>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co dostajecie<br>w <span class="grad">raporcie</span></h2>
    <div class="srv-grid">
      {obszary.map((o) => <div class="srv-card"><h3>{o.t}</h3><p>{o.d}</p></div>)}
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Dlaczego nie wystarczy<br><span class="grad-v">przepuścić strony przez skaner</span></h2>
    <p class="srv-p">
      Bo skaner wykrywa szacunkowo jedną trzecią naruszeń i przy okazji zgłasza rzeczy,
      które w kontekście są w porządku. <strong>Raport złożony z surowego wyniku narzędzia potrafi
      wysłać Was w kilkugodzinną naprawę czegoś, co nikomu nie przeszkadzało</strong> — i jednocześnie
      pominąć problem blokujący wysłanie formularza.
    </p>
    <p class="srv-p">
      Jeśli chcecie zrobić pierwszy przegląd samodzielnie, opisaliśmy to krok po kroku
      w poradniku <a href="/blog/audyt-dostepnosci-wcag-strony-firmowej" style="color:#6ee7a8">audyt dostępności strony</a>.
      Ta usługa zaczyna się tam, gdzie tamten poradnik się kończy.
    </p>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
    <p class="srv-p" style="margin-top:26px;font-size:13.5px">
      Powyższe informacje mają charakter techniczny i nie stanowią porady prawnej.
      Zakres obowiązków zależy od rodzaju działalności — w razie wątpliwości warto skonsultować to z prawnikiem.
    </p>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Sprawdźmy, na czym <span class="grad">stoicie</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">
      Podajcie adres strony. Jeśli zależy Wam tylko na szybkiej orientacji, zacznijcie od bezpłatnego audytu —
      obejmuje też podstawowe testy dostępności.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Zamów audyt WCAG</span></a>
      <a href="/bezplatny-audyt" class="btn-ghost"><span>Zacznij od bezpłatnego</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/audyt-strony" style="color:#6ee7a8">pełny audyt strony</a> ·
      <a href="/audyt-seo" style="color:#6ee7a8">audyt SEO</a> ·
      <a href="/blog/audyt-dostepnosci-wcag-strony-firmowej" style="color:#6ee7a8">poradnik o dostępności</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();
  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
