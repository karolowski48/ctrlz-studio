---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  {
    q: 'Ile kosztuje strona internetowa dla firmy z Wadowic?',
    a: priceAnswer('Wadowic'),
  },
  {
    q: 'Co jeszcze można dobrać do projektu?',
    a: addonsAnswer(),
  },
  {
    q: 'Prowadzę pensjonat / obiekt turystyczny. Potrzebuję systemu rezerwacji?',
    a: 'Zależy od skali. Przy kilku pokojach zwykle wystarczy dobrze zaprojektowany formularz zapytania i widoczna dostępność — system rezerwacji online kosztuje więcej, niż zwraca. Przy większym obiekcie albo gdy obsługa telefonów zaczyna zajmować pół dnia, integracja z silnikiem rezerwacyjnym zaczyna się opłacać. Doradzimy uczciwie, bo sprzedanie Wam niepotrzebnego modułu nie jest w naszym interesie.',
  },
  {
    q: 'Czy strona może być w kilku językach?',
    a: 'Tak i w Wadowicach ma to realny sens — przez miasto przewija się dużo ruchu pielgrzymkowego i turystycznego z zagranicy. Wersja angielska to zwykle kilkanaście procent do wyceny. Robimy to poprawnie technicznie: osobne adresy dla każdej wersji i znaczniki hreflang, żeby Google wiedział, komu którą pokazać.',
  },
  {
    q: 'Jak daleko macie do Wadowic?',
    a: 'Studio mamy w Izdebniku przy ulicy Dworskiej — do Wadowic jest stąd około dwudziestu minut. Na spotkanie podjedziemy do Was, do Kalwarii, Andrychowa czy Kalwarii Zebrzydowskiej też bez problemu.',
  },
  {
    q: 'Czy pomożecie w pozycjonowaniu na frazy z Wadowicami?',
    a: 'Tak, to część każdego projektu. Konfigurujemy dane strukturalne LocalBusiness, budujemy strukturę podstron pod poszczególne usługi, zgłaszamy witrynę do Search Console i pomagamy uporządkować wizytówkę Google. Nie obiecujemy pierwszego miejsca — nikt uczciwy tego nie obiecuje — ale przygotowujemy stronę tak, żeby miała czym konkurować.',
  },
  {
    q: 'Na kogo będzie zarejestrowana domena?',
    a: 'Na Was. Dostępy do hostingu i panelu przekazujemy w komplecie po wdrożeniu. Strona jest Waszą własnością i możecie ją w każdej chwili przenieść gdzie indziej.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: {
    '@type': 'City',
    name: 'Wadowice',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'powiat wadowicki, województwo małopolskie' },
  },
  url: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-wadowice',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Tworzenie stron internetowych — Wadowice', item: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-wadowice' },
  ],
};
---

<Layout
  title="Tworzenie stron internetowych Wadowice | CtrlZ Studio"
  description="Strony internetowe dla firm z Wadowic, Andrychowa, Kalwarii Zebrzydowskiej i powiatu wadowickiego. Projektowanie, kodowanie, sklepy i SEO lokalne."
>
<SharedNav />

<main id="main-content">

<style>
  .loc-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .loc-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .loc-h1 { margin-bottom: 20px; }
  .loc-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .loc-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }

  .loc-quick { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .loc-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(14,165,233,.1); border: 1px solid rgba(14,165,233,.26);
    color: #7dd3fc;
  }

  .loc-section { padding: 72px 0; background: var(--bg-base); }
  .loc-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .loc-h2 { margin-bottom: 18px; }
  .loc-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .loc-p strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .loc-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .loc-card:hover { border-color: rgba(14,165,233,.28); transform: translateY(-2px); }
  .loc-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .loc-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }

  .loc-real { display: grid; grid-template-columns: repeat(2,1fr); gap: 18px; margin-top: 34px; max-width: 900px; }
  .loc-real-card {
    display: block; text-decoration: none; padding: 26px;
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.08);
    border-radius: 18px; transition: border-color .25s, transform .25s;
  }
  .loc-real-card:hover { border-color: rgba(14,165,233,.4); transform: translateY(-3px); }
  .loc-real-city {
    display: inline-block; font-size: 11px; letter-spacing: .1em; text-transform: uppercase;
    color: #7dd3fc; background: rgba(14,165,233,.1); border: 1px solid rgba(14,165,233,.28);
    padding: 4px 11px; border-radius: 100px; margin-bottom: 12px;
  }
  .loc-real-card h3 { font-family: var(--font-display); font-size: 17px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .loc-real-card p { font-size: 14px; color: rgba(255,255,255,.66); line-height: 1.7; margin: 0 0 14px; }
  .loc-real-go { font-size: 13px; color: #7dd3fc; font-weight: 500; }
  @media (max-width: 860px) { .loc-real { grid-template-columns: 1fr; } }
  .loc-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .loc-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .loc-list li::before { content: '→'; position: absolute; left: 0; color: #0ea5e9; font-size: 14px; }
  .loc-list strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-villages { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.9; max-width: 820px; margin-top: 18px; }

  @media (max-width: 1024px) { .loc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .loc-inner { padding: 0 24px; }
    .loc-grid { grid-template-columns: 1fr; }
    .loc-hero { padding: 120px 0 48px; }
  }
</style>

<!-- HERO -->
<section class="loc-hero">
  <div class="orb orb-3"></div>
  <div class="grid-bg"></div>
  <div class="loc-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Wadowice i powiat wadowicki</div>
    <h1 class="display-xl loc-h1">
      Tworzenie stron<br>
      internetowych<br>
      <span class="grad">Wadowice</span>
    </h1>
    <p class="loc-lead">
      Projektowanie i tworzenie stron internetowych dla firm z Wadowic, Andrychowa,
      Kalwarii Zebrzydowskiej i całego powiatu. <strong>Jesteśmy z Izdebnika —
      z tego samego powiatu, dwadzieścia minut od Was.</strong>
      Robimy strony internetowe szybkie, dobrze wyglądające i przygotowane pod wyszukiwania lokalne.
    </p>
    <div class="loc-quick">
      <span class="loc-chip">Strony firmowe</span>
      <span class="loc-chip">Turystyka i gastronomia</span>
      <span class="loc-chip">Sklepy internetowe</span>
      <span class="loc-chip">Wersje obcojęzyczne</span>
    </div>
  </div>
</section>

<!-- REALIZACJE Z POWIATU -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Firmy z Wadowic i powiatu,<br>dla których <span class="grad">już pracowaliśmy</span></h2>
    <p class="loc-p">
      Nie piszemy „obsługujemy powiat wadowicki" na wyrost. Poniżej konkretne projekty —
      możecie wejść na te strony i sprawdzić, jak działają.
    </p>

    <div class="loc-real">
      <a href="/realizacje/wypozyczalnia-wadowice" class="loc-real-card">
        <div class="loc-real-city">Wadowice</div>
        <h3>Wypożyczalnia sprzętu budowlanego</h3>
        <p>Sklep, audyt istniejącej strony, SEO lokalne, Search Console i wizytówka Google. Branża, w której cały popyt zaczyna się od wyszukiwarki.</p>
        <span class="loc-real-go">Zobacz realizację →</span>
      </a>
      <a href="/realizacje/domki-4-zywioly" class="loc-real-card">
        <div class="loc-real-city">Wadowice</div>
        <h3>Domki 4 Żywioły</h3>
        <p>Obiekt na wynajem krótkoterminowy — prezentacja domków, galeria i ścieżka prowadząca gościa do rezerwacji bezpośredniej zamiast przez portal.</p>
        <span class="loc-real-go">Zobacz realizację →</span>
      </a>
      <a href="/realizacje/ayra-jubiler" class="loc-real-card">
        <div class="loc-real-city">Wadowice</div>
        <h3>Ayra Jubiler</h3>
        <p>Od landing page'a prezentującego markę po pełny sklep internetowy. Przykład projektu, który rósł razem z firmą.</p>
        <span class="loc-real-go">Zobacz realizację →</span>
      </a>
      <a href="/realizacje/beskid-stolarstwo" class="loc-real-card">
        <div class="loc-real-city">Andrychów · powiat wadowicki</div>
        <h3>Beskid Stolarstwo</h3>
        <p>Katalog produktowy z zapytaniem o wycenę, dane strukturalne firmy lokalnej i wizytówka Google spięta ze stroną.</p>
        <span class="loc-real-go">Zobacz realizację →</span>
      </a>
    </div>

    <p class="loc-p" style="margin-top:26px">
      Pełne portfolio jest na stronie <a href="/realizacje" style="color:#0ea5e9">realizacje</a>.
    </p>
  </div>
</section>

<!-- STRONY INTERNETOWE WADOWICE -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Strony internetowe <span class="grad">Wadowice</span> —<br>od czego zacząć</h2>
    <p class="loc-p">
      <strong>Strony internetowe Wadowice</strong> to zapytanie, które wpisuje kilkadziesiąt firm z powiatu miesięcznie —
      i prawie każda z nich zaczyna rozmowę od pytania o cenę, a powinna od pytania, co ta strona ma robić.
      Firma z Wadowic sprzedająca usługi lokalnie potrzebuje czegoś innego niż producent wysyłający
      towar w całą Polskę — i to rozstrzyga zarówno układ strony, jak i wycenę.
      Dlatego projektowanie stron internetowych zaczynamy u nas od rozmowy o tym, skąd realnie
      przychodzą Wasi klienci, a nie od wyboru szablonu.</p>
    <p class="loc-p">
    </p>
    <p class="loc-p">
      Zebraliśmy najczęstsze pytania w trzech osobnych tekstach, żeby nie trzeba było dzwonić po podstawy:
    </p>
    <ul class="loc-list">
      <li><a href="/blog/ile-kosztuje-strona-internetowa-wadowice" style="color:#c4b5fd">Ile kosztuje strona internetowa w Wadowicach</a> — widełki, przykładowe wyceny i koszty utrzymania</li>
      <li><a href="/blog/strona-internetowa-dla-firmy-z-wadowic" style="color:#c4b5fd">Co powinna mieć strona firmy z Wadowic</a> — dziewięć elementów, które decydują o zapytaniach</li>
      <li><a href="/pozycjonowanie-stron-wadowice" style="color:#0ea5e9">Pozycjonowanie stron Wadowice</a> — jak zdobyć widoczność w powiecie i czym różni się to od SEO w Krakowie</li>
      <li><a href="/blog/nowa-strona-czy-przebudowa" style="color:#c4b5fd">Nowa strona czy przebudowa obecnej</a> — kiedy naprawa się opłaca, a kiedy jest wyrzucaniem pieniędzy</li>
    </ul>
    <p class="loc-p">
      Jeśli macie już stronę i chcecie wiedzieć, co ją blokuje, zacznijcie od
      <a href="/bezplatny-audyt" style="color:#c4b5fd">bezpłatnego audytu</a> — raport wraca w 48 godzin.
    </p>
  </div>
</section>

<!-- SPECYFIKA -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Wadowice mają coś,<br>czego nie ma <span class="grad-v">reszta powiatu</span></h2>
    <p class="loc-p">
      Ruch turystyczny. Przez miasto przewijają się ludzie z całej Polski i zza granicy,
      a to zmienia zasady gry dla lokalnych firm. <strong>Klient turystyczny nie zapyta sąsiada
      o polecenie — on wyciąga telefon i wpisuje w Google.</strong> Jeśli Waszej firmy tam nie ma,
      dla niego po prostu nie istniejecie.
    </p>
    <p class="loc-p">
      Dotyczy to nie tylko gastronomii i noclegów. Ktoś, komu zepsuje się auto w drodze,
      szuka warsztatu przez telefon. Ktoś, kto kupił dom w okolicy, szuka ekipy remontowej tak samo.
      W Wadowicach udział wyszukiwań w pozyskiwaniu klientów jest wyraźnie wyższy niż
      w mniejszych miejscowościach powiatu.
    </p>
    <p class="loc-p">
      Druga rzecz to konkurencja. Wadowice są największym ośrodkiem w powiecie,
      więc firm w każdej branży jest sporo — i część z nich ma już porządne strony.
      To nie jest rynek, gdzie wystarczy „mieć stronę". Tutaj trzeba mieć lepszą
      niż trzy firmy obok. Za to gminy dookoła — Kalwaria, Lanckorona, Brzeźnica, Tomice —
      są nadal praktycznie puste i tam wejście jest łatwe.
    </p>
  </div>
</section>

<!-- CO ROBIMY -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Co robimy dla firm<br>z <span class="grad">Wadowic</span></h2>
    <div class="loc-grid">
      <div class="loc-card">
        <h3>Strony firmowe</h3>
        <p>Od wizytówki po rozbudowany serwis z katalogiem usług i blogiem. Projekt graficzny tworzony pod Waszą markę, nie szablon kupiony za dwie stówy.</p>
      </div>
      <div class="loc-card">
        <h3>Obiekty turystyczne i gastronomia</h3>
        <p>Pensjonaty, restauracje, kawiarnie. Menu, galeria, godziny, mapa i rezerwacja — z naciskiem na telefon, bo stamtąd przychodzi większość ruchu.</p>
      </div>
      <div class="loc-card">
        <h3>Sklepy internetowe</h3>
        <p>WooCommerce albo rozwiązanie pisane od zera. Płatności, kurierzy, integracja z magazynem i systemem księgowym.</p>
      </div>
      <div class="loc-card">
        <h3>Wersje obcojęzyczne</h3>
        <p>Angielska, niemiecka, włoska. Osobne adresy i znaczniki hreflang, żeby Google pokazywał właściwą wersję właściwemu odbiorcy.</p>
      </div>
      <div class="loc-card">
        <h3>SEO lokalne</h3>
        <p>Dane strukturalne, wizytówka Google, strategia fraz i podstrony pod poszczególne usługi. Ta część decyduje, czy ktokolwiek stronę znajdzie.</p>
      </div>
      <div class="loc-card">
        <h3>Audyt i przyspieszanie</h3>
        <p>Macie stronę, ale nie przynosi zapytań? Sprawdzamy szybkość, konfigurację techniczną i widoczność, a potem mówimy, co da się poprawić bez pisania wszystkiego od nowa.</p>
      </div>
    </div>
  </div>
</section>

<!-- JAK PRACUJEMY -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Jak wygląda <span class="grad-v">współpraca</span></h2>
    <ul class="loc-list">
      <li><strong>Rozmowa.</strong> Telefon albo spotkanie u Was w Wadowicach. Pytamy o branżę, konkurencję i o to, skąd dziś przychodzą klienci — bez tego nie da się zaprojektować niczego sensownego.</li>
      <li><strong>Wycena.</strong> Konkretna kwota i zakres na piśmie, zgodne z <a href="/kalkulator" style="color:#c4b5fd">kalkulatorem</a>. Cena jest wiążąca.</li>
      <li><strong>Projekt graficzny.</strong> Makiety wersji desktop i mobilnej, dwie rundy poprawek w cenie, akceptacja przed kodowaniem.</li>
      <li><strong>Kodowanie.</strong> Celujemy w wynik powyżej 90 w PageSpeed na telefonie — przy ruchu turystycznym, w dużej części z komórek, to nie jest kosmetyka.</li>
      <li><strong>SEO i wdrożenie.</strong> Dane strukturalne, mapa witryny, Search Console, Analytics, SSL. Domena rejestrowana na Was, dostępy przekazane w komplecie.</li>
      <li><strong>Po starcie.</strong> Gwarancja na błędy techniczne i ustalona z góry stawka za późniejsze zmiany.</li>
    </ul>
  </div>
</section>

<!-- OBSZAR -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Gdzie <span class="grad">pracujemy</span></h2>
    <p class="loc-p">
      Biuro mamy w Izdebniku w gminie Lanckorona — to ten sam powiat wadowicki,
      około dwudziestu minut od Wadowic. Obsługujemy miasto i całą okolicę:
    </p>
    <p class="loc-villages">
      Wadowice · Andrychów · Kalwaria Zebrzydowska · Lanckorona · Izdebnik · Brzeźnica ·
      Tomice · Spytkowice · Stryszów · Mucharz · Wieprz · Zator · Kęty · Choczni ·
      Barwałd · Stanisław Dolny · Klecza Dolna · Gorzeń
    </p>
    <p class="loc-p" style="margin-top:24px">
      Pracujemy też zdalnie w całej Polsce, ale przy firmach z powiatu możliwość
      spotkania na miejscu realnie zmienia jakość projektu.
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner" style="text-align:center">
    <h2 class="display-md loc-h2">Zróbmy stronę,<br>która <span class="grad">przynosi zapytania</span></h2>
    <p class="loc-p" style="margin:0 auto 32px">
      Pierwsza rozmowa jest bezpłatna i niezobowiązująca. Powiemy wprost,
      czego Wasza firma potrzebuje, a czego nie warto kupować.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="loc-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/realizacje" style="color:#c4b5fd">nasze realizacje</a> ·
      <a href="/blog/lokalne-seo-dla-firm-z-malopolski" style="color:#c4b5fd">lokalne SEO krok po kroku</a> ·
      <a href="/tworzenie-stron-internetowych-myslenice" style="color:#c4b5fd">strony WWW w Myślenicach</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
