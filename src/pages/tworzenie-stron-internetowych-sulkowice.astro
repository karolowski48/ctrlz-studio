---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  {
    q: 'Ile kosztuje strona internetowa dla firmy z Sułkowic?',
    a: priceAnswer('Sułkowic'),
  },
  {
    q: 'Co jeszcze można dobrać do projektu?',
    a: addonsAnswer(),
  },
  {
    q: 'Jestem rzemieślnikiem, nie znam się na internecie. Poradzę sobie?',
    a: 'Tak — i nie musicie się na tym znać. Naszym zadaniem jest zdjąć to z Was, a nie zasypać żargonem. Tłumaczymy każdą decyzję zwykłym językiem, a po wdrożeniu przekazujemy krótką instrukcję i zostajemy pod telefonem. Jeśli nie chcecie nic samodzielnie edytować, obsługujemy stronę za Was.',
  },
  {
    q: 'Czy możemy się spotkać na miejscu?',
    a: 'Jasne. Jesteśmy w Izdebniku, do Sułkowic mamy około dziesięciu minut. Przy pierwszym projekcie spotkanie zwykle bardzo pomaga — łatwiej opowiedzieć o firmie na miejscu niż przez telefon. Możemy podjechać też do Biertowic, Harbutowic, Krzywaczki czy Rudnika.',
  },
  {
    q: 'Mam już stronę, ale nikt jej nie znajduje. Da się to naprawić?',
    a: 'Najczęściej tak i często bez przepisywania wszystkiego. Zaczynamy od audytu: sprawdzamy szybkość, konfigurację techniczną, dane strukturalne, wizytówkę Google i to, na jakie frazy strona w ogóle się wyświetla. Bardzo często problem nie leży w wyglądzie, tylko w tytułach stron i braku podstawowej konfiguracji SEO.',
  },
  {
    q: 'Potrzebuję zdjęć swoich realizacji — robicie sesje?',
    a: 'Pomagamy to zorganizować. Przy mniejszych budżetach uczciwie mówimy, że dobre zdjęcia z telefonu zrobione w dobrym świetle są w zupełności wystarczające — i podpowiadamy, jak je zrobić. Przy większych projektach współpracujemy z fotografem.',
  },
  {
    q: 'Na kogo będzie zarejestrowana domena?',
    a: 'Na Was, zawsze. Dostępy do hostingu i panelu przekazujemy w komplecie po wdrożeniu. Strona jest Waszą własnością i możecie ją w każdej chwili przenieść gdziekolwiek — bez pytania nas o zgodę.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: {
    '@type': 'City',
    name: 'Sułkowice',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'powiat myślenicki, województwo małopolskie' },
  },
  url: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-sulkowice',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Tworzenie stron internetowych — Sułkowice', item: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-sulkowice' },
  ],
};
---

<Layout
  title="Tworzenie stron internetowych Sułkowice | CtrlZ Studio"
  description="Strony internetowe dla firm z Sułkowic, Biertowic, Harbutowic, Krzywaczki i Rudnika. Projektowanie, kodowanie i SEO lokalne."
>
<SharedNav />

<main id="main-content">

<style>
  .loc-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .loc-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .loc-h1 { margin-bottom: 20px; }
  .loc-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .loc-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }

  .loc-quick { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .loc-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(34,197,94,.1); border: 1px solid rgba(34,197,94,.24);
    color: #86efac;
  }

  .loc-section { padding: 72px 0; background: var(--bg-base); }
  .loc-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .loc-h2 { margin-bottom: 18px; }
  .loc-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .loc-p strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .loc-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .loc-card:hover { border-color: rgba(34,197,94,.26); transform: translateY(-2px); }
  .loc-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .loc-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }

  .loc-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .loc-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .loc-list li::before { content: '→'; position: absolute; left: 0; color: #22c55e; font-size: 14px; }
  .loc-list strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-villages { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.9; max-width: 820px; margin-top: 18px; }

  @media (max-width: 1024px) { .loc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .loc-inner { padding: 0 24px; }
    .loc-grid { grid-template-columns: 1fr; }
    .loc-hero { padding: 120px 0 48px; }
  }
</style>

<!-- HERO -->
<section class="loc-hero">
  <div class="orb orb-2"></div>
  <div class="grid-bg"></div>
  <div class="loc-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Sułkowice i gmina</div>
    <h1 class="display-xl loc-h1">
      Tworzenie stron<br>
      internetowych<br>
      <span class="grad-v">Sułkowice</span>
    </h1>
    <p class="loc-lead">
      Robimy strony WWW dla firm, zakładów i rzemieślników z Sułkowic, Biertowic,
      Harbutowic, Krzywaczki i Rudnika. <strong>Jesteśmy z Izdebnika — dziesięć minut drogi.</strong>
      Znamy ten rynek, bo sami z niego jesteśmy.
    </p>
    <div class="loc-quick">
      <span class="loc-chip">Strony firmowe</span>
      <span class="loc-chip">Wizytówki dla rzemiosła</span>
      <span class="loc-chip">SEO lokalne</span>
      <span class="loc-chip">Opieka nad stroną</span>
    </div>
  </div>
</section>

<!-- SPECYFIKA -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Sułkowice mają<br><span class="grad">rzemiosło i renomę</span> —<br>brakuje im widoczności</h2>
    <p class="loc-p">
      Sułkowice od pokoleń kojarzą się z kowalstwem i obróbką metalu. To miejsce,
      gdzie firmy budowały pozycję jakością roboty i poleceniami, a nie reklamą.
      <strong>I dokładnie w tym tkwi dziś problem.</strong>
    </p>
    <p class="loc-p">
      Renoma działa w promieniu kilku kilometrów. Klient z Myślenic, Skawiny czy Krakowa,
      który potrzebuje dokładnie tego, co robicie, nie ma jak się o Was dowiedzieć —
      bo nikt mu Was nie poleci, a w Google Was nie ma. Wpisuje więc frazę,
      trafia do firmy, która zainwestowała w stronę, i to ona dostaje zlecenie.
      Nie dlatego, że robi lepiej. Dlatego, że jest widoczna.
    </p>
    <p class="loc-p">
      Dobra wiadomość jest taka, że w Sułkowicach konkurencja w internecie jest minimalna.
      Wystarczy uzupełniona wizytówka Google i porządna strona, żeby być pierwszym wyborem
      dla każdego, kto szuka Waszej usługi w okolicy. To przewaga, którą dziś można kupić tanio —
      za dwa, trzy lata będzie to kosztować wielokrotnie więcej.
    </p>
  </div>
</section>

<!-- CO ROBIMY -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Co możemy dla Was<br><span class="grad-v">zrobić</span></h2>
    <div class="loc-grid">
      <div class="loc-card">
        <h3>Wizytówka firmowa</h3>
        <p>Najczęstszy wybór małych zakładów. Kilka podstron, zdjęcia realizacji, klikalny telefon, mapa dojazdu. Prosto, szybko, bez zbędnych bajerów.</p>
      </div>
      <div class="loc-card">
        <h3>Strona z katalogiem usług</h3>
        <p>Osobna podstrona pod każdą usługę, którą wykonujecie. Każda walczy w Google o inną frazę — to działa znacznie lepiej niż jedna strona o wszystkim.</p>
      </div>
      <div class="loc-card">
        <h3>Galeria realizacji</h3>
        <p>W rzemiośle zdjęcia sprzedają lepiej niż każdy opis. Robimy galerię, która ładuje się szybko i dobrze wygląda na telefonie.</p>
      </div>
      <div class="loc-card">
        <h3>Wizytówka Google</h3>
        <p>Zakładamy albo porządkujemy profil, ustawiamy kategorie i obszar działania, pokazujemy, jak zbierać opinie. Dla lokalnej firmy to często ważniejsze niż sama strona.</p>
      </div>
      <div class="loc-card">
        <h3>Naprawa istniejącej strony</h3>
        <p>Macie stronę sprzed lat, która się nie otwiera na telefonie albo ładuje wieczność? Zwykle da się to naprawić taniej, niż zrobić wszystko od nowa.</p>
      </div>
      <div class="loc-card">
        <h3>Sklep internetowy</h3>
        <p>Jeśli sprzedajecie wyroby, warto sprzedawać je też online. Doradzamy, czy w Waszym przypadku sklep ma sens — czasem uczciwiej powiedzieć, że nie.</p>
      </div>
    </div>
  </div>
</section>

<!-- DLA KOGO -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Dla kogo pracujemy<br>w <span class="grad">okolicy</span></h2>
    <ul class="loc-list">
      <li><strong>Zakłady rzemieślnicze i produkcyjne</strong> — kowalstwo, ślusarstwo, obróbka metalu, stolarstwo. Strona pokazująca realizacje robi tu największą różnicę.</li>
      <li><strong>Firmy budowlane i wykończeniowe</strong> — gdzie klient przed zleceniem chce zobaczyć, co już zrobiliście.</li>
      <li><strong>Usługi dla mieszkańców</strong> — warsztaty, gabinety, fryzjerstwo, kosmetyka. Tu decyduje wizytówka Google i opinie, strona je domyka.</li>
      <li><strong>Jednoosobowe działalności</strong> — elektryk, hydraulik, tynkarz, brukarz. Wystarczy prosta strona, żeby wyprzedzić konkurencję, która nie ma żadnej.</li>
      <li><strong>Firmy z ambicją wyjścia poza gminę</strong> — jeśli chcecie klientów z Krakowa czy Wadowic, strona przestaje być dodatkiem i staje się warunkiem.</li>
    </ul>
    <p class="loc-p" style="margin-top:28px">
      W <a href="/realizacje" style="color:#c4b5fd">naszych realizacjach</a> znajdziecie sporo firm
      dokładnie takiego typu — stolarstwo, siłownia, warsztat, firma konstrukcyjna.
      Wspólny mianownik jest zawsze ten sam: nie potrzebowały efektownej strony,
      tylko takiej, która pokazuje robotę i daje się znaleźć.
    </p>
  </div>
</section>

<!-- OBSZAR -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Gdzie <span class="grad-v">dojedziemy</span></h2>
    <p class="loc-p">
      Studio mamy w Izdebniku przy ulicy Dworskiej — do Sułkowic jest stąd około dziesięciu minut.
      Obsługujemy całą gminę i okoliczne miejscowości:
    </p>
    <p class="loc-villages">
      Sułkowice · Biertowice · Harbutowice · Krzywaczka · Rudnik · Izdebnik · Lanckorona ·
      Kalwaria Zebrzydowska · Brody · Stanisław Dolny · Myślenice · Skawina · Radziszów ·
      Brzeźnica · Wadowice · Trzebunia · Jasienica
    </p>
    <p class="loc-p" style="margin-top:24px">
      Na spotkanie możemy podjechać do Was — do zakładu, warsztatu albo biura.
      Przy pierwszym projekcie to zwykle najlepszy sposób, żeby zrozumieć,
      czym się naprawdę zajmujecie i co warto pokazać na stronie.
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Najczęstsze <span class="grad">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner" style="text-align:center">
    <h2 class="display-md loc-h2">Porozmawiajmy<br>o <span class="grad-v">Waszej stronie</span></h2>
    <p class="loc-p" style="margin:0 auto 32px">
      Pierwsza rozmowa nic nie kosztuje i do niczego nie zobowiązuje.
      Powiemy szczerze, co ma sens w Waszym przypadku — także wtedy,
      gdy naszym zdaniem strona się Wam nie opłaci.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="loc-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/blog/strona-internetowa-dla-firmy-z-malej-miejscowosci" style="color:#c4b5fd">czy mała firma potrzebuje strony</a> ·
      <a href="/blog/lokalne-seo-dla-firm-z-malopolski" style="color:#c4b5fd">lokalne SEO krok po kroku</a> ·
      <a href="/tworzenie-stron-internetowych-skawina" style="color:#c4b5fd">Skawina</a> ·
      <a href="/tworzenie-stron-internetowych-myslenice" style="color:#c4b5fd">Myślenice</a> ·
      <a href="/tworzenie-stron-internetowych-wadowice" style="color:#c4b5fd">Wadowice</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
