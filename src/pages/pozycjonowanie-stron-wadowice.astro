---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { PRICING } from '../data/pricing';

/**
 * POZYCJONOWANIE WADOWICE — fraza „pozycjonowanie stron internetowych wadowice"
 * (30/mies. wg Senuto), plus warianty lokalne.
 * ═══════════════════════════════════════════════════════════════════════════
 * Kanibalizacja: /pozycjonowanie-seo = usługa ogólna, ta = wyłącznie kontekst
 * lokalny powiatu wadowickiego. /tworzenie-stron-internetowych-wadowice
 * zostaje właścicielem fraz o tworzeniu stron.
 */

const zl = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} zł`;

const specyfika = [
  { t: 'Konkurencja jest mniejsza, niż myślicie', d: 'W Wadowicach i okolicznych miejscowościach o większość fraz usługowych walczy kilka firm, a nie kilkaset. Wejście do pierwszej trójki jest realne w kilka miesięcy — w Krakowie to samo zajęłoby lata i kosztowało wielokrotnie więcej.' },
  { t: 'Decyduje wizytówka Google', d: 'Przy zapytaniach lokalnych mapa wyświetla się nad wynikami organicznymi. Firma z kompletną wizytówką i zbieranymi opiniami dostaje telefony, zanim ktokolwiek dotrze do zwykłych wyników.' },
  { t: 'Liczy się okolica, nie samo miasto', d: 'Klienci wpisują też Andrychów, Kalwarię, Kęty, Brzeźnicę i Zator. Struktura strony powinna to obsługiwać, zamiast celować wyłącznie w jedno miasto.' },
  { t: 'Zapytania są krótkie i konkretne', d: 'Nie „gdzie znaleźć dobrego wykonawcę", tylko usługa plus nazwa miejscowości. Człowiek wpisujący takie zapytanie chce zadzwonić dziś, nie czytać poradnik.' },
  { t: 'Sezonowość bywa ostra', d: 'Budowlanka wiosną, obiekty noclegowe przed wakacjami, usługi grzewcze jesienią. Pozycje trzeba budować z wyprzedzeniem, bo w szczycie sezonu jest już za późno.' },
  { t: 'Ruch jest mniejszy, ale konwertuje lepiej', d: 'Dwadzieścia wejść miesięcznie z frazy lokalnej bywa warte więcej niż dwieście z ogólnopolskiej — bo to są ludzie, którzy realnie mogą u Was kupić.' },
];

const zakres = [
  { n: '01', t: 'Analiza fraz z okolicy', d: 'Sprawdzamy, czego naprawdę szukają klienci z powiatu — łącznie z zapytaniami o wolumenie tak niskim, że narzędzia pokazują przy nich zero, a Search Console i tak notuje z nich wyświetlenia.' },
  { n: '02', t: 'Struktura podstron', d: 'Osobna podstrona dla każdej głównej usługi i, tam gdzie ma to sens, dla miejscowości. To jest fundament, bez którego reszta pracy nie ma na czym stanąć.' },
  { n: '03', t: 'Optymalizacja techniczna', d: 'Tytuły i opisy, struktura nagłówków, dane strukturalne firmy lokalnej, mapa witryny, szybkość na telefonie. Rzeczy nudne i rozstrzygające.' },
  { n: '04', t: 'Wizytówka Google', d: 'Uzupełnienie kategorii i usług, obszar działania, zdjęcia realizacji, regularne posty i proces zbierania opinii. Przy usługach lokalnych to często daje efekt szybciej niż sama strona.' },
  { n: '05', t: 'Treści', d: 'Opisy usług i realizacje z podaną miejscowością. Jedna realizacja z Wadowic w treści strony robi dla widoczności lokalnej więcej niż tysiąc słów ogólników.' },
  { n: '06', t: 'Pomiar', d: 'Search Console i Analytics, a w raportach liczba zapytań, nie same pozycje. Pierwsze miejsce na frazę o pięciu wyszukiwaniach miesięcznie nie jest sukcesem.' },
];

const faq = [
  { q: 'Ile kosztuje pozycjonowanie w Wadowicach?', a: `Jednorazowa konfiguracja — analiza fraz, struktura podstron, optymalizacja techniczna, wizytówka Google i plan treści — od ${zl(PRICING.addons.seoBasic)}. Stała obsługa miesięczna zaczyna się od około ${zl(1000)} i rośnie wraz z konkurencyjnością fraz. Przy małej firmie lokalnej często wystarcza wariant pierwszy plus samodzielne dokładanie treści.` },
  { q: 'Po jakim czasie zobaczę efekty?', a: 'Pierwsze wyświetlenia w Search Console po kilku tygodniach, realne pozycje po trzech do sześciu miesięcy. Przy frazach lokalnych o niskiej konkurencji bywa szybciej — widzieliśmy wejście do pierwszej trójki w okolicach drugiego miesiąca. Nikt uczciwy nie obieca konkretnej daty, bo na algorytm Google nikt nie ma wpływu.' },
  { q: 'Czy warto pozycjonować się na Kraków zamiast Wadowic?', a: 'Zwykle nie na starcie. Kraków to zupełnie inna liga konkurencyjna — walczycie z agencjami budującymi pozycje od lat i z budżetami, których mała firma nie ma. Sensowniejsza kolejność to zdobyć powiat, zbudować autorytet domeny, a dopiero potem celować wyżej.' },
  { q: 'Mam wizytówkę Google, czy strona jest mi w ogóle potrzebna?', a: 'Wizytówka świetnie obsługuje zapytania pilne — pokazuje się na mapie i daje kliknięcie w telefon. Nie obsłuży jednak klienta, który porównuje wykonawców i czyta o usłudze przed decyzją. Najlepiej działa jedno z drugim: wizytówka ściąga szybkie telefony, strona buduje zaufanie przy większych zleceniach.' },
  { q: 'Czy pozycjonujecie też firmy spoza powiatu?', a: 'Tak, pracujemy z firmami z całej Małopolski i spoza niej. Przy Wadowicach mamy natomiast przewagę, której nie kupi się za pieniądze: znamy ten rynek, mamy tu realizacje i sami jesteśmy z tego powiatu — z Izdebnika, dwadzieścia minut od Wadowic.' },
  { q: 'Co, jeśli moja strona jest stara i wolna?', a: 'Wtedy pozycjonowanie zacznie się od naprawy fundamentów, a nie od zdobywania pozycji — i warto o tym wiedzieć przed podpisaniem umowy. Czasem taniej wychodzi zbudowanie nowej strony niż comiesięczne opłacanie walki z ograniczeniami starej. Powiemy wprost, co się bardziej opłaca.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Pozycjonowanie stron internetowych',
  name: 'Pozycjonowanie stron internetowych — Wadowice i powiat wadowicki',
  description: 'Pozycjonowanie lokalne dla firm z Wadowic, Andrychowa, Kalwarii Zebrzydowskiej i powiatu. Struktura podstron, wizytówka Google, treści i pomiar zapytań.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: [
    { '@type': 'City', name: 'Wadowice' },
    { '@type': 'City', name: 'Andrychów' },
    { '@type': 'City', name: 'Kalwaria Zebrzydowska' },
    { '@type': 'AdministrativeArea', name: 'powiat wadowicki' },
  ],
  url: 'https://ctrlzstudio.pl/pozycjonowanie-stron-wadowice',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Pozycjonowanie SEO', item: 'https://ctrlzstudio.pl/pozycjonowanie-seo' },
    { '@type': 'ListItem', position: 3, name: 'Wadowice', item: 'https://ctrlzstudio.pl/pozycjonowanie-stron-wadowice' },
  ],
};
---

<Layout
  title="Pozycjonowanie stron internetowych Wadowice | CtrlZ Studio"
  description="Pozycjonowanie lokalne dla firm z Wadowic i powiatu. Struktura podstron, wizytówka Google, treści i raporty liczone w zapytaniach, nie w samych pozycjach."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-crumbs { font-size: 13px; color: rgba(255,255,255,.5); margin-bottom: 18px; }
  .srv-crumbs a { color: rgba(255,255,255,.68); text-decoration: none; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.64); line-height: 1.75; max-width: 740px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.84); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip { font-size: 12px; padding: 7px 16px; border-radius: 100px; background: rgba(14,165,233,.1); border: 1px solid rgba(14,165,233,.28); color: #7dd3fc; }
  .srv-section { padding: 68px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.64); line-height: 1.8; max-width: 780px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card { background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07); border-radius: 16px; padding: 26px; transition: border-color .25s, transform .25s; }
  .srv-card:hover { border-color: rgba(14,165,233,.3); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 820px; margin-top: 32px; }
  .srv-step { display: flex; gap: 22px; align-items: flex-start; padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07); }
  .srv-step-n { font-family: var(--font-display); font-size: 26px; font-weight: 800; color: #7dd3fc; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85; }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .prf { max-width: 860px; border: 1px solid rgba(14,165,233,.26); border-radius: 20px; padding: 32px; background: linear-gradient(135deg, rgba(14,165,233,.07), rgba(255,255,255,.02)); margin-top: 34px; }
  .prf h3 { font-family: var(--font-display); font-size: 19px; color: #fff; margin: 0 0 14px; font-weight: 600; }
  .prf p { font-size: 15px; color: rgba(255,255,255,.72); line-height: 1.8; margin: 0 0 12px; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid { grid-template-columns: 1fr; }
    .srv-hero { padding: 120px 0 48px; }
    .prf { padding: 24px 20px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-2"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="srv-crumbs"><a href="/">Strona główna</a> · <a href="/pozycjonowanie-seo">Pozycjonowanie SEO</a> · Wadowice</div>
    <div class="eyebrow" style="margin-bottom:18px">Wadowice i powiat wadowicki</div>
    <h1 class="display-xl" style="margin-bottom:20px">Pozycjonowanie stron<br>internetowych <span class="grad">Wadowice</span></h1>
    <p class="srv-lead">
      Widoczność w Google dla firm z Wadowic, Andrychowa, Kalwarii i całego powiatu.
      <strong>Bez kupowania linków i bez obiecywania pierwszego miejsca</strong> — za to z raportami,
      w których liczy się liczba zapytań, a nie same pozycje.
    </p>
    <div class="srv-chips">
      <span class="srv-chip">SEO lokalne</span>
      <span class="srv-chip">Wizytówka Google</span>
      <span class="srv-chip">Realizacje z powiatu</span>
      <span class="srv-chip">Od {zl(PRICING.addons.seoBasic)}</span>
    </div>
  </div>
</section>

<!-- DOWÓD -->
<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Zaczęliśmy od<br><span class="grad-v">własnej strony</span></h2>
    <div class="prf">
      <h3>Pierwsze pozycje w powiecie na własnych frazach</h3>
      <p>
        Zanim zaczęliśmy sprzedawać pozycjonowanie lokalne, zrobiliśmy je u siebie. Dziś na frazy
        łączące tworzenie stron z nazwami miejscowości z okolicy <strong>zajmujemy w Google pozycje
        z przedziału pierwszej trójki</strong> — między innymi w Sułkowicach i Krzywaczce.
      </p>
      <p>
        Po drodze nauczyliśmy się też rzeczy, o której mało kto mówi: wysoka pozycja bez dobrego tytułu
        w wynikach daje zero kliknięć. Sami mieliśmy frazę na drugim miejscu i ani jednego wejścia,
        bo tytuł nie mówił, czym się zajmujemy. Naprawa zajęła kwadrans.
      </p>
      <p style="font-size:13.5px;color:rgba(255,255,255,.55);margin-top:16px">
        Dane z Search Console ctrlzstudio.pl. Możecie sprawdzić te frazy sami.
      </p>
    </div>
  </div>
</section>

<!-- SPECYFIKA -->
<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Czym SEO w powiecie różni się<br>od <span class="grad">SEO w dużym mieście</span></h2>
    <div class="srv-grid">
      {specyfika.map((s) => <div class="srv-card"><h3>{s.t}</h3><p>{s.d}</p></div>)}
    </div>
  </div>
</section>

<!-- ZAKRES -->
<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co robimy<br>w ramach <span class="grad-v">pozycjonowania</span></h2>
    <div class="srv-steps">
      {zakres.map((z) => (
        <div class="srv-step">
          <div class="srv-step-n">{z.n}</div>
          <div><h3>{z.t}</h3><p>{z.d}</p></div>
        </div>
      ))}
    </div>
    <p class="srv-p" style="margin-top:28px">
      Modele rozliczeń i realne widełki cenowe rozpisaliśmy w tekście
      <a href="/blog/ile-kosztuje-pozycjonowanie-stron" style="color:#7dd3fc">ile kosztuje pozycjonowanie stron</a>.
      Jeśli zastanawiacie się nad reklamami zamiast SEO — porównanie jest
      <a href="/blog/seo-czy-google-ads-maly-budzet" style="color:#7dd3fc">tutaj</a>.
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="srv-section">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Sprawdźmy, gdzie jesteście<br><span class="grad">w Google</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">
      Podajcie adres strony i powiedzcie, na jakie usługi chcecie być znajdowani.
      Sprawdzimy, ile osób realnie tego szuka w powiecie, i powiemy wprost, czy warto w to wchodzić.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/kontakt" class="btn-primary"><span>Porozmawiajmy</span></a>
      <a href="/bezplatny-audyt" class="btn-ghost"><span>Zamów bezpłatny audyt</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">
      Zobacz też: <a href="/tworzenie-stron-internetowych-wadowice" style="color:#7dd3fc">tworzenie stron Wadowice</a> ·
      <a href="/pozycjonowanie-seo" style="color:#7dd3fc">pozycjonowanie SEO</a> ·
      <a href="/audyt-seo" style="color:#7dd3fc">audyt SEO</a> ·
      <a href="/realizacje/wypozyczalnia-wadowice" style="color:#7dd3fc">realizacja z Wadowic</a>
    </p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();
  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
