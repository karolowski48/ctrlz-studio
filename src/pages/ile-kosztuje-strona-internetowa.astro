<script define:vars={{ PRICING }}>
  // ── Uproszczony kalkulator ──────────────────────────────────────
  // Widełki pochodzą z src/data/pricing.ts (przekazane przez define:vars),
  // więc zmiana cennika w jednym miejscu aktualizuje też tę stronę.
  (function () {
    const state = { type: 'landing', size: 's', tech: 'wp' };

    const TABLE = {
      landing: [PRICING.landing, PRICING.landing * 1.2, PRICING.landing * 1.5],
      firmowa: [PRICING.firmowa.from, PRICING.firmowa.tier2, PRICING.firmowa.tier3],
      sklep:   [PRICING.sklep.from, PRICING.sklep.tier2, PRICING.sklep.tier3],
      custom:  [PRICING.custom, PRICING.custom * 1.5, PRICING.custom * 2.2],
    };
    const IDX = { s: 0, m: 1, l: 2 };

    const zl = (n) => String(Math.round(n / 100) * 100).replace(/\B(?=(\d{3})+(?!\d))/g, ' ') + ' zł';

    const val = document.getElementById('calc-val');
    const sizeRow = document.getElementById('calc-size-row');
    const techRow = document.getElementById('calc-tech-row');

    function render() {
      // Przy rozwiązaniu dedykowanym wielkość i technologia nie mają zastosowania —
      // taki projekt i tak pisany jest od zera, a zakres ustala się indywidualnie.
      const isCustom = state.type === 'custom';
      const base = TABLE[state.type][isCustom ? 0 : IDX[state.size]];
      const mult = !isCustom && state.tech === 'code' ? 1.6 : 1;
      const low = base * mult;
      const high = low * 1.3;
      if (val) val.textContent = `${zl(low)} – ${zl(high)}`;
      // przy rozwiązaniu dedykowanym wielkość jest umowna — chowamy, żeby nie mylić
      if (sizeRow) sizeRow.style.display = isCustom ? 'none' : '';
      if (techRow) techRow.style.display = isCustom ? 'none' : '';
    }

    function group(id, key) {
      const wrap = document.getElementById(id);
      if (!wrap) return;
      wrap.querySelectorAll('.calc-opt').forEach((btn) => {
        btn.addEventListener('click', () => {
          wrap.querySelectorAll('.calc-opt').forEach((b) => b.setAttribute('aria-pressed', 'false'));
          btn.setAttribute('aria-pressed', 'true');
          state[key] = btn.dataset.v;
          render();
        });
      });
    }

    group('calc-type', 'type');
    group('calc-size', 'size');
    group('calc-tech', 'tech');
    render();
  })();
</script>

<script>
  import { initPage } from '../utils/pageInit';
