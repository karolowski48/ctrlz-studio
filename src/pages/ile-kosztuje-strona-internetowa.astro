---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { PRICING, priceAnswer, addonsAnswer } from '../data/pricing';

/**
 * PODSTRONA CENOWA — największy klaster w Senuto (ok. 4 160 wyszukiwań/mies.)
 * ═════════════════════════════════════════════════════════════════════════
 * Cel: „strona internetowa cena" (1000), „tworzenie stron internetowych cennik" (320),
 * „ceny strony internetowe" (320), „cena strona internetowa" (210),
 * „tworzenie stron internetowych cena" (170), „prosta strona internetowa cena" (70),
 * „strona internetowa wordpress cena" (70), „strona internetowa wizytówka cena" (50).
 *
 * Kalkulator jest UPROSZCZONY i samodzielny — pełna wersja żyje w /kalkulator.
 * Widełki liczy z PRICING, więc zmiana cennika w jednym miejscu aktualizuje też tę stronę.
 */

const zl = (n: number) => `${String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ' ')} zł`;

const tiers = [
  {
    name: 'Landing page / wizytówka',
    price: `od ${zl(PRICING.landing)}`,
    who: 'Jednoosobowa działalność, usługa lokalna, kampania reklamowa.',
    what: ['Jedna dłuższa strona z sekcjami', 'Formularz kontaktowy', 'Podstawowa konfiguracja SEO', 'Wersja mobilna'],
    time: '2–3 tygodnie',
  },
  {
    name: 'Strona firmowa',
    price: `od ${zl(PRICING.firmowa.from)}`,
    who: 'Firma z kilkoma usługami, która chce być znajdowana w Google.',
    what: ['4–15 podstron', 'Panel do samodzielnej edycji', 'Blog albo aktualności', 'Pełna konfiguracja SEO i analityki'],
    time: '4–8 tygodni',
    highlight: true,
  },
  {
    name: 'Sklep internetowy',
    price: `od ${zl(PRICING.sklep.from)}`,
    who: 'Sprzedaż produktów online, integracje z płatnościami i kurierami.',
    what: ['Katalog produktów i koszyk', 'Płatności i wysyłka', 'Integracje z księgowością', 'Konfiguracja pod sprzedaż'],
    time: '6–12 tygodni',
  },
  {
    name: 'Rozwiązanie dedykowane',
    price: `od ${zl(PRICING.custom)}`,
    who: 'Konfigurator produktu, panel B2B, integracja z ERP.',
    what: ['Projekt pisany od zera', 'Nietypowe procesy i logika', 'Integracje z systemami firmy', 'Pełna dowolność funkcji'],
    time: 'od 8 tygodni',
  },
];

const factors = [
  { t: 'Liczba podstron', d: 'Największy pojedynczy czynnik. Wizytówka to jeden układ, a serwis z piętnastoma podstronami to piętnaście osobnych ekranów do zaprojektowania, zakodowania i opisania treścią.' },
  { t: 'Projekt graficzny', d: 'Gotowy szablon z podmienionymi kolorami kosztuje ułamek tego, co projekt tworzony pod markę. Różnicę widać jednak nie tylko w wyglądzie, ale też w tym, czy strona prowadzi do kontaktu.' },
  { t: 'Technologia', d: `WordPress jest tańszy we wdrożeniu i wygodny w samodzielnej edycji. Strona pisana w Astro albo Next.js to ${PRICING.techSurcharge} do wyceny — w zamian jest wyraźnie szybsza, bezpieczniejsza i tańsza w utrzymaniu, bo nie ma wtyczek do aktualizowania.` },
  { t: 'Treści i zdjęcia', d: 'Jeśli macie gotowe teksty i zdjęcia, płacicie tylko za stronę. Jeśli nie — copywriting i sesja zdjęciowa to osobne pozycje, które potrafią dołożyć od kilkuset do kilku tysięcy złotych.' },
  { t: 'Funkcje dodatkowe', d: 'Rezerwacje online, kalkulator, kalendarz dostępności, strefa klienta, wersja obcojęzyczna. Każda z nich to osobny moduł do zaprojektowania i przetestowania.' },
  { t: 'Integracje', d: 'Podpięcie systemu rezerwacji, CRM-u, programu księgowego czy hurtowni. Im więcej systemów ma ze sobą rozmawiać, tym więcej pracy poza samą stroną.' },
];

const hidden = [
  { t: 'Domena', d: 'Około 60–120 zł rocznie za końcówkę .pl. Rejestrujemy ją na Was, nie na siebie.' },
  { t: 'Hosting', d: 'Od 200 zł rocznie przy prostej stronie do 2 500 zł przy sklepie. Strony pisane w Astro można hostować taniej, czasem za darmo.' },
  { t: 'Certyfikat SSL', d: 'Zwykle w cenie hostingu. Jeśli ktoś liczy za to osobno kilkaset złotych rocznie, warto zapytać dlaczego.' },
  { t: 'Opieka techniczna', d: `Przy WordPressie to realna konieczność — aktualizacje, kopie zapasowe, monitoring. U nas ${zl(PRICING.addons.maintenanceMonthly)} miesięcznie, ale możecie prowadzić to sami.` },
  { t: 'Treści', d: `Copywriting od ${zl(PRICING.addons.copywriting)}. Najczęściej pomijana pozycja, a to teksty decydują o tym, czy strona pozycjonuje się i sprzedaje.` },
  { t: 'Pozycjonowanie', d: `Strona sama z siebie nie wskoczy na pierwszą pozycję. Konfiguracja SEO od ${zl(PRICING.addons.seoBasic)}, stała praca nad widocznością to osobny, comiesięczny koszt.` },
];

const faq = [
  { q: 'Ile kosztuje strona internetowa?', a: priceAnswer() },
  { q: 'Co jeszcze można dobrać do projektu?', a: addonsAnswer() },
  { q: 'Dlaczego jedna firma liczy 1 500 zł, a druga 15 000 zł za „stronę internetową"?', a: 'Bo pod tą samą nazwą kryją się zupełnie różne rzeczy. Za 1 500 zł dostaniecie zwykle gotowy szablon z podmienionym logo i tekstem, bez projektu, bez konfiguracji SEO i bez optymalizacji szybkości. Za 15 000 zł — indywidualny projekt, rozbudowaną strukturę, treści pisane pod wyszukiwarkę i integracje. Obie oferty mogą być uczciwe. Problem zaczyna się wtedy, gdy sprzedaje się pierwszą jako drugą.' },
  { q: 'Czy tania strona za kilkaset złotych ma sens?', a: 'Ma sens dokładnie w jednym przypadku: gdy potrzebujecie czegokolwiek w internecie na już i wiecie, że za rok i tak zrobicie to porządnie. W każdym innym wypadku wychodzi drożej, bo płacicie dwa razy — raz za stronę, która nic nie przyniosła, i drugi raz za tę właściwą. Do tego dochodzi koszt roku bez widoczności w Google.' },
  { q: 'Ile kosztuje utrzymanie strony rocznie?', a: `Przy prostej stronie: domena około 60–120 zł, hosting od 200 zł, razem zwykle poniżej 500 zł rocznie. Przy stronie na WordPressie doliczcie opiekę techniczną — u nas ${zl(PRICING.addons.maintenanceMonthly)} miesięcznie — bo nieaktualizowany WordPress to kwestia czasu, zanim ktoś go przejmie. Przy sklepie koszty rosną wraz z ruchem i liczbą integracji.` },
  { q: 'Czy wycena może wzrosnąć w trakcie projektu?', a: 'U nas nie, o ile nie zmienia się zakres. Kwotę i listę podstron ustalamy przed startem i jest wiążąca. Jeśli w trakcie dochodzi coś, czego nie było w ustaleniach — na przykład dodatkowa podstrona albo integracja — mówimy o tym od razu i wyceniamy osobno, przed wykonaniem. Żadnych faktur za „prace dodatkowe" na końcu.' },
  { q: 'Jak wygląda płatność?', a: 'Standardowo w dwóch ratach: zaliczka przy starcie i reszta po wdrożeniu, przed przekazaniem dostępów. Przy większych projektach dzielimy to na trzy części powiązane z etapami. Do każdej płatności faktura VAT.' },
  { q: 'Czy strona zwróci się finansowo?', a: 'To zależy od tego, ile zarabiacie na jednym kliencie. Jeśli średnie zlecenie zostawia Wam 900 zł marży, strona za 6 000 zł zwraca się po siedmiu klientach — jednorazowo, bo potem pracuje dalej przez lata. Przy usługach o wyższej wartości próg jest jeszcze niższy. Warto policzyć to przed rozmową o cenie, bo wtedy pytanie „ile to kosztuje" zamienia się w „ilu klientów ma przynieść".' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  name: 'Tworzenie stron internetowych — cennik',
  description: 'Ceny stron internetowych: landing page, strona firmowa, sklep i rozwiązania dedykowane. Widełki, czynniki wpływające na cenę i koszty utrzymania.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'Country', name: 'Polska' },
  url: 'https://ctrlzstudio.pl/ile-kosztuje-strona-internetowa',
  offers: tiers.map((t) => ({
    '@type': 'Offer',
    name: t.name,
    priceCurrency: 'PLN',
    description: t.who,
  })),
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Ile kosztuje strona internetowa', item: 'https://ctrlzstudio.pl/ile-kosztuje-strona-internetowa' },
  ],
};
---

<Layout
  title="Ile kosztuje strona internetowa? Cennik 2026 | CtrlZ Studio"
  description="Ile kosztuje strona internetowa w 2026 roku: widełki cenowe, co wpływa na cenę i jakie są koszty utrzymania. Policz orientacyjną wycenę kalkulatorem."
>
<SharedNav />

<main id="main-content">

<style>
  .ck-hero { padding: 150px 0 56px; position: relative; overflow: hidden; background: var(--bg-base); }
  .ck-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .ck-lead { font-size: 17px; color: rgba(255,255,255,.64); line-height: 1.75; max-width: 760px; font-weight: 300; }
  .ck-lead strong { color: rgba(255,255,255,.85); font-weight: 500; }
  .ck-section { padding: 72px 0; background: var(--bg-base); }
  .ck-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .ck-h2 { margin-bottom: 18px; }
  .ck-p { font-size: 15px; color: rgba(255,255,255,.64); line-height: 1.8; max-width: 780px; margin-bottom: 16px; }
  .ck-p strong { color: rgba(255,255,255,.82); font-weight: 500; }

  /* ── karty cenowe ── */
  .ck-tiers { display: grid; grid-template-columns: repeat(4,1fr); gap: 18px; margin-top: 40px; }
  .ck-tier {
    display: flex; flex-direction: column;
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.08);
    border-radius: 18px; padding: 28px 24px; position: relative;
  }
  .ck-tier.hl { border-color: rgba(124,107,255,.4); background: linear-gradient(160deg, rgba(124,107,255,.09), rgba(255,255,255,.02)); }
  .ck-tier-badge {
    position: absolute; top: -11px; left: 24px; font-size: 10.5px; letter-spacing: .1em;
    text-transform: uppercase; background: linear-gradient(100deg,#7c6bff,#ec4899);
    color: #fff; padding: 4px 12px; border-radius: 100px; font-weight: 600;
  }
  .ck-tier h3 { font-family: var(--font-display); font-size: 17px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .ck-tier-price { font-family: var(--font-display); font-size: 27px; font-weight: 800; color: #c4b5fd; letter-spacing: -.8px; margin-bottom: 14px; }
  .ck-tier-who { font-size: 13.5px; color: rgba(255,255,255,.66); line-height: 1.65; margin-bottom: 18px; }
  .ck-tier ul { list-style: none; padding: 0; margin: 0 0 18px; }
  .ck-tier li { font-size: 13px; color: rgba(255,255,255,.7); line-height: 1.55; padding-left: 18px; position: relative; margin-bottom: 8px; }
  .ck-tier li::before { content: '✓'; position: absolute; left: 0; color: #6ee7a8; font-size: 11px; }
  .ck-tier-time { margin-top: auto; font-size: 12px; color: rgba(255,255,255,.55); border-top: 1px solid rgba(255,255,255,.08); padding-top: 14px; }

  /* ── kalkulator ── */
  .calc-box {
    max-width: 900px; margin: 40px auto 0; background: rgba(255,255,255,.025);
    border: 1px solid rgba(255,255,255,.1); border-radius: 22px; padding: 36px;
  }
  .calc-row { margin-bottom: 26px; }
  .calc-label { font-size: 12px; letter-spacing: .07em; text-transform: uppercase; color: rgba(255,255,255,.7); margin-bottom: 12px; font-weight: 500; }
  .calc-opts { display: flex; gap: 10px; flex-wrap: wrap; }
  .calc-opt {
    font-size: 13.5px; padding: 11px 18px; border-radius: 12px; cursor: pointer;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.11);
    color: rgba(255,255,255,.74); transition: all .2s; font-family: inherit;
  }
  .calc-opt:hover { border-color: rgba(124,107,255,.4); color: #fff; }
  .calc-opt[aria-pressed="true"] {
    background: rgba(124,107,255,.16); border-color: rgba(124,107,255,.6); color: #fff; font-weight: 500;
  }
  .calc-out {
    margin-top: 30px; padding-top: 26px; border-top: 1px solid rgba(255,255,255,.1);
    display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap;
  }
  .calc-out-label { font-size: 12px; letter-spacing: .07em; text-transform: uppercase; color: rgba(255,255,255,.6); margin-bottom: 6px; }
  .calc-out-val { font-family: var(--font-display); font-size: 38px; font-weight: 800; letter-spacing: -1.4px;
    background: linear-gradient(100deg,#7c6bff,#ec4899); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .calc-note { font-size: 12.5px; color: rgba(255,255,255,.5); margin-top: 14px; line-height: 1.6; }

  .ck-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .ck-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 26px; transition: border-color .25s, transform .25s;
  }
  .ck-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .ck-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .ck-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }

  .ck-warn {
    max-width: 820px; margin-top: 32px; padding: 26px 28px; border-radius: 16px;
    background: rgba(248,113,113,.07); border: 1px solid rgba(248,113,113,.28);
  }
  .ck-warn h3 { font-family: var(--font-display); font-size: 17px; color: #fca5a5; margin: 0 0 12px; font-weight: 600; }
  .ck-warn p { font-size: 14.5px; color: rgba(255,255,255,.75); line-height: 1.75; margin: 0 0 10px; }
  .ck-warn ul { margin: 12px 0 0; padding-left: 20px; }
  .ck-warn li { font-size: 14px; color: rgba(255,255,255,.72); line-height: 1.7; margin-bottom: 7px; }

  @media (max-width: 1100px) { .ck-tiers { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 1024px) { .ck-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .ck-inner { padding: 0 24px; }
    .ck-tiers, .ck-grid { grid-template-columns: 1fr; }
    .ck-hero { padding: 120px 0 40px; }
    .calc-box { padding: 24px 18px; }
    .calc-out-val { font-size: 30px; }
  }
</style>

<section class="ck-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="ck-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Cennik 2026</div>
    <h1 class="display-xl" style="margin-bottom:20px">Ile kosztuje<br><span class="grad">strona internetowa?</span></h1>
    <p class="ck-lead">
      Krótka odpowiedź: <strong>cena strony internetowej to od {zl(PRICING.landing)} za wizytówkę do kilkunastu tysięcy
      za rozbudowany serwis albo sklep</strong>. Dłuższa jest poniżej — z widełkami dla każdego typu strony, listą tego,
      co realnie podnosi cenę, i kosztami, o których większość ofert milczy.
    </p>
  </div>
</section>

<!-- WIDEŁKI -->
<section class="ck-section">
  <div class="ck-inner">
    <h2 class="display-md ck-h2">Cennik — widełki dla <span class="grad-v">czterech typów stron</span></h2>
    <p class="ck-p">
      <strong>Cena strony internetowej</strong> zależy przede wszystkim od jej typu, dlatego zaczynamy od podziału.
      To są nasze realne ceny, nie „ceny od" wyciągnięte po to, żeby dobrze wyglądały w reklamie.
      Dokładną kwotę podajemy po rozmowie i jest wiążąca.
    </p>
    <div class="ck-tiers">
      {tiers.map((t) => (
        <div class={`ck-tier${t.highlight ? ' hl' : ''}`}>
          {t.highlight && <div class="ck-tier-badge">Najczęściej wybierane</div>}
          <h3>{t.name}</h3>
          <div class="ck-tier-price">{t.price}</div>
          <div class="ck-tier-who">{t.who}</div>
          <ul>{t.what.map((w) => <li>{w}</li>)}</ul>
          <div class="ck-tier-time">Czas realizacji: {t.time}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- KALKULATOR -->
<section class="ck-section ck-section-alt" id="kalkulator">
  <div class="ck-inner">
    <div style="text-align:center">
      <h2 class="display-md ck-h2">Policz <span class="grad">orientacyjną cenę</span></h2>
      <p class="ck-p" style="margin:0 auto">Trzy pytania i widełki w kilka sekund. Bez podawania maila.</p>
    </div>

    <div class="calc-box">
      <div class="calc-row">
        <div class="calc-label">Rodzaj strony</div>
        <div class="calc-opts" id="calc-type">
          <button type="button" class="calc-opt" data-v="landing" aria-pressed="true">Landing page / wizytówka</button>
          <button type="button" class="calc-opt" data-v="firmowa" aria-pressed="false">Strona firmowa</button>
          <button type="button" class="calc-opt" data-v="sklep" aria-pressed="false">Sklep internetowy</button>
          <button type="button" class="calc-opt" data-v="custom" aria-pressed="false">Rozwiązanie dedykowane</button>
        </div>
      </div>

      <div class="calc-row" id="calc-size-row">
        <div class="calc-label">Wielkość</div>
        <div class="calc-opts" id="calc-size">
          <button type="button" class="calc-opt" data-v="s" aria-pressed="true">Mała</button>
          <button type="button" class="calc-opt" data-v="m" aria-pressed="false">Średnia</button>
          <button type="button" class="calc-opt" data-v="l" aria-pressed="false">Duża</button>
        </div>
      </div>

      <div class="calc-row" id="calc-tech-row">
        <div class="calc-label">Technologia</div>
        <div class="calc-opts" id="calc-tech">
          <button type="button" class="calc-opt" data-v="wp" aria-pressed="true">WordPress</button>
          <button type="button" class="calc-opt" data-v="code" aria-pressed="false">Astro / Next.js (szybsza)</button>
        </div>
      </div>

      <div class="calc-out">
        <div>
          <div class="calc-out-label">Orientacyjny koszt</div>
          <div class="calc-out-val" id="calc-val">2 000 – 2 600 zł</div>
        </div>
        <a href="/kalkulator" class="btn-ghost"><span>Pełny kalkulator z dodatkami →</span></a>
      </div>

      <p class="calc-note">
        Wycena orientacyjna, oparta na naszym cenniku. Nie zastępuje rozmowy — ostateczna kwota zależy
        od zakresu treści, liczby integracji i tego, czy macie gotowe materiały.
      </p>
    </div>
  </div>
</section>

<!-- CO WPŁYWA NA CENĘ -->
<section class="ck-section">
  <div class="ck-inner">
    <h2 class="display-md ck-h2">Co realnie <span class="grad-v">podnosi cenę</span></h2>
    <p class="ck-p">
      Sześć czynników, które rozstrzygają, czy wycena zamknie się w trzech tysiącach, czy w piętnastu.
      Warto je znać przed rozmową z jakimkolwiek wykonawcą.
    </p>
    <div class="ck-grid">
      {factors.map((f) => (
        <div class="ck-card"><h3>{f.t}</h3><p>{f.d}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- KOSZTY UKRYTE -->
<section class="ck-section ck-section-alt">
  <div class="ck-inner">
    <h2 class="display-md ck-h2">Koszty, o których<br><span class="grad">nie mówi się na starcie</span></h2>
    <p class="ck-p">
      Cena wykonania to nie wszystko. Poniżej pozycje, które pojawiają się później i regularnie
      zaskakują firmy zamawiające stronę pierwszy raz.
    </p>
    <div class="ck-grid">
      {hidden.map((h) => (
        <div class="ck-card"><h3>{h.t}</h3><p>{h.d}</p></div>
      ))}
    </div>
  </div>
</section>

<!-- TANIE STRONY -->
<section class="ck-section">
  <div class="ck-inner">
    <h2 class="display-md ck-h2">A co z <span class="grad-v">stroną za 500 zł</span>?</h2>
    <p class="ck-p">
      Takie oferty istnieją i czasem mają sens — ale warto wiedzieć, co się za nimi kryje,
      zanim porówna się je z wyceną na kilka tysięcy.
    </p>

    <div class="ck-warn">
