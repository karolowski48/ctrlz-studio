---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  {
    q: 'Ile kosztuje strona internetowa dla firmy z Izdebnika?',
    a: priceAnswer('Izdebnika'),
  },
  {
    q: 'Co jeszcze można dobrać do projektu?',
    a: addonsAnswer(),
  },
  {
    q: 'Gdzie dokładnie jesteście?',
    a: 'Przy ulicy Dworskiej 40a w Izdebniku, gmina Lanckorona. Pracujemy od poniedziałku do piątku, 9:00–17:00. Można wpaść, umówić się na kawę i pogadać o projekcie na miejscu — to najprostszy sposób, żeby sprawdzić, czy chcecie z nami pracować.',
  },
  {
    q: 'Jestem jednoosobową działalnością. Nie jestem dla Was za mały?',
    a: 'Nie. Sporo naszych projektów to właśnie jednoosobowe firmy i małe zakłady z okolicy. Prosta, dobrze zrobiona strona za kilka tysięcy potrafi zmienić w takiej firmie więcej niż rozbudowany serwis w dużej — bo startujecie z poziomu, gdzie konkurencja nie ma nic.',
  },
  {
    q: 'Czy naprawdę jesteście stąd, czy to tylko taka strona pod wyszukiwarkę?',
    a: 'Jesteśmy stąd. Firma jest zarejestrowana w Izdebniku, tu pracujemy i tu nas znajdziecie pod adresem. Możecie sprawdzić w wizytówce Google. To akurat łatwo zweryfikować — i warto to robić przy każdym wykonawcy, bo wiele „lokalnych" agencji to biura z drugiego końca Polski z podmienioną nazwą miejscowości na stronie.',
  },
  {
    q: 'Ile trwa zrobienie strony?',
    a: 'Wizytówka: 2–4 tygodnie. Strona firmowa z projektem graficznym od zera: 4–8 tygodni. Sklep: 8–16 tygodni. W praktyce najwięcej czasu zabiera czekanie na treści i zdjęcia — jeśli macie je gotowe, idzie znacznie szybciej.',
  },
  {
    q: 'Na kogo będzie zarejestrowana domena?',
    a: 'Na Was. Dostępy do hostingu i panelu przekazujemy w komplecie po wdrożeniu — strona jest Waszą własnością i możecie ją w każdej chwili przenieść gdzie indziej.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Tworzenie stron internetowych',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: {
    '@type': 'City',
    name: 'Izdebnik',
    containedInPlace: { '@type': 'AdministrativeArea', name: 'gmina Lanckorona, powiat wadowicki' },
  },
  url: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-izdebnik',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Tworzenie stron internetowych — Izdebnik', item: 'https://ctrlzstudio.pl/tworzenie-stron-internetowych-izdebnik' },
  ],
};
---

<Layout
  title="Tworzenie stron internetowych Izdebnik — nasze studio | CtrlZ Studio"
  description="Studio zajmujące się tworzeniem stron internetowych z Izdebnika, ul. Dworska 40a. Strony WWW, sklepy i SEO dla firm z gminy Lanckorona, Kalwarii i całej."
>
<SharedNav />

<main id="main-content">

<style>
  .loc-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .loc-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .loc-h1 { margin-bottom: 20px; }
  .loc-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .loc-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }

  .loc-section { padding: 72px 0; background: var(--bg-base); }
  .loc-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .loc-h2 { margin-bottom: 18px; }
  .loc-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .loc-p strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .nap-card {
    display: grid; grid-template-columns: repeat(3,1fr); gap: 1px;
    background: rgba(255,255,255,.06); border: 1px solid rgba(255,255,255,.08);
    border-radius: 18px; overflow: hidden; margin-top: 36px; max-width: 900px;
  }
  .nap-item { background: var(--bg-base); padding: 26px 28px; }
  .nap-label {
    font-size: 12px; letter-spacing: .1em; text-transform: uppercase;
    color: rgba(255,255,255,.68); margin-bottom: 8px;
  }
  .nap-val { font-size: 15px; color: #fff; line-height: 1.6; }
  .nap-val a { color: #c4b5fd; text-decoration: none; }
  .nap-val a:hover { color: #fff; }

  .loc-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .loc-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .loc-card:hover { border-color: rgba(124,107,255,.26); transform: translateY(-2px); }
  .loc-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .loc-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }

  .loc-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .loc-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .loc-list li::before { content: '→'; position: absolute; left: 0; color: #7c6bff; font-size: 14px; }
  .loc-list strong { color: rgba(255,255,255,.8); font-weight: 500; }

  .loc-villages { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.9; max-width: 820px; margin-top: 18px; }

  @media (max-width: 1024px) { .loc-grid { grid-template-columns: 1fr 1fr; } .nap-card { grid-template-columns: 1fr; } }
  @media (max-width: 720px) {
    .loc-inner { padding: 0 24px; }
    .loc-grid { grid-template-columns: 1fr; }
    .loc-hero { padding: 120px 0 48px; }
  }
</style>

<!-- HERO -->
<section class="loc-hero">
  <div class="orb orb-1"></div>
  <div class="grid-bg"></div>
  <div class="loc-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Tu jesteśmy</div>
    <h1 class="display-xl loc-h1">
      Tworzenie stron<br>
      internetowych<br>
      <span class="grad">Izdebnik</span>
    </h1>
    <p class="loc-lead">
      To nie jest podstrona zrobiona pod wyszukiwarkę — <strong>tu naprawdę mamy studio.</strong>
      Ulica Dworska 40a, gmina Lanckorona. Stąd robimy strony dla firm z Kalwarii,
      Lanckorony, Sułkowic, Skawiny, Wadowic i całej okolicy.
    </p>
  </div>
</section>

<!-- NAP -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Adres i <span class="grad-v">kontakt</span></h2>
    <p class="loc-p">
      Możecie po prostu wpaść. Bez umawiania się przez formularz, bez ofert wysyłanych
      w PDF-ie przez trzy tygodnie.
    </p>
    <div class="nap-card">
      <div class="nap-item">
        <div class="nap-label">Adres</div>
        <div class="nap-val">CtrlZ Studio<br>ul. Dworska 40a<br>34-144 Izdebnik</div>
      </div>
      <div class="nap-item">
        <div class="nap-label">Godziny</div>
        <div class="nap-val">Poniedziałek – piątek<br>9:00 – 17:00</div>
      </div>
      <div class="nap-item">
        <div class="nap-label">Kontakt</div>
        <div class="nap-val">
          <a href="tel:+48575043985">575 043 985</a><br>
          <a href="mailto:kontakt@ctrlzstudio.pl">kontakt@ctrlzstudio.pl</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- DLACZEGO LOKALNIE -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Dlaczego warto pracować<br>z kimś <span class="grad">z okolicy</span></h2>
    <p class="loc-p">
      Nie dlatego, że lokalnie znaczy lepiej. Dobrych wykonawców jest pełno w Krakowie,
      Warszawie i wszędzie indziej. Chodzi o trzy rzeczy, które przy zdalnej współpracy
      po prostu nie występują.
    </p>
    <ul class="loc-list">
      <li><strong>Możecie sprawdzić, że istniejemy.</strong> Adres, wizytówka, ludzie. Przy zleceniu za kilka tysięcy złotych to nie jest drobiazg — internet jest pełen wykonawców, którzy znikają po odebraniu zaliczki.</li>
      <li><strong>Mamy co stracić.</strong> W małej okolicy jedna zawalona współpraca rozchodzi się szybciej niż jakakolwiek reklama. To jest zabezpieczenie, którego nie da Wam żadna umowa.</li>
      <li><strong>Widzimy Wasz biznes.</strong> Trudno opisać warsztat, zakład albo hale produkcyjną przez telefon. Godzina na miejscu daje więcej niż pięć rozmów.</li>
    </ul>
    <p class="loc-p" style="margin-top:24px">
      Co nie znaczy, że pracujemy tylko lokalnie — robimy projekty dla klientów
      z Krakowa, Wrocławia i z całej Polski. Ale przy firmach z okolicy
      możliwość spotkania realnie zmienia jakość tego, co powstaje.
    </p>
  </div>
</section>

<!-- CO ROBIMY -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Czym się <span class="grad-v">zajmujemy</span></h2>
    <div class="loc-grid">
      <div class="loc-card">
        <h3>Strony firmowe</h3>
        <p>Od wizytówki po serwis z katalogiem usług i blogiem. Indywidualny projekt pod Waszą markę.</p>
      </div>
      <div class="loc-card">
        <h3>Sklepy internetowe</h3>
        <p>WooCommerce albo rozwiązanie pisane od zera, z integracjami do płatności, kurierów i magazynu.</p>
      </div>
      <div class="loc-card">
        <h3>SEO i widoczność</h3>
        <p>Konfiguracja techniczna, dane strukturalne, wizytówka Google, treści pod frazy lokalne.</p>
      </div>
      <div class="loc-card">
        <h3>Projekt UX/UI</h3>
        <p>Makiety i prototyp przed kodowaniem. Widzicie, jak strona będzie wyglądać, zanim ją zbudujemy.</p>
      </div>
      <div class="loc-card">
        <h3>Przyspieszanie stron</h3>
        <p>Audyt i optymalizacja istniejącej strony. Czasem taniej naprawić niż pisać od nowa — i mówimy to wprost.</p>
      </div>
      <div class="loc-card">
        <h3>Opieka techniczna</h3>
        <p>Aktualizacje, kopie zapasowe, monitoring, drobne zmiany. Opcjonalnie — możecie obsługiwać stronę sami.</p>
      </div>
    </div>
  </div>
</section>

<!-- OBSZAR -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Kogo <span class="grad">obsługujemy</span></h2>
    <p class="loc-p">
      Izdebnik leży na styku trzech powiatów, więc mamy blisko w wiele stron:
      do Kalwarii kilka minut, do Sułkowic dziesięć, do Skawiny kilkanaście,
      do Wadowic i Myślenic około dwudziestu.
    </p>
    <p class="loc-villages">
      Izdebnik · Lanckorona · Skawinki · Podchybie · Jastrzębia · Kalwaria Zebrzydowska ·
      Brody · Barwałd · Stanisław Dolny · Sułkowice · Krzywaczka · Biertowice ·
      Skawina · Radziszów · Brzeźnica · Wadowice · Myślenice · Kraków
    </p>
    <p class="loc-p" style="margin-top:28px">
      Mamy osobne strony dla większych miejscowości w okolicy:
      <a href="/tworzenie-stron-internetowych-kalwaria-zebrzydowska" style="color:#c4b5fd">Kalwaria Zebrzydowska</a> ·
      <a href="/tworzenie-stron-internetowych-sulkowice" style="color:#c4b5fd">Sułkowice</a> ·
      <a href="/tworzenie-stron-internetowych-skawina" style="color:#c4b5fd">Skawina</a> ·
      <a href="/tworzenie-stron-internetowych-wadowice" style="color:#c4b5fd">Wadowice</a> ·
      <a href="/tworzenie-stron-internetowych-myslenice" style="color:#c4b5fd">Myślenice</a> ·
      <a href="/tworzenie-stron-internetowych-andrychow" style="color:#c4b5fd">Andrychów</a>
    </p>
  </div>
</section>

<!-- FAQ -->
<section class="loc-section">
  <div class="loc-inner">
    <h2 class="display-md loc-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="loc-section loc-section-alt">
  <div class="loc-inner" style="text-align:center">
    <h2 class="display-md loc-h2">Wpadnijcie<br>albo <span class="grad">zadzwońcie</span></h2>
    <p class="loc-p" style="margin:0 auto 32px">
      ul. Dworska 40a, Izdebnik · pon–pt 9:00–17:00 · 575 043 985.
      Pierwsza rozmowa nic nie kosztuje i do niczego nie zobowiązuje.
    </p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
