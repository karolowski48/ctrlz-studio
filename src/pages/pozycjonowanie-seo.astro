---
import Layout from '../layouts/Layout.astro';
import SharedNav from '../components/SharedNav.astro';
import SharedFooter from '../components/SharedFooter.astro';
import { priceAnswer, addonsAnswer } from '../data/pricing';

const faq = [
  { q: 'Ile kosztuje SEO?', a: 'Konfiguracja SEO przy budowie strony to +1 500 zł (podstawowe) albo +3 000 zł (zaawansowane, z danymi strukturalnymi, strategią fraz i podstronami lokalnymi). Stała współpraca SEO to osobny temat — wyceniamy po audycie, bo bez sprawdzenia stanu wyjściowego każda kwota byłaby zgadywaniem.' },
  { q: 'Gwarantujecie pierwsze miejsce w Google?', a: 'Nie i nikt uczciwy tego nie zrobi — nikt nie kontroluje algorytmu Google. Możemy zagwarantować konkretne działania: poprawną konfigurację techniczną, dane strukturalne, strukturę podstron pod frazy i treść odpowiadającą na realne zapytania. Jeśli ktoś obiecuje Wam pierwsze miejsce w dwa miesiące za 300 zł, kupujecie złudzenie.' },
  { q: 'Po jakim czasie widać efekty?', a: 'Przy frazach lokalnych zwykle 1–3 miesiące do pierwszych wzrostów i 6–12 miesięcy do stabilnej pozycji w czołówce. Przy frazach ogólnopolskich znacznie dłużej. SEO kumuluje efekty — firma, która zaczęła rok temu, jest praktycznie nie do dogonienia w kwartał.' },
  { q: 'Czym różni się SEO lokalne od zwykłego?', a: 'Zakresem walki. W SEO lokalnym liczy się wizytówka Google, opinie, spójność danych kontaktowych i osobne podstrony pod miejscowości. Konkurencja jest znacznie mniejsza, a zamiar zakupowy znacznie wyższy — ktoś wpisujący „hydraulik Myślenice" potrzebuje hydraulika teraz, nie czyta o hydraulice.' },
  { q: 'Czy musicie przerabiać moją stronę?', a: 'Nie zawsze. Zaczynamy od audytu i bardzo często okazuje się, że wystarczy poprawić tytuły stron, dodać dane strukturalne i uzupełnić wizytówkę. Przebudowa jest konieczna dopiero, gdy strona ma poważne braki techniczne albo nie działa na telefonie.' },
  { q: 'Co jeśli mam już agencję SEO?', a: 'Możemy zrobić audyt niezależny i powiedzieć, czy dostajecie to, za co płacicie. Bez zobowiązań i bez namawiania na zmianę — czasem wychodzi, że obecna współpraca jest w porządku, tylko brakuje raportowania.' },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Pozycjonowanie i optymalizacja SEO',
  name: 'Pozycjonowanie SEO i SEO lokalne',
  description: 'Optymalizacja techniczna, dane strukturalne, strategia tresci i SEO lokalne dla firm z Malopolski.',
  provider: { '@id': 'https://ctrlzstudio.pl/#localbusiness' },
  areaServed: { '@type': 'AdministrativeArea', name: 'województwo małopolskie' },
  url: 'https://ctrlzstudio.pl/pozycjonowanie-seo',
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Strona główna', item: 'https://ctrlzstudio.pl' },
    { '@type': 'ListItem', position: 2, name: 'Pozycjonowanie SEO', item: 'https://ctrlzstudio.pl/pozycjonowanie-seo' },
  ],
};
---

<Layout
  title="Pozycjonowanie SEO — optymalizacja i SEO lokalne | CtrlZ Studio"
  description="Pozycjonowanie stron i SEO lokalne dla firm z Małopolski. Audyt techniczny, dane strukturalne, wizytówka Google, strategia treści."
>
<SharedNav />

<main id="main-content">

<style>
  .srv-hero { padding: 150px 0 64px; position: relative; overflow: hidden; background: var(--bg-base); }
  .srv-inner { max-width: 1280px; margin: 0 auto; padding: 0 48px; }
  .srv-lead { font-size: 17px; color: rgba(255,255,255,.62); line-height: 1.75; max-width: 720px; font-weight: 300; }
  .srv-lead strong { color: rgba(255,255,255,.82); font-weight: 500; }
  .srv-chips { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 32px; }
  .srv-chip {
    font-size: 12px; padding: 7px 16px; border-radius: 100px;
    background: rgba(167,139,250,.1); border: 1px solid rgba(167,139,250,.26); color: #c4b5fd;
  }
  .srv-section { padding: 72px 0; background: var(--bg-base); }
  .srv-section-alt { background: var(--bg-elevated, rgba(255,255,255,.02)); }
  .srv-h2 { margin-bottom: 18px; }
  .srv-p { font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.8; max-width: 760px; margin-bottom: 16px; }
  .srv-p strong { color: rgba(255,255,255,.8); font-weight: 500; }
  .srv-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 20px; margin-top: 36px; }
  .srv-card {
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.07);
    border-radius: 16px; padding: 28px; transition: border-color .25s, transform .25s;
  }
  .srv-card:hover { border-color: rgba(167,139,250,.26); transform: translateY(-2px); }
  .srv-card h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 10px; font-weight: 600; }
  .srv-card p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-steps { max-width: 780px; margin-top: 32px; }
  .srv-step {
    display: flex; gap: 22px; align-items: flex-start;
    padding: 22px 0; border-top: 1px solid rgba(255,255,255,.07);
  }
  .srv-step-n {
    font-family: var(--font-display); font-size: 26px; font-weight: 800;
    color: #c4b5fd; line-height: 1; width: 40px; flex-shrink: 0; opacity: .85;
  }
  .srv-step h3 { font-family: var(--font-display); font-size: 16px; color: #fff; margin: 0 0 6px; font-weight: 600; }
  .srv-step p { font-size: 14px; color: rgba(255,255,255,.68); line-height: 1.7; margin: 0; }
  .srv-list { max-width: 760px; margin: 24px 0 0; padding: 0; list-style: none; }
  .srv-list li {
    font-size: 15px; color: rgba(255,255,255,.62); line-height: 1.75;
    padding: 0 0 0 26px; margin-bottom: 12px; position: relative;
  }
  .srv-list li::before { content: '→'; position: absolute; left: 0; color: #c4b5fd; font-size: 14px; }
  .srv-list strong { color: rgba(255,255,255,.8); font-weight: 500; }
  @media (max-width: 1024px) { .srv-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 720px) {
    .srv-inner { padding: 0 24px; }
    .srv-grid { grid-template-columns: 1fr; }
    .srv-hero { padding: 120px 0 48px; }
  }
</style>

<section class="srv-hero">
  <div class="orb orb-3"></div>
  <div class="grid-bg"></div>
  <div class="srv-inner" style="position:relative">
    <div class="eyebrow" style="margin-bottom:18px">Usługa</div>
    <h1 class="display-xl" style="margin-bottom:20px">Pozycjonowanie<br><span class="grad">SEO</span></h1>
    <p class="srv-lead">Bez obietnic pierwszego miejsca w dwa tygodnie. <strong>Solidna robota techniczna, treść odpowiadająca na realne zapytania i widoczność w wyszukiwaniach lokalnych</strong> — czyli tam, gdzie konkurencja jest najmniejsza, a zamiar zakupowy najwyższy.</p>
    <div class="srv-chips"><span class="srv-chip">Audyt techniczny</span>
      <span class="srv-chip">SEO lokalne</span>
      <span class="srv-chip">Dane strukturalne</span>
      <span class="srv-chip">Strategia treści</span></div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najtańsze SEO to <span class="grad-v">to,<br>którego nikt nie robi</span></h2>
    <p class="srv-p">
      W Krakowie o frazę „hydraulik" walczy kilkaset firm z budżetami reklamowymi.
      W Sułkowicach, Zatorze czy Kalwarii bywa, że nie walczy nikt.
      <strong>Ta asymetria jest dziś po Waszej stronie i nie potrwa wiecznie.</strong>
    </p>
    <p class="srv-p">
      Frazy lokalne mają jeszcze jedną zaletę: ogromny zamiar zakupowy. Ktoś, kto wpisuje
      „elektryk Kalwaria Zebrzydowska", nie czyta sobie o elektryce — on potrzebuje elektryka.
      Jedno takie wejście jest warte więcej niż sto wejść z frazy ogólnej.
    </p>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Co <span class="grad">robimy</span></h2>
    <div class="srv-grid">
      <div class="srv-card"><h3>Audyt techniczny</h3><p>Szybkość, indeksowanie, adresy kanoniczne, mapa witryny, błędy 404, duplikaty. Punkt wyjścia dla wszystkiego innego.</p></div>
      <div class="srv-card"><h3>Dane strukturalne</h3><p>LocalBusiness, FAQ, produkty, artykuły, okruszki. To one dają rozszerzone wyniki w Google i mówią wprost, czym jest Wasza firma.</p></div>
      <div class="srv-card"><h3>Strony lokalne</h3><p>Osobne podstrony pod miejscowości i usługi, każda z własną treścią. Jedna strona nie wygra naraz o dwa miasta.</p></div>
      <div class="srv-card"><h3>Wizytówka Google</h3><p>Kategorie, obszar działania, zdjęcia, wpisy, strategia zbierania opinii. Dla lokalnej firmy często ważniejsza niż sama strona.</p></div>
      <div class="srv-card"><h3>Strategia treści</h3><p>Tematy wynikające z pytań, które zadają Wasi klienci. Jeden porządny artykuł jest wart więcej niż dziesięć stron naszpikowanych frazami.</p></div>
      <div class="srv-card"><h3>Pomiar i raportowanie</h3><p>Search Console, Analytics, statystyki wizytówki. Dowiecie się, co zadziałało, a nie tylko że „pracujemy nad SEO".</p></div>
    </div>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Czego <span class="grad-v">nie robimy</span></h2>
    <ul class="srv-list">
      <li><strong>Nie kupujemy linków</strong> z farm i katalogów spamowych. Dziś to szkodzi, a nie pomaga.</li>
      <li><strong>Nie upychamy słów kluczowych.</strong> Google rozumie zamiar stojący za zapytaniem — wygrywa strona, która faktycznie odpowiada, nie ta, która najczęściej powtórzyła frazę.</li>
      <li><strong>Nie generujemy masowo treści.</strong> Setki podstron z podmienioną nazwą miasta to duplikat, który obniża całą witrynę.</li>
      <li><strong>Nie obiecujemy terminów, których nie kontrolujemy.</strong> Możemy zagwarantować działania i raportowanie, nie pozycję w cudzym algorytmie.</li>
    </ul>
    <p class="srv-p" style="margin-top:28px">
      Więcej o tym, co dziś działa, a co jest stratą pieniędzy, w tekstach
      <a href="/blog/seo-2025" style="color:#c4b5fd">SEO — co naprawdę działa</a> i
      <a href="/blog/strona-nie-przynosi-klientow-7-powodow" style="color:#c4b5fd">7 powodów, dla których strona nie przynosi klientów</a>.
    </p>
  </div>
</section>

<section class="srv-section">
  <div class="srv-inner">
    <h2 class="display-md srv-h2">Najczęstsze <span class="grad-v">pytania</span></h2>
    <div class="faq-list" style="margin-top:32px">
      {faq.map((f, i) => (
        <>
          <div class="faq-divider"></div>
          <div class={`faq-item${i === 0 ? ' open' : ''}`}>
            <div class="faq-question"><div class="faq-q-text">{f.q}</div><div class="faq-icon">+</div></div>
            <div class="faq-body"><div class="faq-answer-wrap"><div class="faq-answer">{f.a}</div></div></div>
          </div>
        </>
      ))}
      <div class="faq-divider"></div>
    </div>
  </div>
</section>

<section class="srv-section srv-section-alt">
  <div class="srv-inner" style="text-align:center">
    <h2 class="display-md srv-h2">Sprawdźmy, gdzie<br><span class="grad">tracicie klientów</span></h2>
    <p class="srv-p" style="margin:0 auto 32px">Zaczniemy od audytu — widoczność w Google, kondycja techniczna, wizytówka. Dostaniecie listę konkretnych rzeczy do poprawy, także tych do zrobienia samodzielnie.</p>
    <div style="display:flex;gap:14px;justify-content:center;flex-wrap:wrap">
      <a href="/#kontakt" class="btn-primary"><span>Napisz do nas</span></a>
      <a href="/kalkulator" class="btn-ghost"><span>Policz orientacyjną cenę</span></a>
    </div>
    <p class="srv-p" style="margin:28px auto 0;font-size:14px">Zobacz też: <a href="/pozycjonowanie-stron-wadowice" style="color:#c4b5fd">pozycjonowanie Wadowice</a> · <a href="/audyt-seo" style="color:#c4b5fd">audyt SEO</a> · <a href="/blog/ile-kosztuje-pozycjonowanie-stron" style="color:#c4b5fd">ile kosztuje pozycjonowanie</a> · <a href="/audyt-strony" style="color:#c4b5fd">audyt strony</a> · <a href="/strony-internetowe" style="color:#c4b5fd">strony internetowe</a> · <a href="/blog/lokalne-seo-dla-firm-z-malopolski" style="color:#c4b5fd">lokalne SEO krok po kroku</a></p>
  </div>
</section>

</main>

<SharedFooter />

<script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

<script>
  import { initPage } from '../utils/pageInit';
  initPage();

  document.querySelectorAll('.faq-item').forEach(item => {
    item.querySelector('.faq-question')?.addEventListener('click', () => {
      const open = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!open) item.classList.add('open');
    });
  });
</script>

</Layout>
