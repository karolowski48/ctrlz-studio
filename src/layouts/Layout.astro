---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * Strony bez wartości dla wyszukiwarki (polityka prywatności, podziękowanie, 404).
   * Wyłącza je z indeksu — razem z kotwicami typu #s2, które Google indeksował
   * jako osobne adresy i które zbierały wyświetlenia zamiast realizacji.
   */
  noindex?: boolean;
}

const {
  title = 'CtrlZ Studio — Agencja Kreatywna & Digital',
  description = 'Projektujemy i wdrażamy cyfrowe doświadczenia dla firm, którym zależy na jakości ponad przeciętność. Strony, sklepy, identyfikacja wizualna.',
  noindex = false,
} = Astro.props;

// Vercel serwuje adresy bez końcowego slasha (trailingSlash: false w vercel.json),
// więc canonical musi wskazywać dokładnie na ten adres — inaczej kieruje na przekierowanie 308.
const cleanPath = Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = `https://ctrlzstudio.pl${cleanPath || '/'}`;

// Jeden adres arkusza fontów — używany w preload, stylesheet i noscript.
// Syne: 500-800 (grubości realnie używane w global.css; 300 i 900 nie istnieją
// w tym kroju i tak, więc przeglądarka i tak podstawiała najbliższą).
// DM Sans: 300/400/500 + italic 300.
const FONT_CSS =
  'https://fonts.googleapis.com/css2' +
  '?family=Syne:wght@500;600;700;800' +
  '&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300' +
  '&display=swap';
---

<!doctype html>
<html lang="pl">
<head>
  <!-- CookieYes MUSI być pierwszym skryptem i MUSI być synchroniczny.
       Auto-blokowanie działa tak, że skrypt przechwytuje pozostałe znaczniki <script>
       ZANIM się wykonają. Dodanie defer/async psuje tę kolejność i grozi tym,
       że skrypty śledzące odpalą się przed zgodą użytkownika (RODO + Prawo
       komunikacji elektronicznej). Kosztuje ~150 ms i tak ma zostać. -->
  <link rel="preconnect" href="https://cdn-cookieyes.com" crossorigin />
  <link rel="dns-prefetch" href="https://cdn-cookieyes.com" />
  <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/11d2bbed245d91117cb418202a033abc/script.js"></script>
  <!-- Google Analytics — ładowany po pierwszym renderze, ale ZAWSZE po CookieYes,
       który steruje zgodą. Consent Mode ustawiony domyślnie na odmowę:
       do czasu zgody GA nie zapisuje cookies ani identyfikatorów.
       CookieYes podnosi te zgody automatycznie po kliknięciu „Akceptuję". -->
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
      wait_for_update: 2000
    });
    gtag('js', new Date());
    gtag('config', 'G-5LYYREZRZC');
    (function () {
      var load = function () {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=G-5LYYREZRZC';
        document.head.appendChild(s);
      };
      if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 3000 });
      else window.addEventListener('load', load);
    })();
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://ctrlzstudio.pl" />
  <meta property="og:image" content="https://ctrlzstudio.pl/og-ctrlzstudio.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="CtrlZ Studio — agencja kreatywna i web development z Polski" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="CtrlZ Studio" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://ctrlzstudio.pl/og-ctrlzstudio.jpg" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Preconnect do Google Fonts (eliminuje DNS lookup z critical path) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Fonty: ograniczone do realnie używanych wariantów (było 5 grubości Syne
       i 6 wariantów DM Sans — każdy to osobny plik do pobrania).
       Arkusz ładowany bez blokowania renderu, z preloadem żeby ruszył od razu. -->
  <link rel="preload" as="style" href={FONT_CSS} />
  <link rel="stylesheet" href={FONT_CSS} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={FONT_CSS} /></noscript>

  <title>{title}</title>
  <style>
    /* Fallback font stack — widoczny zanim załaduje się Google Font */
    :root {
      --font-display: 'Syne', 'Arial Black', system-ui, sans-serif;
      --font-body:    'DM Sans', system-ui, -apple-system, sans-serif;
    }
    .skip-link {
      position: absolute;
      top: -100%;
      left: 16px;
      z-index: 9999;
      background: #7c6bff;
      color: #fff;
      padding: 10px 20px;
      border-radius: 0 0 8px 8px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: top .2s;
    }
    .skip-link:focus { top: 0; }
  </style>

