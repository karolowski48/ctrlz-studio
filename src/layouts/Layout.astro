---
import CookieConsent from '../components/CookieConsent.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /**
   * Strony bez wartości dla wyszukiwarki (polityka prywatności, podziękowanie, 404).
   * Wyłącza je z indeksu — razem z kotwicami typu #s2, które Google indeksował
   * jako osobne adresy i które zbierały wyświetlenia zamiast realizacji.
   */
  noindex?: boolean;
}

const {
  title = 'CtrlZ Studio — Agencja Kreatywna & Digital',
  description = 'Projektujemy i wdrażamy cyfrowe doświadczenia dla firm, którym zależy na jakości ponad przeciętność. Strony, sklepy, identyfikacja wizualna.',
  noindex = false,
} = Astro.props;

// Vercel serwuje adresy bez końcowego slasha (trailingSlash: false w vercel.json),
// więc canonical musi wskazywać dokładnie na ten adres — inaczej kieruje na przekierowanie 308.
const cleanPath = Astro.url.pathname.replace(/\/+$/, '');
const canonicalUrl = `https://ctrlzstudio.pl${cleanPath || '/'}`;

// Jeden adres arkusza fontów — używany w preload, stylesheet i noscript.
// Syne: 500-800 (grubości realnie używane w global.css; 300 i 900 nie istnieją
// w tym kroju i tak, więc przeglądarka i tak podstawiała najbliższą).
// DM Sans: 300/400/500 + italic 300.
const FONT_CSS =
  'https://fonts.googleapis.com/css2' +
  '?family=Syne:wght@500;600;700;800' +
  '&family=DM+Sans:ital,wght@0,300;0,400;0,500;1,300' +
  '&display=swap';
---

<!doctype html>
<html lang="pl">
<head>
  <!-- Zgody cookies: własny baner (src/components/CookieConsent.astro) zamiast CookieYes — 24.09.2026.
       Consent Mode v2 w trybie podstawowym: domyślnie wszystko „denied”, a skrypt Google Analytics
       wczytujemy DOPIERO po zgodzie (analityka albo marketing). Bez zgody do Google nic nie wychodzi —
       także pingi bez ciasteczek (wytyczne EROD 2/2023 do art. 5 ust. 3 dyrektywy ePrivacy, w Polsce art. 399 PKE).
       Wybór leży w ciasteczku `ctrlz_zgoda` (12 mies.) i jest stosowany tu, zanim cokolwiek się wczyta. -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted'
    });
    gtag('set', 'ads_data_redaction', true);

    (function () {
      var GA_ID = 'G-5LYYREZRZC';
      var VERSION = 'v1';
      var loaded = false;
      function read() {
        var m = document.cookie.match(/(?:^|;\s*)ctrlz_zgoda=([^;]+)/);
        if (!m) return null;
        try {
          var v = JSON.parse(decodeURIComponent(m[1]));
          return v && v.v === VERSION && typeof v.id === 'string' ? v : null;
        } catch (e) { return null; }
      }
      function load() {
        if (loaded) return;
        loaded = true;
        gtag('js', new Date());
        gtag('config', GA_ID);
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
      }
      window.czConsent = {
        VERSION: VERSION,
        read: read,
        apply: function (c) {
          gtag('consent', 'update', {
            analytics_storage: c.a ? 'granted' : 'denied',
            ad_storage: c.m ? 'granted' : 'denied',
            ad_user_data: c.m ? 'granted' : 'denied',
            ad_personalization: c.m ? 'granted' : 'denied'
          });
          if (c.a || c.m) {
            if ('requestIdleCallback' in window) requestIdleCallback(load, { timeout: 3000 });
            else window.addEventListener('load', load);
          }
        }
      };
      var saved = read();
      if (saved) window.czConsent.apply(saved);
    })();

    /* ── ZDARZENIA KONWERSJI ──────────────────────────────────────────
       Jeden globalny helper + jeden delegowany listener na cały serwis.
       Celowo NIE wpinamy zdarzeń osobno na 94 podstronach — nowa podstrona
       ma być automatycznie objęta pomiarem, bez pamiętania o niczym.

       Zdarzenia jadą przez gtag, więc podlegają Consent Mode: bez zgody skrypt GA
       się nie wczytuje i zdarzenia zostają w kolejce dataLayer, nigdzie nie wychodzą.

       W panelu GA4 oznacz jako kluczowe (key events):
         generate_lead · phone_click · affiliate_code_copy
    ------------------------------------------------------------------ */
    window.czTrack = function (name, params) {
      try {
        gtag('event', name, Object.assign({ page_path: location.pathname }, params || {}));
      } catch (e) { /* brak GA nie może wywrócić strony */ }
    };

    document.addEventListener('click', function (e) {
      var t = e.target;
      var a = t && t.closest ? t.closest('a') : null;
      if (!a) return;
      var href = a.getAttribute('href') || '';
      if (href.indexOf('tel:') === 0) {
        window.czTrack('phone_click', { link_url: href });
      } else if (href.indexOf('mailto:') === 0) {
        window.czTrack('email_click', { link_url: href });
      } else if (href.indexOf('lh.pl') !== -1) {
        window.czTrack('affiliate_click', { link_url: href, affiliate: 'LH.pl' });
      }
    }, true);
  </script>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://ctrlzstudio.pl" />
  <meta property="og:image" content="https://ctrlzstudio.pl/og-ctrlzstudio.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="CtrlZ Studio — agencja kreatywna i web development z Polski" />
  <meta property="og:locale" content="pl_PL" />
  <meta property="og:site_name" content="CtrlZ Studio" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content="https://ctrlzstudio.pl/og-ctrlzstudio.jpg" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalUrl} />

  <!-- Preconnect do Google Fonts (eliminuje DNS lookup z critical path) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Fonty: ograniczone do realnie używanych wariantów (było 5 grubości Syne
       i 6 wariantów DM Sans — każdy to osobny plik do pobrania).
       Arkusz ładowany bez blokowania renderu, z preloadem żeby ruszył od razu. -->
  <link rel="preload" as="style" href={FONT_CSS} />
  <link rel="stylesheet" href={FONT_CSS} media="print" onload="this.media='all'" />
  <noscript><link rel="stylesheet" href={FONT_CSS} /></noscript>

  <title>{title}</title>
  <style>
    /* Fallback font stack — widoczny zanim załaduje się Google Font */
    :root {
      --font-display: 'Syne', 'Arial Black', system-ui, sans-serif;
      --font-body:    'DM Sans', system-ui, -apple-system, sans-serif;
    }
    .skip-link {
      position: absolute;
      top: -100%;
      left: 16px;
      z-index: 9999;
      background: #7c6bff;
      color: #fff;
      padding: 10px 20px;
      border-radius: 0 0 8px 8px;
      font-size: 14px;
      font-weight: 600;
      text-decoration: none;
      transition: top .2s;
    }
    .skip-link:focus { top: 0; }
  </style>

